# SPDX-License-Identifier: MIT
# Omandroid kernel config fragment, merged on top of arm64 defconfig.

# Google Tensor SoCs live under ARCH_EXYNOS

# Early display: the framebuffer the bootloader leaves running
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_SIMPLE=y

# USB gadget, for networking (ssh) and a serial console over the USB-C port
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y

# GPU (Mali-G710)
CONFIG_DRM_PANTHOR=m

# Waydroid: C binder (not Rust binder), binderfs, PSI, memfd
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_PSI=y
CONFIG_MEMFD_CREATE=y

# Initramfs and containers
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# M1 essentials built in, so the initramfs needs no modules
CONFIG_ARCH_EXYNOS=y
CONFIG_EXYNOS_PMU=y
CONFIG_PHY_EXYNOS5_USBDRD=y

CONFIG_USB_LIBCOMPOSITE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BOOT_CONFIG=y

# Kernel log survives a warm reboot (read it from stock Android's /sys/fs/pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Built in rather than modules: their tristate dependencies are =m in defconfig
CONFIG_DRM=y
CONFIG_TYPEC=y
CONFIG_USB=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_DRM_SIMPLEDRM=y

# The bootloader leaves both watchdogs running; the driver stops them at probe
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y

# UFS storage (read-only bring-up). defconfig already has these =y; pinned so
# the initramfs needs no modules. Inline crypto stays on: the host driver then
# sets the FMP descriptor type through EL3 exactly as stock does.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_PHY_SAMSUNG_UFS=y
CONFIG_MFD_SYSCON=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_EFI_PARTITION=y

# Register access from userspace during bring-up
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# Readable console on a 1440x3120 panel
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# The OS name in uname -r: 7.3.0-rc6-omandroid
CONFIG_LOCALVERSION="-omandroid-push1"

# Landlock: pacman 7 sandboxes downloads with it, and Arch/Omarchy expect it
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# Touchscreen: Synaptics S3908 (TouchComm) on PERIC1 USI0 SPI. Built in, as
# the Arch root has no modules for this kernel.
CONFIG_PINCTRL_EXYNOS=y
CONFIG_EXYNOS_USI=y
CONFIG_SPI_S3C64XX=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=y

# Wi-Fi (BCM4389 on PCIe), Bluetooth (BCM4389 on the APM UART) and the
# MAX77759 charger/TCPC/fuel gauge. All modules, none needed to boot; the
# MAX77759 ones are blacklisted from autoload during bring-up
# (omandroid-device-cheetah: modprobe.d/omandroid-max77759.conf).
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
# brcmfmac debug messages (module parameter debug=0x80004 for PCIe + info),
# for the W2 bring-up. Quiet unless the parameter is set.
CONFIG_BRCMDBG=y
# gs201 PCIe controller + PHY for the Wi-Fi link. pcie_1 is disabled in the
# DT until the bring-up gates; pcie_gs201 is blacklisted from autoload
# (omandroid-device-cheetah: modprobe.d/omandroid-wifi.conf). The DMA pool is
# for gate W4 (DMA bounce region the HSI2 S2MPU will confine the chip to).
CONFIG_PCIE_GS201=m
# W4: the HSI2 PCIe System MMU as the Wi-Fi DMA window (only binds to an
# enabled DT node; mode=0 by default only logs)
CONFIG_PCIE_GS201_SYSMMU=m
CONFIG_PHY_GS201_PCIE=m
CONFIG_PCI_PWRCTRL_GENERIC=y
CONFIG_DMA_RESTRICTED_POOL=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_MFD_MAX77759=m
CONFIG_CHARGER_MAX77759=m
CONFIG_BATTERY_MAX17042=m

# Display bring-up (device/cheetah/DISPLAY-PLAN.md): a DSI command path on
# the bootloader's DSIM0 and the S6E3HC4 panel, for brightness and display
# on/off. Modules, autoloaded from the DT (dsi0 enabled since gate D1b);
# gs-dsim-cmd only sends with allow_tx=1, which omandroid-device-cheetah sets
# (modprobe.d/omandroid-display.conf) since gate D2 passed.
CONFIG_DRM_GS_DSIM_CMD=m
CONFIG_DRM_PANEL_SAMSUNG_S6E3HC4=m
# Flip-only KMS on the bootloader's DECON0, 60 and 120 Hz (DISPLAY-PLAN.md,
# D5d/D6). Autoloaded from the DT (decon0 enabled); it replaces simpledrm once
# gs-dsim-cmd, the panel and clk_acpm have probed.
CONFIG_DRM_GS_DECON=m

# Fingerprint bring-up (device/cheetah/FINGERPRINT-RESEARCH.md): Google's
# Trusty driver (/dev/trusty-ipc-dev0), the Goodix sensor control device
# (/dev/goodix_fp) and SCSI generic, which reaches the UFS RPMB well-known
# LUN for Trusty's secure storage. Modules; the trusty, PERIC0 pinctrl and
# goodixfp DT nodes stay disabled until the bring-up gates.
CONFIG_TRUSTY=m
CONFIG_TRUSTY_IRQ=y
CONFIG_TRUSTY_LOG=m
CONFIG_TRUSTY_VIRTIO=m
CONFIG_TRUSTY_VIRTIO_IPC=m
CONFIG_GOODIX_FP=m
CONFIG_CHR_DEV_SG=m

# Netfilter with nftables: Arch's iptables (and so ufw, Omarchy's firewall),
# Docker and Waydroid's NAT all run on nf_tables. arm64 defconfig has only the
# legacy xtables core. Modules.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_NAT=m
CONFIG_IP6_NF_IPTABLES=m
# ufw's rules through iptables-nft: REJECT, -m state and -m owner. The
# legacy filter tables (IP_NF_FILTER) need NETFILTER_XTABLES_LEGACY; not used.
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
# before6.rules drops type 0 routing headers.
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_HL=m

# Haptics (CS40L26A) and rear torch (LM3644TT), device/cheetah/HAPTICS-TORCH-PLAN.md.
# Modules; their DT nodes (and I2C buses 8 and 15) stay disabled until the
# bring-up overlays enable them.
CONFIG_INPUT_CS40L26_VIBRA=m
CONFIG_LEDS_LM3644=m

# GSA mailbox (AoC bring-up, device/cheetah/AOC-PLAN.md stage C1). Debugfs
# status queries only; its DT node stays disabled until the aoc-gsa-test overlay.
CONFIG_GOOGLE_GSA=m
# AoC bring-up (AOC-PLAN.md stages C2-C4): GSA AoC commands over Trusty as a
# fallback, the AoC System MMU windows, the debugfs boot driver and the
# mic/sensor rails over ACPM. All DT nodes stay disabled until the overlays.
CONFIG_GOOGLE_GSA_TRUSTY=y
CONFIG_GS201_AOC_SYSMMU=m
CONFIG_GS201_AOC_BOOT=m
CONFIG_GS201_AOC_RAILS=m
CONFIG_GS201_AOC_MBOX=m
CONFIG_GS201_AOC=m
CONFIG_GS201_AOC_CHAR=m
# AoC sound card and the CS35L41 speaker amplifiers (AOC-PLAN.md stage C7).
# The DT nodes stay disabled until the audio-amps-test and aoc-sound-test
# overlays; the speaker volume limits are in the card driver.
CONFIG_GS201_AOC_ALSA=m
CONFIG_SND_SOC_CS35L41_SPI=m

# Suspend diagnostics (device/cheetah/SUSPEND-PLAN.md): /sys/power/pm_test,
# pm_print_times and pm_debug_messages. Nothing changes unless written.
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# GNSS: Broadcom BCM4775x on SPI5 for the stock lhd/gpsd (device/cheetah/
# GNSS-PLAN.md). Its DT nodes and the S2MPG13 sub-PMIC stay disabled until
# the gnss overlays; the module is blacklisted from autoload.
CONFIG_BCM4775X_GNSS=m
# NFC: the ST54J's NCI controller on I2C 8 (RADIOS-CAMERA-PLAN.md section 3).
# DT node disabled until the nfc-test overlay.
CONFIG_NFC_ST_NCI_I2C=m
# Modem PCIe GEN4A_0 bring-up (device/cheetah/MODEM-PLAN.md, M2). Its DT node
# stays disabled until the modem-link-test overlay; the steps need allow_hw=1.
CONFIG_PCIE_GS201_CP=m
# The modem's NV partitions (efs, efs_backup, modem_userdata) are f2fs. The M3
# vendor-chroot profile mounts RAM copies of them, never the partitions.
CONFIG_F2FS_FS=m
# Google's modem interface driver, ported (MODEM-PLAN.md, M3.3): boot, IPC and
# RFS over the PCIe link, legacy buffers only. Its DT nodes exist only in the
# modem-cpif-test overlay; the modules are blacklisted (omandroid-cpif.conf).
CONFIG_EXYNOS_MODEM_IF=m
CONFIG_SEC_MODEM_S5100=y
CONFIG_SHM_IPC=m
# Camera (device/cheetah/CAMERA-PLAN.md). DMA-BUF heaps, /dev/dma_heap/system
# and the default CMA area, for libcamera's software ISP and PipeWire. Built
# in: a heap has no device to autoload a module from.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
# V4L2 with the media controller and the subdev API (arm64 defconfig has
# them; listed so the camera stack keeps them) and the MIPI CCS sensor driver,
# to try on the ultrawide (CAMERA-PLAN.md 5.3). Modules.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_CCS=m
# Camera power bring-up (CAMERA-PLAN.md CAM1-CAM3): the read-only CSIS probe,
# the S2MPG13 GPIOs, the SLG51002 camera PMIC and the module power test
# driver. Blacklisted from autoload (modprobe.d/omandroid-camera.conf); their
# DT nodes stay disabled until the camera-pwr-test overlay.
CONFIG_GS201_CAM_PROBE=m
CONFIG_GS201_CAM_POWER=m
CONFIG_GPIO_S2MPG13=m
CONFIG_REGULATOR_SLG51002=m
# Camera capture (CAMERA-PLAN.md CAM3b-CAM4): the DC-PHY receiver, the CSIS
# link + WDMA driver (streams only with allow_stream=1) and the ultrawide
# sensor. Blacklisted; DT nodes disabled until a camera-stream-link0/1 overlay.
CONFIG_PHY_GS201_MIPI_DCPHY=m
CONFIG_VIDEO_GS201_CSIS=m
CONFIG_VIDEO_IMX386=m
