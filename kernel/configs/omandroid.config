# Omandroid kernel config fragment, merged on top of arm64 defconfig.

# Google Tensor SoCs live under ARCH_EXYNOS

# Early display: the framebuffer the bootloader leaves running
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_SIMPLE=y

# USB gadget, for networking (ssh) and a serial console over the USB-C port
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y

# GPU (Mali-G710)
CONFIG_DRM_PANTHOR=m

# Waydroid: C binder (not Rust binder), binderfs, PSI, memfd
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_PSI=y
CONFIG_MEMFD_CREATE=y

# Initramfs and containers
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# M1 essentials built in, so the initramfs needs no modules
CONFIG_ARCH_EXYNOS=y
CONFIG_EXYNOS_PMU=y
CONFIG_PHY_EXYNOS5_USBDRD=y

CONFIG_USB_LIBCOMPOSITE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BOOT_CONFIG=y

# Kernel log survives a warm reboot (read it from stock Android's /sys/fs/pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Built in rather than modules: their tristate dependencies are =m in defconfig
CONFIG_DRM=y
CONFIG_TYPEC=y
CONFIG_USB=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_DRM_SIMPLEDRM=y

# The bootloader leaves both watchdogs running; the driver stops them at probe
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y

# UFS storage (read-only bring-up). defconfig already has these =y; pinned so
# the initramfs needs no modules. Inline crypto stays on: the host driver then
# sets the FMP descriptor type through EL3 exactly as stock does.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_PHY_SAMSUNG_UFS=y
CONFIG_MFD_SYSCON=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_EFI_PARTITION=y

# Register access from userspace during bring-up
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# Readable console on a 1440x3120 panel
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# The OS name in uname -r: 7.3.0-rc6-omandroid
CONFIG_LOCALVERSION="-omandroid-push1"
