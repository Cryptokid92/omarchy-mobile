#!/bin/bash
# SPDX-License-Identifier: MIT
#
# aoc-audio-diag: AOC-PLAN.md stages C7d-3 and C7d-4, run ON THE PHONE as root:
#   tools/phone-ssh 'EP=6 MODES="copy" bash -s' < tools/aoc-audio-diag > logs/c7d4.txt 2>&1
# Plays /tmp/tone.wav (C7d) for at most 5 s per mode on the top amplifier
# through AoC endpoint EP (default 6), in each of MODES ("copy", "mmap";
# default "mmap copy", the C7d-3 order), and snapshots before, during and
# after: the AoC mailbox interrupt counts, the endpoint's ring counters
# (service audio_playback<EP-1>), CS35L41 registers (read through regmap
# debugfs; nothing is written) and the DAPM state. The mixer is left as the
# speaker test found it: the EP route off, top amplifier analog 0. No devmem.
set -u
EP=${EP:-6}
MODES=${MODES:-mmap copy}
svc=audio_playback$((EP - 1))
C=$(awk '/aoc-snd-card/{print $1; exit}' /proc/asound/cards)
[[ -n $C ]] || { echo "no aoc-snd-card"; exit 1; }
P=$(grep -l "^id: EP$EP playback" /proc/asound/card$C/pcm*/info | sed -n 's#.*/pcm\([0-9]*\)p/info#\1#p' | head -1)
[[ -n $P ]] || { echo "no EP$EP playback PCM"; exit 1; }
[[ -e /tmp/tone.wav ]] || { echo "no /tmp/tone.wav (make it as in C7d)"; exit 1; }
echo "card $C, EP$EP playback = pcm $P ($svc), modes: $MODES"

amps=$(ls -d /sys/kernel/debug/regmap/spi*.* 2>/dev/null)

snap() {
  echo "== $1 $(date +%T.%N)"
  grep -iE 'mbox|mailbox' /proc/interrupts
  if [[ -r /sys/kernel/debug/aoc/services ]]; then
    grep -A2 "\"$svc\"" /sys/kernel/debug/aoc/services
  else
    grep -A2 "\"$svc\"" /sys/bus/platform/devices/181d0000.aoc/services ||
      echo "($svc not in the sysfs listing: it stops at a page)"
  fi
  for a in $amps; do
    echo "-- $a"
    # registers up to 0x10100 only: the reading stops there
    awk -F': ' '{a = strtonum("0x" $1)}
      a == 0x2014 || a == 0x2018 || a == 0x2c04 || a == 0x3808 || a == 0x4800 ||
      a == 0x4804 || a == 0x4808 || a == 0x4820 || a == 0x4c00 || a == 0x6000 ||
      a == 0x6c04 || a == 0x10010 || a == 0x10018 || a == 0x10090 || a == 0x10098 {print}
      a > 0x10100 {exit}' "$a/registers"
  done
  find /sys/kernel/debug/asoc -path '*/dapm/*' \( -name 'Main AMP' -o -name ASPRX1 -o -name SPK -o -name bias_level \) \
    -exec sh -c 'echo "$1: $(head -1 "$1")"' _ {} \; 2>/dev/null
}

mix() { amixer -c "$C" -q cset name="$1" "$2" || echo "amixer $1 failed"; }
mix 'Bottom Digital PCM Volume' 0
mix 'Bottom Analog PCM Volume' 0
mix 'Top PCM Source' ASP
mix 'Top Analog PCM Volume' 6
amixer -c "$C" cget name='Top Digital PCM Volume' | tail -1
mix "TDM_0_RX Mixer EP$EP" 1
[[ -w /sys/module/aoc_alsa_dev_util/parameters/ring_debug ]] &&
  echo 1 > /sys/module/aoc_alsa_dev_util/parameters/ring_debug

snap before
for mode in $MODES; do
  case $mode in
    mmap) flag=-M ;;
    copy) flag= ;;
    *) echo "unknown mode $mode"; continue ;;
  esac
  timeout 5 aplay $flag -D "hw:$C,$P" /tmp/tone.wav &
  sleep 2
  snap "during $mode"
  wait; echo "$mode aplay exit $?"
  snap "after $mode"
done

mix "TDM_0_RX Mixer EP$EP" 0
mix 'Top Analog PCM Volume' 0
dmesg | grep -iE 'alsa|aoc|cs35l41|mbox|sysmmu' | grep -v MBOX_TX_QUEUE_LEN | tail -60
