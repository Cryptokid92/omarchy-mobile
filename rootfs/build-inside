#!/bin/bash
# SPDX-License-Identifier: MIT
# Runs inside the Arch Linux ARM build container (privileged, for pacstrap's
# mounts), started by tools/build-rootfs. Mounts:
#   /src      this repository (read-only): rootfs/, patches/omarchy/
#   /repo     out/repo (read-only): the signed [omamobile] repository
#   /modules  the kernel modules tarball (read-only)
#   /target   an empty volume: the root file system is assembled here
#   /out      where the raw image and the MANIFEST go
# Environment: VERSION, DEVICE, DEVICE_PACKAGE, KERNEL_RELEASE,
# MODULES_SHA256, GIT_COMMIT, ALARM_SHA256, OMARCHY_CHANNEL, ALLOW_MISSING
# (space-separated), OUT_UID, OUT_GID.
set -euo pipefail

T=/target
say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
list() { sed -e 's/#.*//' -e 's/[[:space:]]//g' "$1" | grep -v '^$'; }
trap 'chown -R "$OUT_UID:$OUT_GID" /var/cache/pacman/pkg /out 2>/dev/null || true' EXIT

# [omamobile] first, from the repository being shipped
sed -i "0,/^\[omarchy\]/s//[omamobile]\nServer = file:\/\/\/repo\/\$arch\n\n[omarchy]/" /etc/pacman.conf
pacman -Sy >/dev/null
available() { pacman -Sp --print-format %n "$1" >/dev/null 2>&1; }

mapfile -t base < <(list /src/rootfs/packages.base)
mapfile -t ours < <(list /src/rootfs/packages.omamobile)
ours+=("$DEVICE_PACKAGE")
missing=() skipped_ours=()
for p in "${base[@]}"; do available "$p" || missing+=("$p"); done
((${#missing[@]} == 0)) || die "not in any repository: ${missing[*]}"
# Every package of ours must come from [omamobile], not a same-named one
# elsewhere (Mesa, Hyprland, libcamera are in Arch Linux ARM and [omarchy]
# too). One allowed to be missing is left to whatever depends on it.
ours_present=()
for p in "${ours[@]}"; do
  repo=$(pacman -Sp -dd --print-format %r "$p" 2>/dev/null | tail -1 || true)
  if [[ $repo == omamobile ]]; then
    ours_present+=("$p")
  elif [[ " $ALLOW_MISSING " == *" $p "* ]]; then
    skipped_ours+=("$p")
  else
    missing+=("$p${repo:+ (only in [$repo])}")
  fi
done
((${#missing[@]} == 0)) || die "not in out/repo: ${missing[*]} (build them: tools/build-packages; or allow: --allow-missing)"

say "Base system and Omarchy (${#base[@]} packages)"
pacstrap -C /etc/pacman.conf -c -M "$T" "${base[@]}" >/var/log/pacstrap-base.log 2>&1 || { tail -40 /var/log/pacstrap-base.log; die "pacstrap failed"; }

omarchy_list=$T/usr/share/omarchy/install/omarchy-base.packages
[[ -f $omarchy_list ]] || die "no $omarchy_list in the omarchy package"
mapfile -t skip < <(list /src/rootfs/packages.omarchy-skip)
want=() unavailable=()
while read -r p; do
  [[ " ${skip[*]} " == *" $p "* ]] && continue
  if available "$p"; then want+=("$p"); else unavailable+=("$p"); fi
done < <(list "$omarchy_list")
say "Omarchy's package list: ${#want[@]} packages (${#unavailable[@]} not built for aarch64, ${#skip[@]} skipped)"
pacstrap -C /etc/pacman.conf -c -M "$T" --needed "${want[@]}" >/var/log/pacstrap-omarchy.log 2>&1 || { tail -40 /var/log/pacstrap-omarchy.log; die "pacstrap (Omarchy's list) failed"; }

say "Omarchy Mobile packages: ${ours_present[*]}"
pacstrap -C /etc/pacman.conf -c -M "$T" --needed "${ours_present[@]}" >/var/log/pacstrap-omamobile.log 2>&1 || { tail -40 /var/log/pacstrap-omamobile.log; die "pacstrap (Omarchy Mobile) failed"; }

say "pacman.conf and the [omamobile] repository"
sed "s/@OMARCHY_CHANNEL@/$OMARCHY_CHANNEL/" /src/rootfs/pacman.conf > "$T/etc/pacman.conf"
install -Dm644 /etc/pacman.d/mirrorlist "$T/etc/pacman.d/mirrorlist"
mkdir -p "$T/var/lib/omamobile/repo/aarch64"
cp -a /repo/aarch64/. "$T/var/lib/omamobile/repo/aarch64/"
chown -R 0:0 "$T/var/lib/omamobile/repo"
# The image's sync databases match its pacman.conf ([omamobile] from file://)
cp /var/lib/pacman/sync/*.db "$T/var/lib/pacman/sync/" 2>/dev/null || true

say "Kernel modules $KERNEL_RELEASE"
mkdir -p "$T/usr/lib/modules"
rm -rf "${T:?}/usr/lib/modules/$KERNEL_RELEASE"
zstd -dc /modules | tar -C "$T/usr/lib/modules" -xf - --no-same-owner
[[ -d $T/usr/lib/modules/$KERNEL_RELEASE ]] || die "the modules tarball has no $KERNEL_RELEASE"
depmod -b "$T" -a "$KERNEL_RELEASE"
# bin/omamobile push compares this with its tarball, so it won't push them again
echo "$MODULES_SHA256" > "$T/usr/lib/modules/$KERNEL_RELEASE/.omamobile-tarball"

say "Omarchy patches (patches/omarchy)"
# The patches are against Omarchy's source tree (paths under
# /usr/share/omarchy). Omarchy 4 installs some bin/ scripts in /usr/bin and
# links them from bin/, and patch won't follow a link: point those paths at
# the link's target, relative to the image's root.
rebase_patch() {
  local line path target
  while IFS= read -r line; do
    if [[ $line =~ ^(---|\+\+\+)\ ([a-z])/([^[:space:]]+)(.*)$ ]]; then
      path=${BASH_REMATCH[3]} target=usr/share/omarchy/${BASH_REMATCH[3]}
      if [[ -L $T/usr/share/omarchy/$path && $(readlink "$T/usr/share/omarchy/$path") == /* ]]; then
        target=$(readlink "$T/usr/share/omarchy/$path"); target=${target#/}
      fi
      printf '%s %s/%s%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "$target" "${BASH_REMATCH[4]}"
    else
      printf '%s\n' "$line"
    fi
  done < "$1"
}
applied=() not_applied=()
for p in /src/patches/omarchy/*.patch; do
  n=${p##*/}
  rebase_patch "$p" > /tmp/patch
  if patch -d "$T" -p1 --forward --dry-run --silent < /tmp/patch >/dev/null 2>&1; then
    patch -d "$T" -p1 --forward --silent --no-backup-if-mismatch < /tmp/patch >/dev/null
    applied+=("$n")
  else
    not_applied+=("$n")
  fi
done
echo "    applied: ${#applied[@]}, not applying: ${not_applied[*]:-none}"

say "Services"
systemctl --root="$T" enable NetworkManager.service systemd-networkd.service systemd-resolved.service \
  sshd.service sddm.service >/dev/null 2>&1
systemctl --root="$T" mask systemd-networkd-wait-online.service NetworkManager-wait-online.service >/dev/null 2>&1
ln -sfn /run/systemd/resolve/stub-resolv.conf "$T/etc/resolv.conf"
echo omamobile > "$T/etc/hostname"

say "Removing per-machine state"
# No account but root, and root locked: the user comes from firstboot.conf
grep -q '^alarm:' "$T/etc/passwd" && die "an alarm account in the image"
awk -F: '$3 >= 1000 && $3 != 65534 {print $1}' "$T/etc/passwd" | grep -q . && die "a user account in the image"
sed -i 's/^root:[^:]*:/root:!*:/' "$T/etc/shadow"
rm -rf "$T/etc/pacman.d/gnupg"                 # firstboot makes the phone's own keyring
rm -f "$T"/etc/ssh/ssh_host_*                  # sshd makes the phone's own host keys
printf 'uninitialized\n' > "$T/etc/machine-id" # systemd makes the phone's own id
rm -f "$T/var/lib/systemd/random-seed" "$T/var/lib/dbus/machine-id"
rm -rf "$T"/root/.ssh "$T"/root/.bash_history "$T"/root/.gnupg
rm -rf "$T"/etc/NetworkManager/system-connections/* "$T"/var/lib/NetworkManager/*
rm -rf "$T"/var/cache/pacman/pkg/* "$T"/var/log/journal/* "$T"/tmp/* "$T"/var/tmp/*
find "$T/var/log" -type f -exec truncate -s 0 {} +

say "MANIFEST"
{
  echo "# Omarchy Mobile root image"
  echo "version: $VERSION"
  echo "device: $DEVICE ($DEVICE_PACKAGE)"
  echo "built: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "repository commit: $GIT_COMMIT"
  echo "arch linux arm tarball sha256: $ALARM_SHA256"
  echo "omarchy channel: $OMARCHY_CHANNEL"
  echo "kernel modules: $KERNEL_RELEASE (tarball sha256 $MODULES_SHA256)"
  echo "omarchy patches applied: ${applied[*]:-none}"
  echo "omarchy patches not applied: ${not_applied[*]:-none}"
  echo "omarchy packages not built for aarch64: ${unavailable[*]:-none}"
  echo "omarchy packages skipped: ${skip[*]:-none}"
  echo "omamobile packages missing (allowed): ${skipped_ours[*]:-none}"
  echo
  echo "# packages (name version repository)"
  pacman -Sl > /tmp/sync-list
  pacman -r "$T" -Q | awk 'NR == FNR { if (!($2 in repo)) repo[$2] = $1; next }
                           { print $1, $2, (($1 in repo) ? repo[$1] : "local") }' /tmp/sync-list -
} > /out/MANIFEST
install -Dm644 /out/MANIFEST "$T/usr/share/omamobile/rootfs/MANIFEST"

say "ext4 image"
used=$(du -sx --block-size=1M "$T" | cut -f1)
size=$(( (used * 12 / 10 + 768 + 63) / 64 * 64 ))
rm -f /out/rootfs.img
truncate -s "${size}M" /out/rootfs.img
# -m 1: 1% reserved for root, not 5% of a ~100 GB userdata
mkfs.ext4 -q -L omamobile-root -m 1 -d "$T" /out/rootfs.img
e2fsck -fn /out/rootfs.img >/dev/null
echo "    ${used} MiB of files in a ${size} MiB file system"
