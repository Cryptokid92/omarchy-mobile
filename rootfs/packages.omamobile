# SPDX-License-Identifier: MIT
# Omarchy Mobile's packages in the root image, from [omamobile] (out/repo,
# built by tools/build-packages). The device's own package (PACKAGE in
# device/<codename>/device.conf) is added by tools/build-rootfs.
# Not here on purpose: omamobile-modem-sit (not yet run on a phone),
# omamobile-speaker-tuning (off by default; needs the user's extracted
# Waves libraries), omamobile-waydroid (a later goal).
omamobile-keyring
omamobile-firstboot
omamobile-shell
omamobile-apps
omamobile-audio
omamobile-sensors
omamobile-gnss
omamobile-fingerprint
omamobile-mirror
omamobile-modem
libfprint
neard
mesa
vulkan-panfrost
hyprland
libcamera
libcamera-ipa
gst-plugin-libcamera
