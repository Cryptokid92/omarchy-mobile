# SPDX-License-Identifier: MIT
# Omandroid: USB networking to the host. The initramfs sets up the USB
# gadget (CDC NCM) before handing over to Arch; this gives it an address
# and offers the host 172.16.42.2 over DHCP.
[Match]
Name=usb0

[Network]
Address=172.16.42.1/24
DHCPServer=yes
ConfigureWithoutCarrier=yes

[DHCPServer]
PoolOffset=2
PoolSize=1
EmitDNS=no
EmitRouter=no
