// SPDX-License-Identifier: MIT
/*
 * Bring-up only (FINGERPRINT-RESEARCH.md, gate F6): enable the PERIC0 pin
 * controller (the sensor's reset line, gpp1-1) and the Goodix sensor node.
 * Apply on top of fingerprint-trusty.dtso. The sensor's supply, S2MPG13
 * LDO15S, is off at boot and needs the ACPM regulator driver: until its
 * node exists, goodix_fp loads without a supply and stage F6 stops after
 * the reset and interrupt checks.
 */
/dts-v1/;
/plugin/;

&{/soc@0/pinctrl@10840000} {
	status = "okay";
};

&{/fingerprint} {
	status = "okay";
};
