#!/bin/sh
# SPDX-License-Identifier: MIT
# Omarchy Mobile M1 "first light" init: bring up USB networking and ssh.
# Host side: the phone appears as a USB network adapter; ssh root@172.16.42.1

export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t tmpfs tmpfs /run

say() { echo "omarchy-mobile: $*" | tee /dev/kmsg > /dev/tty0 2>/dev/null; }

# The panel runs in MIPI DSI command mode: it only takes a new frame when
# DECON0 sends one on the panel's TE pulse. ABL masks that trigger after
# drawing the logo, so unmask it (TRIG_CON: clear HW_TRIG_MASK_DECON, set
# HW_TRIG_EN) and the framebuffer at 0xfac00000 refreshes continuously.
# Stopgap until we have a real DECON/DSI driver.
devmem 0x1c240030 0x3061 >/dev/null

clear > /dev/tty0 2>/dev/null

# Bring-up probes: watchdog control registers, and the buffer address each
# display DMA channel (DPP) is scanning out, i.e. where ABL's framebuffer is
probe() {
  {
    for w in 0x10060000 0x10070000; do echo "wtcon $w $(devmem $w)"; done
    for n in 0 1 2 3 4 5 8 9 c; do
      b=$((0x1c0b0000 + 0x$n * 0x1000))
      echo "dpp$n cfg $(devmem $b) base $(devmem $((b + 0x40))) $(devmem $((b + 0x44)))"
    done
  } > /run/probe.txt 2>&1
  while read -r line; do echo "omarchy-mobile: $line" > /dev/kmsg; done < /run/probe.txt
}
probe
say "first light on $(cat /proc/sys/kernel/osrelease)"

# USB gadget: CDC NCM network + ACM serial console
g=/sys/kernel/config/usb_gadget/g1
mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409
echo 0x1d6b > $g/idVendor          # Linux Foundation
echo 0x0104 > $g/idProduct         # Multifunction composite gadget
echo "Omarchy Mobile" > $g/strings/0x409/manufacturer
echo "Pixel 7 Pro (M1)" > $g/strings/0x409/product
echo "omarchy-mobile" > $g/strings/0x409/serialnumber
echo "NCM + ACM" > $g/configs/c.1/strings/0x409/configuration
mkdir -p $g/functions/ncm.usb0 $g/functions/acm.GS0
ln -s $g/functions/ncm.usb0 $g/configs/c.1/
ln -s $g/functions/acm.GS0 $g/configs/c.1/

udc=""
for i in $(seq 1 30); do
  udc=$(ls /sys/class/udc 2>/dev/null | head -1)
  [ -n "$udc" ] && break
  sleep 1
done
if [ -n "$udc" ]; then
  echo "$udc" > $g/UDC && say "USB gadget up on $udc"
else
  say "no USB device controller found"
fi

# Network: phone is 172.16.42.1, host gets 172.16.42.2 from udhcpd
ip link set lo up
for i in $(seq 1 10); do ip link show usb0 >/dev/null 2>&1 && break; sleep 1; done
ip addr add 172.16.42.1/24 dev usb0 && ip link set usb0 up
cat > /run/udhcpd.conf <<CONF
start 172.16.42.2
end 172.16.42.2
interface usb0
option subnet 255.255.255.0
lease_file /run/udhcpd.leases
CONF
touch /run/udhcpd.leases
udhcpd /run/udhcpd.conf

# ssh with the developer's key, and a root shell on the USB serial port
mkdir -p /etc/dropbear
dropbear -R -E -p 22 2>/dev/null && say "ssh: root@172.16.42.1"
( while true; do setsid getty -n -l /bin/sh 115200 ttyGS0 vt100; sleep 1; done ) &

say "ready"
# Keep a shell on the screen too
# cttyhack gives the shell tty1 as its controlling terminal (job control)
exec setsid cttyhack sh -c 'exec sh </dev/tty1 >/dev/tty1 2>&1'
