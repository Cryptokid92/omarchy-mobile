diff --git i/shell/plugins/lock/Keypad.qml w/shell/plugins/lock/Keypad.qml
new file mode 100644
index 0000000..eed36cb
--- /dev/null
+++ w/shell/plugins/lock/Keypad.qml
@@ -0,0 +1,68 @@
+import QtQuick
+import qs.Commons
+import qs.Commons as Commons
+import qs.Ui
+
+// Number pad for touch-only devices (phones, tablets), where the lock screen
+// can't count on a keyboard: the session lock hides every other surface,
+// on-screen keyboards included. Enabled by the `lock-keypad` toggle; the digits
+// go into the same password field, so a PIN is simply a numeric password.
+Item {
+  id: root
+
+  signal digit(string value)
+  signal backspace()
+  signal enter()
+
+  readonly property int key: Math.round(Math.min(Style.space(84), (parent ? parent.width : 420) * 0.22))
+  readonly property int gap: Math.round(key * 0.3)
+  readonly property var keys: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "back", "0", "enter"]
+  readonly property var keySpec: Border.surfaceSpec("lock", "border-active", Commons.Color.lock.borderActive, 2, "border-alpha")
+
+  implicitWidth: key * 3 + gap * 2
+  implicitHeight: key * 4 + gap * 3
+  width: implicitWidth
+  height: implicitHeight
+  opacity: enabled ? 1 : 0.5
+
+  Grid {
+    anchors.fill: parent
+    columns: 3
+    spacing: root.gap
+
+    Repeater {
+      model: root.keys
+
+      delegate: BorderSurface {
+        id: keyCap
+        required property string modelData
+
+        width: root.key
+        height: root.key
+        radius: Style.cornerRadius
+        color: tap.pressed ? Commons.Color.lock.selection : Commons.Color.lock.background
+        borderSpec: root.keySpec
+
+        Text {
+          anchors.centerIn: parent
+          textFormat: Text.PlainText
+          text: keyCap.modelData === "back" ? "⌫" : (keyCap.modelData === "enter" ? "⏎" : keyCap.modelData)
+          color: Commons.Color.lock.text
+          font.family: Style.font.family
+          font.pixelSize: Math.round(root.key * 0.38)
+        }
+
+        MouseArea {
+          id: tap
+          anchors.fill: parent
+          enabled: root.enabled
+          onClicked: {
+            if (keyCap.modelData === "back") root.backspace()
+            else if (keyCap.modelData === "enter") root.enter()
+            else root.digit(keyCap.modelData)
+          }
+        }
+      }
+    }
+  }
+}
