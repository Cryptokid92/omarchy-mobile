# Touch screens: swipe through the image picker (backgrounds, themes), fit it
# to a narrow screen, and hold the desktop for the Style menu (there is no
# right button or keyboard shortcut on a phone).
#
# Against Omarchy 4.0.4 (edge 4.0.4-2; tag v4.0.4): only the context of the
# picker's size properties changed (4.0.4 reads Color, not Commons.Color).
diff --git i/shell/plugins/background/Background.qml w/shell/plugins/background/Background.qml
index 21e1b0a..fb94395 100644
--- i/shell/plugins/background/Background.qml
+++ w/shell/plugins/background/Background.qml
@@ -104,6 +104,15 @@ Item {
     if (!bgSwitchProc.running) bgSwitchProc.running = true
   }
 
+  function openStyleMenu() {
+    if (!styleMenuProc.running) styleMenuProc.running = true
+  }
+
+  Process {
+    id: styleMenuProc
+    command: ["omarchy-menu", "summon", "style"]
+  }
+
   function openThemeSwitcher() {
     if (!themeSwitchProc.running) themeSwitchProc.running = true
   }
@@ -312,6 +321,10 @@ Item {
       MouseArea {
         anchors.fill: parent
         acceptedButtons: Qt.LeftButton | Qt.RightButton
+        onPressAndHold: function(mouse) {
+          root.openStyleMenu()
+          mouse.accepted = true
+        }
         onDoubleClicked: function(mouse) {
           if (mouse.button === Qt.RightButton) root.openThemeSwitcher()
           else root.openSelector()
diff --git i/shell/plugins/image-picker/ImagePicker.qml w/shell/plugins/image-picker/ImagePicker.qml
index 5c00240..7f7b65b 100644
--- i/shell/plugins/image-picker/ImagePicker.qml
+++ w/shell/plugins/image-picker/ImagePicker.qml
@@ -38,10 +38,11 @@ Item {
   property color scrim: Color.imagePicker.scrim
   property color selectedBorder: Color.imagePicker.selectedBorder
   property color unselectedBorder: Color.imagePicker.unselectedBorder
-  property int expandedWidth: 768
-  property int expandedHeight: 475
+  // Fit narrow screens (phones): never wider than the window allows.
+  property int expandedWidth: panel.width > 0 ? Math.min(768, panel.width - 96) : 768
+  property int expandedHeight: Math.round(475 * expandedWidth / 768)
   property int sliceWidth: 108
-  property int sliceHeight: 432
+  property int sliceHeight: Math.round(432 * expandedWidth / 768)
   property int sliceSpacing: -30
   property int skewOffset: 28
   property int bottomChromeHeight: showLabels ? (filterable ? 104 : 74) : (filterable ? 60 : 30)
@@ -434,6 +435,18 @@ Item {
 
           Component.onCompleted: forceActiveFocus()
 
+          // Swipe left or right to move through the images on touch screens.
+          DragHandler {
+            target: null
+            yAxis.enabled: false
+            property real swipeX: 0
+            onActiveTranslationChanged: swipeX = activeTranslation.x
+            onActiveChanged: {
+              if (active) swipeX = 0
+              else if (Math.abs(swipeX) > 40) root.selectAdjacent(swipeX < 0 ? 1 : -1)
+            }
+          }
+
           Repeater {
             model: root.imageArray.length
 
