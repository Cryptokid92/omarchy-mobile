#!/bin/bash
# SPDX-License-Identifier: MIT
# Phone hardware-key gestures, called by Hyprland binds (hypr/phone.lua):
#   power + volume down together  -> screenshot (Omarchy's, full screen)
#   power on its own              -> Omarchy's system menu
# Hyprland can't bind a chord of two plain keys, so each key reports here and
# the chord is worked out from when the keys went down. The menu opens when
# power is released (so a chord never opens it); Hyprland cancels that release
# bind once another key goes down, so the screenshot can't wait for it.
set -u

state="${XDG_RUNTIME_DIR:-/tmp}/omandroid-keys"
mkdir -p "$state"

now() { date +%s%3N; }

# Keys count as pressed together within this many milliseconds.
window=500

recent() {
  [[ -f $state/$1 ]] && (($(now) - $(<"$state/$1") <= window))
}

chord() {
  touch "$state/chord"
  # Power's release bind won't fire after the second key, so forget it now:
  # a later volume press on its own must not count as a chord.
  rm -f "$state/power"
  # A moment for the fingers to leave the keys, then Omarchy's screenshot:
  # saved, copied, and a notification with a thumbnail to edit.
  (sleep 0.4; omarchy-capture-screenshot fullscreen) >/dev/null 2>&1 &
}

case "${1:-}" in
  power-down)
    rm -f "$state/chord"
    now >"$state/power"
    recent volume-down && chord
    ;;
  volume-down)
    now >"$state/volume-down"
    # Power still held, or pressed just before.
    [[ -f $state/power ]] && chord
    ;;
  power-up)
    if [[ -f $state/chord ]]; then
      rm -f "$state/chord"
    elif [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]]; then
      # Locked: the menu would open behind the lock screen and greet the
      # user after unlocking. Power just wakes the lock screen.
      :
    elif pgrep -f '[o]rg.omarchy.screensaver' >/dev/null; then
      # Screensaver on: power wakes the phone to its lock, like a tap.
      omarchy-system-lock
    else
      omarchy-menu toggle system
    fi
    rm -f "$state/power"
    ;;
  *)
    echo "Usage: omandroid-keys power-down|power-up|volume-down" >&2
    exit 1
    ;;
esac
