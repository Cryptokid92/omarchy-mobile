#!/bin/bash
# SPDX-License-Identifier: MIT
# First-run setup for a phone, the part Omarchy's installer asks on a computer:
# your name and email (git identity and XCompose, through Omarchy's own
# install/user/git.sh and xcompose.sh), then a PIN if there isn't one.
#
#   omandroid-onboarding           open a terminal and run it
#   omandroid-onboarding --nudge   at login: if anything is missing, say so
set -u

omarchy_path=${OMARCHY_PATH:-/usr/share/omarchy}

has_identity() {
  [[ -n $(git config --global user.name) && -n $(git config --global user.email) ]]
}

has_pin() {
  ! printf '' | unix_chkpwd "$USER" nullok 2>/dev/null
}

case "${1:-}" in
  --nudge)
    has_identity && has_pin && exit 0
    omarchy-notification-send -u critical "Finish setting up your phone" \
      "Add your name and email, and a PIN to lock it. Tap to start." \
      --exec omandroid-onboarding
    ;;
  --inner)
    echo "Welcome to Omandroid. Two quick steps."
    echo
    name=$(gum input --header "Your name" --placeholder "Ada Lovelace" --value "$(git config --global user.name)")
    email=$(gum input --header "Your email" --placeholder "ada@example.com" --value "$(git config --global user.email)")
    if [[ -n $name || -n $email ]]; then
      OMARCHY_USER_NAME=$name OMARCHY_USER_EMAIL=$email bash "$omarchy_path/install/user/git.sh"
      OMARCHY_USER_NAME=$name OMARCHY_USER_EMAIL=$email bash "$omarchy_path/install/user/xcompose.sh"
      echo "Saved."
    fi
    echo
    if has_pin; then
      echo "Your phone already has a PIN (change it any time in System > PIN)."
    else
      omandroid-set-pin --inner
    fi
    ;;
  "")
    exec omarchy-launch-floating-terminal-with-presentation "omandroid-onboarding --inner"
    ;;
  *)
    echo "Usage: omandroid-onboarding [--nudge]" >&2
    exit 1
    ;;
esac
