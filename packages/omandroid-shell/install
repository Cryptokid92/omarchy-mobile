#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omandroid-shell into DESTDIR. Never activates anything.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for program in bin/*; do
  install -Dm755 "$program" "$destination/usr/bin/${program#bin/}"
done
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/share/omandroid/shell/$file"
done < <(find plugins profile hypr branding -type f -print0)
# Your own home-screen widgets: the contract, the template Create copies,
# and examples to copy (never loaded from here).
install -Dm644 widgets/WIDGETS.md "$destination/usr/share/omandroid/shell/WIDGETS.md"
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/share/omandroid/shell/widget-${file#widgets/}"
done < <(find widgets/template widgets/examples -type f -print0)
install -Dm644 environment.d/20-omandroid-osk.conf "$destination/usr/lib/environment.d/20-omandroid-osk.conf"
install -Dm644 systemd/omandroid-nfc-open.service "$destination/usr/lib/systemd/system/omandroid-nfc-open.service"
install -Dm644 polkit/49-omandroid-admin-self.rules "$destination/usr/share/polkit-1/rules.d/49-omandroid-admin-self.rules"
install -Dm644 applications/omandroid-open-intent.desktop "$destination/usr/share/applications/omandroid-open-intent.desktop"
install -Dm644 LICENSE "$destination/usr/share/licenses/omandroid-shell/LICENSE"
install -Dm644 version "$destination/usr/share/omandroid/shell/version"
