{
  "schemaVersion": 1,
  "id": "disk-space",
  "name": "Disk space",
  "version": "1.0.0",
  "author": "Omandroid",
  "description": "How full your home folder's disk is, from df.",
  "kinds": ["home-widget"],
  "entryPoints": { "homeWidget": "Widget.qml" },
  "homeWidget": {
    "icon": "󰋊",
    "size": [2, 1],
    "min": [2, 1],
    "max": [4, 2],
    "capabilities": ["commands"],
    "schema": [
      { "key": "path", "type": "path", "label": "Folder", "defaultValue": "~" },
      { "key": "interval", "type": "integer", "label": "Check every (minutes)", "min": 5, "max": 1440, "defaultValue": 30 }
    ]
  }
}
