#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omandroid-shell, from a copy of this directory alone.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }

for manifest in plugins/*/manifest.json; do
  python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); assert m["id"].startswith("omandroid.")' "$manifest" \
    || fail "$manifest is valid JSON with an omandroid.* id"
done
pass "plugin manifests are valid"

python3 -c 'import json; json.load(open("profile/shell.json"))' || fail "profile/shell.json is valid JSON"
pass "phone profile is valid"

# Qt 6.12's QtQuick/Color shadows Omarchy's palette (omacom/omarchy#14553)
if grep -rnE '(^|[^.[:alnum:]_])Color\.' plugins --include=*.qml; then
  fail "palette references are qualified as Commons.Color"
fi
pass "palette references are qualified"

# QML has to parse; qmlformat is the Qt tool that fails on a syntax error
# without needing the shell's own imports to resolve.
qmlformat=$(command -v qmlformat || command -v /usr/lib/qt6/bin/qmlformat || true)
if [[ -n $qmlformat ]]; then
  for qml in plugins/*/*.qml; do
    "$qmlformat" "$qml" >/dev/null 2>&1 || fail "$qml parses"
  done
  pass "plugin QML parses"
else
  pass "plugin QML parses # SKIP no qmlformat"
fi

# Pure-JS models, under Node when it's there.
if command -v node >/dev/null; then
  for js in plugins/*/*.js; do
    node --check "$js" || fail "$js parses"
  done
  node test/wifi-model.js || fail "Wi-Fi model"
  node test/bluetooth-model.js || fail "Bluetooth model"
  node test/sensor-model.js || fail "fingerprint sensor model"
  node test/tiles-model.js || fail "quick-settings tile layout"
  node test/home-model.js || fail "home screen model"
else
  pass "Wi-Fi and Bluetooth models # SKIP no node"
fi

# The quick-settings tile scripts, against fake commands.
sh -n plugins/omandroid.quicksettings/tile-state.sh || fail "tile-state.sh parses"
sh -n plugins/omandroid.quicksettings/tile-action.sh || fail "tile-action.sh parses"
bash test/tile-scripts.sh || fail "quick-settings tile scripts"

# The Bluetooth pairing helper parses, and its pure parts work without D-Bus.
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omandroid-bt-agent || fail "omandroid-bt-agent parses"
python3 -B test/bt-agent.py || fail "omandroid-bt-agent helpers"

# The fingerprint enrollment helper likewise (fprintd over D-Bus).
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omandroid-fp-enroll || fail "omandroid-fp-enroll parses"
python3 -B test/fp-enroll.py || fail "omandroid-fp-enroll helpers"

# The Wi-Fi password and Bluetooth PINs go over D-Bus or a helper's stdin,
# never argv or the log.
if grep -nE 'console\.(log|info|warn|debug|error)\([^)]*(psk|password|secret|pin|passkey|codeField)' plugins/omandroid.quicksettings/*.qml; then
  fail "passwords and PINs are never logged"
fi
pass "passwords and PINs are never logged"

# The fingerprint target: the layer rule that lifts it above the lock must
# match the window's namespace, and stay render-only there (above_lock 1).
grep -c 'WlrLayershell.namespace: "omandroid-fingerprint"' plugins/omandroid.fingerprint/Fingerprint.qml >/dev/null \
  || fail "fingerprint target namespace"
grep -c 'namespace = "^omandroid-fingerprint\$" }, above_lock = 1' hypr/phone.lua >/dev/null \
  || fail "fingerprint target is drawn above the lock, without input"
python3 -c 'import json; assert {"id": "omandroid.fingerprint"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the fingerprint target"
grep -c 'omandroid.fingerprint' plugins/omandroid.quicksettings/QuickSettings.qml >/dev/null \
  || fail "quick settings opens fingerprint setup"
pass "fingerprint target wiring"

# The on-screen keyboard watcher (squeekboard's sm.puri.OSK0 Visible).
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omandroid-osk-watch || fail "omandroid-osk-watch parses"
python3 -B -c '
import importlib.machinery, importlib.util
loader = importlib.machinery.SourceFileLoader("osk", "bin/omandroid-osk-watch")
spec = importlib.util.spec_from_loader("osk", loader); m = importlib.util.module_from_spec(spec); loader.exec_module(m)
assert m.line_for(True) == "visible true" and m.line_for(0) == "visible false"
assert m.NAME == "sm.puri.OSK0" and m.PATH == "/sm/puri/OSK0"
' || fail "omandroid-osk-watch lines"
grep -c "omandroid-osk-watch" plugins/omandroid.fingerprint/Fingerprint.qml >/dev/null || fail "the fingerprint plugin runs the keyboard watcher"
grep -c "omandroid-osk-watch" plugins/omandroid.keyboard/Keyboard.qml >/dev/null || fail "the keyboard button follows the watcher"
grep -c 'namespace = "^omandroid-osk-hide\$" }, above_lock = 2' hypr/phone.lua >/dev/null || fail "the hide button works over the lock"
python3 -c 'import json; assert {"id": "omandroid.keyboard"} in json.load(open("profile/shell.json"))["plugins"]' || fail "the profile enables the keyboard button"
pass "on-screen keyboard watcher"

# PIN or password: the choice is recorded per user, never the secret, and
# mirrored to Omarchy's credential-password toggle.
bash -n bin/omandroid-set-pin || fail "omandroid-set-pin parses"
fake=$(mktemp -d)
[[ $(HOME=$fake bash bin/omandroid-set-pin --type) == pin ]] || fail "a phone without a record counts as PIN"
mkdir -p "$fake/.config/omandroid"; echo password >"$fake/.config/omandroid/credential"
[[ $(HOME=$fake bash bin/omandroid-set-pin --type) == password ]] || fail "a password user reads as password"
rm -rf "$fake"
grep -c 'namespace = "^osk\$" }, above_lock = 2' hypr/phone.lua >/dev/null || fail "the on-screen keyboard works above the lock"
pass "PIN or password"

# Home screens: enabled for new and existing users, and the widget files the
# registry names exist.
python3 -c 'import json; assert {"id": "omandroid.home"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the home screens"
grep -c 'add_plugin omandroid.home' bin/omandroid-setup-user >/dev/null || fail "existing users get the home screens"
if command -v node >/dev/null; then
  for type in $(node -e 'console.log(Object.keys(require("./plugins/omandroid.home/HomeModel.js").REGISTRY).join(" "))'); do
    [[ -f plugins/omandroid.home/${type^}Widget.qml ]] || fail "widget $type has ${type^}Widget.qml"
  done
fi
pass "home screen wiring"

# The user's own widgets: the tool, its tests, and what ships with it.
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omandroid-widget || fail "omandroid-widget parses"
python3 -B test/widget-tool.py || fail "omandroid-widget"
for json in widgets/template/manifest.json widgets/examples/*/manifest.json; do
  python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); assert "home-widget" in m["kinds"]' "$json" || fail "$json is a home-widget manifest"
done
if [[ -n $qmlformat ]]; then
  for qml in widgets/template/*.qml widgets/examples/*/*.qml; do
    "$qmlformat" "$qml" >/dev/null 2>&1 || fail "$qml parses"
  done
fi
if grep -rnE '(^|[^.[:alnum:]_])Color\.|"#[0-9a-fA-F]{3,8}"' widgets --include=*.qml; then
  fail "shipped widgets take colours from the theme"
fi
grep -c 'UserWidgetCell.qml' plugins/omandroid.home/Home.qml >/dev/null || fail "user widgets load through UserWidgetCell"
grep -c 'omarchy-agent-prompt' bin/omandroid-widget >/dev/null || fail "widgets are made with Omarchy's default agent"
pass "user widgets"

bash -n bin/omandroid-setup-user || fail "omandroid-setup-user parses"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
./install "$tmp/root"
[[ -x $tmp/root/usr/bin/omandroid-setup-user && -f $tmp/root/usr/share/omandroid/shell/profile/shell.json ]] \
  || fail "install stages the setup script and the profile"
[[ -x $tmp/root/usr/bin/omandroid-widget && -f $tmp/root/usr/share/omandroid/shell/WIDGETS.md \
   && -f $tmp/root/usr/share/omandroid/shell/widget-template/manifest.json \
   && -f $tmp/root/usr/share/omandroid/shell/widget-examples/countdown/Widget.qml ]] \
  || fail "install stages the widget tool, contract, template and examples"
pass "install stages the package"
