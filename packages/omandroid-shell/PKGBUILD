pkgname=omandroid-shell
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omandroid's phone profile for the Omarchy shell: status bar, quick settings, launcher"
arch=(any)
url="https://github.com/derekross/omandroid"
license=(MIT)
depends=(omarchy omandroid-apps bash squeekboard bluez python python-dbus python-gobject
         pipewire-audio pipewire-pulse pipewire-alsa wireplumber
         inotify-tools qt6-declarative)
optdepends=('fprintd: fingerprint setup and unlock (with omandroid-fingerprint)')
install=omandroid-shell.install

package() {
  "$startdir/install" "$pkgdir"
}

check() {
  "$startdir/test/all"
}
