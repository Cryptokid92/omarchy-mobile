#!/bin/bash
# SPDX-License-Identifier: MIT
# omandroid-mirror: show (and control) the phone's screen from a computer
# on the USB cable, over VNC (wayvnc).
#
#   omandroid-mirror on             start wayvnc in the logged-in user's
#                                   session, listening on 172.16.42.1:5900
#                                   (the USB link) only, and open that port
#                                   in ufw on usb0 only
#   omandroid-mirror off            stop it and close the port again
#   omandroid-mirror status [--json]
#
# Settings (frame rate, view-only, a password): ~/.config/omandroid/mirror.conf,
# see /usr/share/omandroid/mirror/mirror.conf.example.
#
# Works as root (tools/phone-ssh from the computer: it finds the session's
# user) or as that user (the firewall step then goes through
# omandroid-mirror-firewall.service, which polkit lets the active local user
# start and stop). On the computer, tools/phone-mirror does all of this and
# opens the viewer.
set -euo pipefail

ADDRESS=172.16.42.1
PORT=5900
IFACE=usb0
UNIT=omandroid-mirror.service
FW_UNIT=omandroid-mirror-firewall.service
FW_RULE=(in on "$IFACE" to "$ADDRESS" port "$PORT" proto tcp)

die() { echo "omandroid-mirror: $*" >&2; exit 1; }
usage() { sed -n '3,20s/^# \{0,1\}//p' "$0" >&2; exit 2; }
# OMANDROID_MIRROR_ASSUME_ROOT=0 is for test/all only: without real root
# the commands it unlocks just fail.
is_root() { [[ ${OMANDROID_MIRROR_ASSUME_ROOT:-$EUID} == 0 ]]; }

# The user who owns the active graphical session on seat0.
session_user() {
  if [[ -n ${OMANDROID_MIRROR_USER:-} ]]; then echo "$OMANDROID_MIRROR_USER"; return; fi
  if ! is_root; then id -un; return; fi
  local s props
  for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
    props=$(loginctl show-session "$s" -p Name -p Type -p Active -p Class 2>/dev/null) || continue
    [[ $'\n'$props$'\n' == *$'\nActive=yes\n'* ]] || continue
    [[ $props =~ (^|$'\n')Class=user(-early)?($'\n'|$) ]] || continue
    [[ $props =~ (^|$'\n')Type=(wayland|x11) ]] || continue
    [[ $props =~ (^|$'\n')Name=([^$'\n']+) ]] && { echo "${BASH_REMATCH[2]}"; return; }
  done
  # Fallback: whoever owns a Wayland socket
  local w
  for w in /run/user/*/wayland-[0-9]; do
    [[ -S $w ]] && { stat -c %U "$w"; return; }
  done
  return 1
}

U=
usys() { # systemctl for the session user's manager
  if is_root; then systemctl --user -M "$U@" "$@"; else systemctl --user "$@"; fi
}
running() { [[ $(usys is-active "$UNIT" 2>/dev/null || true) == active ]]; }

ufw_active() {
  command -v ufw >/dev/null || return 1
  [[ $(ufw status 2>/dev/null | head -n1) == "Status: active" ]]
}

cmd_firewall() { # internal: run by omandroid-mirror-firewall.service as root
  is_root || die "firewall needs root"
  case ${1:-} in
    open)
      if ufw_active; then
        # This port, on the USB gadget interface, to the USB address only.
        ufw allow "${FW_RULE[@]}" comment 'omandroid-mirror'
      else
        echo "omandroid-mirror: ufw is not active; nothing to open"
      fi ;;
    close)
      command -v ufw >/dev/null || return 0
      ufw --force delete allow "${FW_RULE[@]}" >/dev/null 2>&1 || true ;;
    *) die "firewall open|close" ;;
  esac
}

firewall_state() {
  if is_root; then
    if ! command -v ufw >/dev/null; then echo "no ufw"; return; fi
    if ! ufw_active; then echo "ufw inactive"; return; fi
    if ufw status 2>/dev/null | grep -F "$ADDRESS $PORT/tcp on $IFACE" >/dev/null; then echo open; else echo closed; fi
  else
    [[ $(systemctl is-active "$FW_UNIT" 2>/dev/null || true) == active ]] && echo open || echo closed
  fi
}

link_up() { ip -4 -o addr show dev "$IFACE" 2>/dev/null | grep -F " $ADDRESS/" >/dev/null; }

cmd_on() {
  U=$(session_user) || die "nobody is logged in to a graphical session"
  link_up || die "$ADDRESS is not on $IFACE: mirroring works over the USB cable only"
  if running; then
    echo "omandroid-mirror: already on"
  else
    systemctl start "$FW_UNIT" || die "could not open port $PORT on $IFACE ($FW_UNIT)"
    if ! usys start "$UNIT"; then
      systemctl stop "$FW_UNIT" || true
      die "wayvnc did not start: journalctl --user -u $UNIT (as $U)"
    fi
  fi
  cmd_status
}

cmd_off() {
  U=$(session_user) || U=
  if [[ -n $U ]]; then usys stop "$UNIT" 2>/dev/null || true; fi
  systemctl stop "$FW_UNIT" 2>/dev/null || true
  # A rule left behind by a crash (the unit was never stopped) goes too.
  if is_root; then cmd_firewall close; fi
  echo "omandroid-mirror: off"
}

cmd_status() {
  local json=0 on=no user fw
  [[ ${1:-} == --json ]] && json=1
  U=$(session_user) || U=
  user=${U:-none}
  [[ -n $U ]] && running && on=yes
  fw=$(firewall_state)
  local link=no; link_up && link=yes
  if (( json )); then
    printf '{"running":%s,"address":"%s","port":%d,"url":"vnc://%s:%d","usb_link":%s,"firewall":"%s","user":"%s"}\n' \
      "$([[ $on == yes ]] && echo true || echo false)" "$ADDRESS" "$PORT" "$ADDRESS" "$PORT" \
      "$([[ $link == yes ]] && echo true || echo false)" "$fw" "$user"
    return
  fi
  echo "mirroring: $on"
  echo "address:   $ADDRESS:$PORT (vnc://$ADDRESS:$PORT, USB link $IFACE: $link)"
  echo "firewall:  $fw"
  echo "user:      $user"
  [[ $on == yes ]] && echo "connect:   tools/phone-mirror on the computer, or any VNC viewer to $ADDRESS:$PORT"
  return 0
}

case ${1:-} in
  on) cmd_on ;;
  off) cmd_off ;;
  status) shift; cmd_status "$@" ;;
  firewall) shift; cmd_firewall "$@" ;;
  *) usage ;;
esac
