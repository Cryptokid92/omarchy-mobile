# Screen mirroring's firewall rule: while this unit is active, ufw lets
# TCP 5900 in on usb0 to 172.16.42.1 (the USB link only, never Wi-Fi).
# Started and stopped by omandroid-mirror on|off; the active local user may
# do that through /usr/share/polkit-1/rules.d/50-omandroid-mirror.rules.
# Stopping it at shutdown removes the rule again.
[Unit]
Description=Omandroid screen mirroring: VNC port on the USB link
After=ufw.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/omandroid-mirror firewall open
ExecStop=/usr/bin/omandroid-mirror firewall close
