# Screen mirroring: wayvnc on the USB link (172.16.42.1:5900) only.
# On demand, never enabled: omandroid-mirror on|off starts and stops it.
[Unit]
Description=Omandroid screen mirroring (VNC on the USB link)
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/lib/omandroid-mirror/omandroid-mirror-run
Restart=on-failure
RestartSec=3
