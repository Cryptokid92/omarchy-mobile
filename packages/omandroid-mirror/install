#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omandroid-mirror into DESTDIR. Enables nothing: mirroring runs only
# between "omandroid-mirror on" and "off".
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 bin/omandroid-mirror "$d/usr/bin/omandroid-mirror"
install -Dm755 lib/omandroid-mirror-run "$d/usr/lib/omandroid-mirror/omandroid-mirror-run"
install -Dm644 systemd/user/omandroid-mirror.service "$d/usr/lib/systemd/user/omandroid-mirror.service"
install -Dm644 systemd/system/omandroid-mirror-firewall.service "$d/usr/lib/systemd/system/omandroid-mirror-firewall.service"
install -Dm644 polkit/50-omandroid-mirror.rules "$d/usr/share/polkit-1/rules.d/50-omandroid-mirror.rules"
install -Dm644 share/mirror.conf.example "$d/usr/share/omandroid/mirror/mirror.conf.example"
install -Dm644 README.md "$d/usr/share/doc/omandroid-mirror/README.md"
install -Dm644 LICENSE "$d/usr/share/licenses/omandroid-mirror/LICENSE"
install -Dm644 version "$d/usr/share/omandroid/mirror/version"
