#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# A stand-in for pw-dump and pw-cli set-param, for test/all: the speaker
# filter's input node with its graph controls in FAKE_PW_STATE (JSON
# {"node:Control": value}), created from the package file's values.
import json
import os
import re
import sys

state = os.environ['FAKE_PW_STATE']
NODE_ID = 33


def load():
    with open(state) as f:
        return json.load(f)


me = os.path.basename(sys.argv[0])
if me == 'pw-dump':
    vals = load()
    flat = []
    for k, v in vals.items():
        flat += [k, v]
    print(json.dumps([
        {'id': 30, 'type': 'PipeWire:Interface:Node', 'info': {'props': {'node.name': 'alsa_output.x'}}},
        {'id': NODE_ID, 'type': 'PipeWire:Interface:Node',
         'info': {'props': {'node.name': 'effect_input.omandroid_speaker_loudness'},
                  'params': {'Props': [{'volume': 1.0, 'params': ['monitor.channel-volumes', False]},
                                       {'params': flat}]}}}]))
    sys.exit(0)
if me == 'pw-cli':
    args = sys.argv[1:]
    if args[:1] != ['set-param'] or args[1] != str(NODE_ID) or args[2] != 'Props':
        print(f'fake pw-cli: unexpected {args}', file=sys.stderr)
        sys.exit(1)
    vals = load()
    for k, v in re.findall(r'"([^"]+)"\s+(-?[0-9.e+-]+)', args[3]):
        if k not in vals or os.environ.get('FAKE_PW_IGNORE') == '1':
            continue                          # the filter ignores unknown controls
        vals[k] = float(v)
    with open(state, 'w') as f:
        json.dump(vals, f)
    with open(os.environ['FAKE_PW_LOG'], 'a') as f:
        f.write(args[3] + '\n')
    sys.exit(0)
sys.exit(2)
