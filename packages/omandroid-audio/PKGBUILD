pkgname=omandroid-audio
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omandroid audio for the Pixel 7 Pro: UCM profile and PipeWire rules for the AoC sound card, speaker protection with the factory calibration"
arch=(any)
url="https://github.com/derekross/omandroid"
license=(MIT)
depends=(bash coreutils kmod alsa-utils alsa-ucm-conf e2fsprogs pipewire wireplumber)
backup=(etc/omandroid/speaker.conf)

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
