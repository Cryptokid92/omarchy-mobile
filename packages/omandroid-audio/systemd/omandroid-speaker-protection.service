# The speaker amplifiers with Cirrus protection and the factory calibration
# (device/cheetah/AOC-PLAN.md stage C8). Not enabled by the package: enable it
# once C8 has passed by hand,
#   systemctl enable omandroid-speaker-protection
# Until then the amplifier driver stays blacklisted (modprobe.d/omandroid-audio.conf),
# so there is no AoC sound card at boot. If a start hangs, the next boot leaves
# the amplifiers off (see the script).
#
# Ordered before user sessions, so PipeWire probes the card once, after the
# amplifiers are set up (the AoC is up about 5 s into boot; the timeout bounds
# the wait).
[Unit]
Description=Speaker amplifiers with protection firmware and factory calibration (hang-safe)
Requires=omandroid-aoc.service
After=omandroid-aoc.service
Before=systemd-user-sessions.service
ConditionPathExists=/sys/bus/platform/devices/181d0000.aoc

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/omandroid/speaker.conf
ExecStart=/usr/bin/omandroid-speaker-protection start
ExecStop=/usr/bin/omandroid-speaker-protection mute
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
