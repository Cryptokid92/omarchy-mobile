# iio-sensor-proxy's D-Bus API from the AoC's sensors, at boot after the AoC
# (omamobile-aoc.service). Enabled by the package (multi-user.target.wants).
[Unit]
Description=Sensor proxy for the AoC's sensors (net.hadess.SensorProxy)
Requires=omamobile-aoc.service
After=omamobile-aoc.service dbus.service
ConditionPathExists=/dev/acd-com.google.usf

[Service]
Type=dbus
BusName=net.hadess.SensorProxy
ExecStart=/usr/bin/omamobile-sensor-proxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
