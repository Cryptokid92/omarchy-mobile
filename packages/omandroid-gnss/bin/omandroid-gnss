#!/bin/bash
# SPDX-License-Identifier: MIT
# omandroid-gnss: the phone's Location switch and GNSS status.
#
#   omandroid-gnss on       Location on: apps can ask GeoClue for positions,
#                           and the receiver runs only while one does
#                           (omandroid-gnss-nmea.socket and the GeoClue
#                           agent, omandroid-geoclue-agent, enabled)
#   omandroid-gnss off      Location off: stop the receiver now and let
#                           nothing start it
#   omandroid-gnss force    keep the receiver running with no client (tests,
#                           gpsd on /run/omandroid-gnss/nmea-tty)
#   omandroid-gnss unforce  back to on-demand
#   omandroid-gnss status [--json]
#
# on/off/force/unforce need root. As another user they go through
# omandroid-gnss-location@.service, which polkit lets the active local user
# start (the shell's quick-settings tile uses exactly that), and on/off also
# start/stop the caller's own GeoClue agent right away.
set -euo pipefail

SOCKET=omandroid-gnss-nmea.socket
BRIDGE=omandroid-gnss-nmea.service
STACK=omandroid-gnss.service
FORCE=omandroid-gnss-force.service
AGENT=omandroid-geoclue-agent.service
ROOT=/usr/lib/omandroid-vendor/gnss/root

usage() {
  sed -n '3,14s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

as_root() { # $1 action
  if [[ $EUID -ne 0 ]]; then
    systemctl start "omandroid-gnss-location@$1.service"
    case $1 in
      on) systemctl --user start "$AGENT" 2>/dev/null || true ;;
      off) systemctl --user stop "$AGENT" 2>/dev/null || true ;;
    esac
    exit 0
  fi
}

state() { systemctl "$1" "$2" 2>/dev/null || true; }

# The chip's power: the GNSS rails (world-readable, unlike debugfs). No
# vdd_gnss_core regulator means sec_acpm isn't loaded, so the rails are off.
powered() {
  local r
  for r in /sys/class/regulator/regulator.*; do
    [[ $(cat "$r/name" 2>/dev/null) == vdd_gnss_core ]] || continue
    [[ $(cat "$r/state" 2>/dev/null) == enabled ]] && echo yes || echo no
    return
  done
  echo no
}

status() {
  local location running forced agent powered
  location=$([[ $(state is-enabled $SOCKET) == enabled ]] && echo on || echo off)
  running=$([[ $(state is-active $STACK) == active ]] && echo yes || echo no)
  forced=$([[ $(state is-active $FORCE) == active ]] && echo yes || echo no)
  agent=$([[ $(systemctl --global is-enabled $AGENT 2>/dev/null) == enabled ]] && echo on || echo off)
  powered=$(powered)
  if [[ ${1:-} == --json ]]; then
    printf '{"location":"%s","running":"%s","forced":"%s","powered":"%s","agent":"%s","installed":%s}\n' \
      "$location" "$running" "$forced" "$powered" "$agent" "$([[ -d $ROOT ]] && echo true || echo false)"
  else
    echo "location: $location"
    echo "receiver running: $running$([[ $forced == yes ]] && echo " (forced)")"
    echo "chip powered: $powered"
    echo "GeoClue agent: $agent"
    [[ -d $ROOT ]] || echo "vendor files: missing ($ROOT; tools/extract-vendor-chroot -p gnss)"
  fi
}

case ${1:-} in
  on)
    as_root on
    systemctl enable --now "$SOCKET"
    systemctl --global enable "$AGENT"
    ;;
  off)
    as_root off
    systemctl stop "$FORCE" "$BRIDGE" "$STACK" 2>/dev/null || true
    systemctl disable --now "$SOCKET"
    systemctl --global disable "$AGENT"
    ;;
  force)
    as_root force
    systemctl start "$FORCE"
    ;;
  unforce)
    as_root unforce
    systemctl stop "$FORCE"
    ;;
  status) status "${2:-}" ;;
  *) usage ;;
esac
