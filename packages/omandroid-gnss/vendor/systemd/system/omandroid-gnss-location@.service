# The Location switch for unprivileged callers (the shell's quick settings):
# systemctl start omandroid-gnss-location@on.service / @off.service runs
# "omandroid-gnss on|off" as root. Allowed for the active local user by
# /usr/share/polkit-1/rules.d/50-omandroid-gnss.rules.
[Unit]
Description=Omandroid Location %i

[Service]
Type=oneshot
ExecStart=/usr/bin/omandroid-gnss %i
