# SPDX-License-Identifier: MIT
# Keeps GNSS running with no client ("omandroid-gnss force"), for tests and
# for gpsd users: holds the bridge (and so the stack) up and stops the
# bridge's idle exit while it is active.
[Unit]
Description=Omandroid GNSS, kept running
Wants=omandroid-gnss-nmea.service
After=omandroid-gnss-nmea.socket

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /run/omandroid-gnss && touch /run/omandroid-gnss/pinned'
ExecStop=/bin/rm -f /run/omandroid-gnss/pinned
