# SPDX-License-Identifier: MIT
# Checks the orbit file every few hours while Location is on; the service
# downloads only when the file is old and the network is not cellular.
# Enabled by "omandroid-gnss on", disabled by "off".
[Unit]
Description=Omandroid GNSS orbit predictions (LTO), periodic check

[Timer]
OnBootSec=10min
OnUnitActiveSec=4h
RandomizedDelaySec=20min
Persistent=yes

[Install]
WantedBy=timers.target
