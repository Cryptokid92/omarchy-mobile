# SPDX-License-Identifier: MIT
# Refreshes the GNSS long-term orbit file (lto2.dat) when it is older than
# LTO_MAX_AGE_HOURS and the phone has a non-cellular network route
# (/etc/omandroid/gnss.conf). A plain HTTP download, no identifiers. Started
# by omandroid-gnss-lto.timer, which "omandroid-gnss on" enables.
[Unit]
Description=Omandroid GNSS orbit predictions (LTO) download
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/lib/omandroid-vendor/gnss/root

[Service]
Type=oneshot
ExecStart=/usr/lib/omandroid-vendor/omandroid-gnss-lto --timeout 60
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=-/var/lib/omandroid-vendor/gnss
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
