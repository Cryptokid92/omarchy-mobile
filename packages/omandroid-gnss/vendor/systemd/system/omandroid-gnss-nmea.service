# SPDX-License-Identifier: MIT
# Serves the GNSS engine's NMEA to GeoClue (Unix socket, from
# omandroid-gnss-nmea.socket) and gpsd (pty). Started when GeoClue connects
# (or by "omandroid-gnss force"); exits a minute after the last client goes,
# which stops the GNSS stack with it.
[Unit]
Description=Omandroid GNSS NMEA bridge
BindsTo=omandroid-gnss.service
After=omandroid-gnss.service
Requires=omandroid-gnss-nmea.socket
After=omandroid-gnss-nmea.socket

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 1 150); do [ -p /var/lib/omandroid-vendor/gnss/data/vendor/gps/nmea_out ] && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/lib/omandroid-vendor/omandroid-gnss-nmea --idle-exit 60
ProtectSystem=strict
ReadWritePaths=-/var/lib/omandroid-vendor/gnss/data/vendor/gps -/run/omandroid-gnss
