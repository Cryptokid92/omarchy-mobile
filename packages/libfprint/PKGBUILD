# SPDX-License-Identifier: 0BSD
#
# Omandroid build of libfprint for the Pixel 7 Pro: upstream libfprint with
# one more driver, omandroid_udfps (omandroid-udfps.c), which reaches the
# phone's under-display sensor through omandroid-fp-bridge
# (packages/omandroid-fingerprint, device/cheetah/FINGERPRINT-PLAN.md).
# The driver is a "virtual" type device: it appears only when fprintd's
# environment names the bridge's socket (FP_OMANDROID_UDFPS, set by
# omandroid-fingerprint's fprintd drop-in), so this build behaves exactly
# like upstream's anywhere else.
#
# Options follow Arch Linux's libfprint 1.94.100-1 (gtk-doc off here).
# pkgrel 1.1 sorts above Arch Linux ARM's 1.94.100-1. Check the driver on the
# computer with test/run (an Arch container, a fake bridge).

pkgname=libfprint
pkgver=1.94.100
pkgrel=1.1
_tag=v$pkgver
pkgdesc="Library for fingerprint readers (Omandroid: Pixel 7 Pro under-display sensor)"
arch=(aarch64)
url="https://fprint.freedesktop.org/"
license=(LGPL-2.1-or-later)
depends=(gcc-libs glib2 glibc libgudev libgusb openssl pixman)
makedepends=(git glib2-devel gobject-introspection meson)
provides=(libfprint-2.so)
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git#tag=$_tag"
        0001-add-the-omandroid_udfps-driver.patch
        omandroid-udfps.c)
sha256sums=('SKIP'
            'c1d09244cfbf5dff437cc930e504fa2b69704da1f07fa9579db5f11a5e740b3e'
            'fde2508fc8797d15cf864a9942167d36ecfd09eb8880f5f7462b97450dd12e67')

prepare() {
  cd libfprint
  patch -Np1 -i ../0001-add-the-omandroid_udfps-driver.patch
  cp ../omandroid-udfps.c libfprint/drivers/
}

build() {
  arch-meson libfprint build -D doc=false -D gtk-examples=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
