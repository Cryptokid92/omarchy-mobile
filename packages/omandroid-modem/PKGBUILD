pkgname=omandroid-modem
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omandroid modem runtime for the Pixel 7 Pro: stock rfsd and cbd in a vendor chroot on RAM copies of NV"
arch=(aarch64)
url="https://github.com/derekross/omandroid"
license=(MIT)
depends=(bash python util-linux coreutils kmod systemd omandroid-gnss omandroid-device-cheetah)
install=omandroid-modem.install

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
