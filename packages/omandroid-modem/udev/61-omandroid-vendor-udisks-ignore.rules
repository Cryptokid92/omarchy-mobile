# SPDX-License-Identifier: MIT
# Omandroid: the vendor chroots loop-mount RAM copies of the modem's NV and
# firmware from /run/omandroid-vendor. Keep udisks (and so the desktop's
# automounter) away from them: udiskie tried to mount each one at modem
# start, and each attempt raised an administrator password prompt.
SUBSYSTEM=="block", KERNEL=="loop*", ATTR{loop/backing_file}=="/run/omandroid-vendor/*", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0"
