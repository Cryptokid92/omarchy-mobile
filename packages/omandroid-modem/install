#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omandroid-modem into DESTDIR. Enables nothing. Google's Android files
# are not part of the package: tools/extract-vendor-chroot -p modem makes
# them from the user's own factory image
# (/usr/lib/omandroid-vendor/modem/{root,MANIFEST,SOURCE,STUBS}); the NV
# checksums (/etc/omandroid/modem-nv.sha256) come from the user's own
# off-repo backup.
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
v=$d/usr/lib/omandroid-vendor
install -Dm755 lib/omandroid-modem-start "$v/omandroid-modem-start"
install -Dm755 lib/omandroid-modem-cp "$v/omandroid-modem-cp"
install -Dm644 profiles/modem.conf "$v/profiles/modem.conf"
install -Dm644 modem/props.conf "$v/modem/props.conf"
install -Dm644 systemd/omandroid-modem.service "$d/usr/lib/systemd/system/omandroid-modem.service"
install -Dm644 udev/60-omandroid-modem-nv-ro.rules "$d/usr/lib/udev/rules.d/60-omandroid-modem-nv-ro.rules"
install -Dm644 udev/61-omandroid-vendor-udisks-ignore.rules "$d/usr/lib/udev/rules.d/61-omandroid-vendor-udisks-ignore.rules"
install -Dm644 LICENSE "$d/usr/share/licenses/omandroid-modem/LICENSE"
install -Dm644 version "$d/usr/share/omandroid/modem/version"
