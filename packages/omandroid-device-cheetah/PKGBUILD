pkgname=omandroid-device-cheetah
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omandroid support for the Google Pixel 7 Pro (cheetah): boot-slot success, storage guard, USB networking"
arch=(aarch64)
url="https://github.com/derekross/omandroid"
license=(MIT Apache-2.0)
depends=(bash systemd util-linux omandroid-keyring)
backup=(etc/pacman.d/omandroid-mirrorlist)
install=omandroid-device-cheetah.install
makedepends=(gcc python)

build() {
  "$startdir/build" "$srcdir/build"
}

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir" "$srcdir/build"
}
