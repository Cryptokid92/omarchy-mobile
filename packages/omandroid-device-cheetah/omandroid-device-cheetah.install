# SPDX-License-Identifier: MIT
# Add the [omandroid] repository to pacman.conf, before [omarchy] so its
# builds (e.g. Mesa with Mali-G710 support) win. Added once; never removed
# automatically, so a user's edits stay.
add_repository() {
  local conf=/etc/pacman.conf
  grep -q '^\[omandroid\]' "$conf" && return
  local entry='[omandroid]\nInclude = /etc/pacman.d/omandroid-mirrorlist\n'
  if grep -q '^\[omarchy\]' "$conf"; then
    sed -i "0,/^\[omarchy\]/s//${entry//\//\\/}\n[omarchy]/" "$conf"
  elif grep -q '^\[core\]' "$conf"; then
    sed -i "0,/^\[core\]/s//${entry//\//\\/}\n[core]/" "$conf"
  else
    printf '\n[omandroid]\nInclude = /etc/pacman.d/omandroid-mirrorlist\n' >>"$conf"
  fi
}

post_install() {
  add_repository
}

post_upgrade() {
  add_repository
}
