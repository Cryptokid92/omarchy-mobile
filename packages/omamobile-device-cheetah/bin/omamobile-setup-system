#!/bin/bash
# SPDX-License-Identifier: MIT
# Omarchy Mobile's system setup: what a platform's "setup-system" step does in
# Omarchy's lifecycle contract. Runs as root; safe to rerun.
#   omamobile-setup-system [timezone]
set -euo pipefail

# UTF-8 locale (Qt and Omarchy's tools expect one)
sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen >/dev/null
echo "LANG=en_US.UTF-8" > /etc/locale.conf

# Time: no battery-backed clock is used yet, so keep NTP on
if [[ -n ${1:-} ]]; then
  ln -sf "/usr/share/zoneinfo/$1" /etc/localtime
fi
systemctl enable --now systemd-timesyncd >/dev/null 2>&1 || true
