// The Location switch: let the active local user start
// omamobile-gnss-location@on|off|force|unforce.service, which runs
// "omamobile-gnss <action>" as root. Nothing else.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.local && subject.active &&
      /^omamobile-gnss-location@(on|off|force|unforce)\.service$/.test(action.lookup("unit")) &&
      action.lookup("verb") == "start") {
    return polkit.Result.YES;
  }
});
