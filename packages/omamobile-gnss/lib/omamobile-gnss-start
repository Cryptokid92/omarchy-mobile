#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-gnss-start: bring GNSS up the hang-safe way, then run the gnss
# vendor-chroot profile in the foreground (omamobile-gnss.service).
#
# Like omamobile-wifi-start: a marker file is written and synced before the
# kernel driver loads; it is removed once the daemons are up. If the phone
# hung or reset in between, the next boot finds the marker and skips GNSS
# until someone runs this with --retry.
set -euo pipefail

MARK=/var/lib/omamobile/gnss-bringup-started
say() { printf 'omamobile-gnss: %s\n' "$*" >&2; }

if [[ ${1:-} == --retry ]]; then
  rm -f "$MARK"
elif [[ -e $MARK ]]; then
  say "the last bring-up ($(cat "$MARK")) never finished; skipping GNSS (run omamobile-gnss-start --retry)"
  exit 0
fi

# The DT must have the GNSS node enabled (gnss overlay); otherwise nothing to do.
if ! grep -qs okay /sys/firmware/devicetree/base/soc@0/usi@109400c0/spi@10940000/status; then
  say "SPI5 is not enabled in this device tree; nothing to do"
  exit 0
fi

mkdir -p "$(dirname "$MARK")"
date -Is > "$MARK"
sync

# The GNSS rails come from the S2MPG13 (sec_acpm), then the chip driver.
modprobe sec_acpm
modprobe bcm4775x-gnss
for _ in $(seq 1 50); do [[ -c /dev/ttyBCM ]] && break; sleep 0.1; done
[[ -c /dev/ttyBCM ]] || { say "no /dev/ttyBCM after loading bcm4775x-gnss"; exit 1; }

rm -f "$MARK"
sync
say "driver up; starting lhd and gpsd"
exec /usr/lib/omamobile-vendor/omamobile-vendor-chroot gnss start
