# SPDX-License-Identifier: MIT
# GeoClue's NMEA source connects here ([network-nmea] nmea-socket=); the
# first connection starts the bridge and with it the GNSS stack. Enabled by
# "omamobile-gnss on" (the Location switch), not by default.
[Unit]
Description=Omarchy Mobile GNSS NMEA socket (location on demand)

[Socket]
ListenStream=/run/omamobile-gnss/nmea.sock
SocketMode=0666
DirectoryMode=0755
Service=omamobile-gnss-nmea.service

[Install]
WantedBy=sockets.target
