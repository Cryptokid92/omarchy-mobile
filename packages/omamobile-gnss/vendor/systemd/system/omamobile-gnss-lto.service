# SPDX-License-Identifier: MIT
# Refreshes the GNSS long-term orbit file (lto2.dat) when it is older than
# LTO_MAX_AGE_HOURS and the phone has a non-cellular network route
# (/etc/omamobile/gnss.conf). A plain HTTP download, no identifiers. Started
# by omamobile-gnss-lto.timer, which "omamobile-gnss on" enables.
[Unit]
Description=Omarchy Mobile GNSS orbit predictions (LTO) download
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/lib/omamobile-vendor/gnss/root

[Service]
Type=oneshot
ExecStart=/usr/lib/omamobile-vendor/omamobile-gnss-lto --timeout 60
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=-/var/lib/omamobile-vendor/gnss
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
