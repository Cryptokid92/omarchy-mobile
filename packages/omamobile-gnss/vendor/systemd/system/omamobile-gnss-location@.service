# The Location switch for unprivileged callers (the shell's quick settings):
# systemctl start omamobile-gnss-location@on.service / @off.service runs
# "omamobile-gnss on|off" as root. Allowed for the active local user by
# /usr/share/polkit-1/rules.d/50-omamobile-gnss.rules.
[Unit]
Description=Omarchy Mobile Location %i

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-gnss %i
