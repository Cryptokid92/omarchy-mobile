# SPDX-License-Identifier: MIT
# Keeps GNSS running with no client ("omamobile-gnss force"), for tests and
# for gpsd users: holds the bridge (and so the stack) up and stops the
# bridge's idle exit while it is active.
[Unit]
Description=Omarchy Mobile GNSS, kept running
Wants=omamobile-gnss-nmea.service
After=omamobile-gnss-nmea.socket

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /run/omamobile-gnss && touch /run/omamobile-gnss/pinned'
ExecStop=/bin/rm -f /run/omamobile-gnss/pinned
