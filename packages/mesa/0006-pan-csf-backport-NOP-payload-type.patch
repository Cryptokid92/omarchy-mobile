+++ b/src/panfrost/genxml/v12.xml
@@ -695,7 +695,8 @@
   </struct>
 
   <struct name="CS NOP" size="2">
-    <field name="Ignored" size="56" start="0" type="hex"/>
+    <field name="Metadata payload" size="48" start="0" type="hex"/>
+    <field name="Metadata type" size="8" start="48" type="hex"/>
     <field name="Opcode" size="8" start="56" type="CS Opcode" default="NOP"/>
   </struct>
 
diff --git a/src/panfrost/genxml/v13.xml b/src/panfrost/genxml/v13.xml
index dadf36dbcafb..43b118d96717 100644
--- a/src/panfrost/genxml/v13.xml
+++ b/src/panfrost/genxml/v13.xml
@@ -738,7 +738,8 @@
   </struct>
 
   <struct name="CS NOP" size="2">
-    <field name="Ignored" size="56" start="0" type="hex"/>
+    <field name="Metadata payload" size="48" start="0" type="hex"/>
+    <field name="Metadata type" size="8" start="48" type="hex"/>
     <field name="Opcode" size="8" start="56" type="CS Opcode" default="NOP"/>
   </struct>
 
diff --git a/src/panfrost/genxml/v14.xml b/src/panfrost/genxml/v14.xml
index 6a370eb04a3e..856e8e1a6126 100644
--- a/src/panfrost/genxml/v14.xml
+++ b/src/panfrost/genxml/v14.xml
@@ -734,7 +734,8 @@
   </struct>
 
   <struct name="CS NOP" size="2">
-    <field name="Ignored" size="56" start="0" type="hex"/>
+    <field name="Metadata payload" size="48" start="0" type="hex"/>
+    <field name="Metadata type" size="8" start="48" type="hex"/>
     <field name="Opcode" size="8" start="56" type="CS Opcode" default="NOP"/>
   </struct>
 
