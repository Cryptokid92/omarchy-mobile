#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""One app per screen, as on Android: every launch from the phone shell.

  omamobile-launch app [--new] DESKTOP_ID   an app from its desktop entry
  omamobile-launch cmd -- ARGV...           a command (a terminal, the agent)
  omamobile-launch url URL                  a link, in the default browser
  omamobile-launch empty                    go to an empty workspace first
  omamobile-launch show-with ADDR TARGET    window ADDR joins TARGET's screen
  omamobile-launch own-screen ADDR          window ADDR gets a screen again
  omamobile-launch match DESKTOP_ID         print the window `app` would focus

A launch runs through Hyprland's exec with a per-launch rule, so only the
windows of the process it starts land on a new empty workspace; the app's
own dialogs follow it there, and nothing else is moved. Hyprland 0.56 tracks
the process by an HL_EXEC_RULE_TOKEN in its environment, which survives
uwsm-app's scope and gtk-launch's exec. The Lua form is
hl.exec_cmd(cmd, { workspace = "empty" }), sent with `hyprctl eval`.

An app with a window already open is focused on its own workspace instead
of being started again (a single-instance app would otherwise put a second
window next to the one the user is looking at). Terminals, and `--new`,
always start a new one. Apps that bypass the token (D-Bus activated ones,
or a running instance that opens the window itself) still land on a new
screen: a launch from a screen that holds windows first switches to an
empty workspace, and the window maps there.

The window actions are the recent-apps switcher's: `show-with` moves a
window onto another app's workspace, where the two tile; `own-screen` moves
it to a new empty workspace. ADDR is Hyprland's window address, with or
without 0x. Everything is best effort: without Hyprland an app is started
directly.
"""
import json
import os
import re
import shlex
import subprocess
import sys

HYPRCTL = os.environ.get("OMAMOBILE_HYPRCTL", "hyprctl")
# The launch rule: windows of the started process open on a new empty workspace.
RULES = '{ workspace = "empty" }'
# Never focused in place of a launch.
SKIP_CLASSES = {"org.omarchy.screensaver"}
# Launchers in a desktop entry's Exec that say nothing about the window class.
WRAPPERS = {"env", "sh", "bash", "setsid", "nohup", "uwsm-app", "uwsm", "systemd-run", "gtk-launch",
            "python", "python3", "flatpak", "xdg-terminal-exec", "omarchy-launch-tui",
            "omarchy-launch-or-focus", "omarchy-launch-or-focus-tui", "omarchy-launch-webapp"}
# Last parts of reverse-DNS ids too generic to stand for an app's window class.
GENERIC = {"desktop", "app", "application", "client", "gui", "main", "launcher"}


def warn(message):
    print("omamobile-launch: " + message, file=sys.stderr)


# ---------------------------------------------------------------- Hyprland


def hyprctl(*args):
    """(ok, output) of one hyprctl call."""
    try:
        proc = subprocess.run([HYPRCTL] + list(args), capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as error:
        return False, str(error)
    out = (proc.stdout or "").strip()
    # hyprctl answers "ok" when a request worked, and exits non-zero with the
    # error otherwise. Anything else on success (an eval's value) still counts:
    # a false failure would start the app a second time.
    ok = proc.returncode == 0 and "error" not in out.lower()
    return ok, out


def query(what):
    """hyprctl -j WHAT as JSON, or None."""
    try:
        proc = subprocess.run([HYPRCTL, "-j", what], capture_output=True, text=True, timeout=5)
        if proc.returncode != 0:
            return None
        return json.loads(proc.stdout or "null")
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None


def dispatch(lua):
    ok, out = hyprctl("dispatch", lua)
    if not ok:
        warn("dispatch %s failed: %s" % (lua, out))
    return ok


def lua_string(text):
    """A Lua long-bracket string literal holding text verbatim."""
    text = str(text)
    level = 0
    while ("]" + "=" * level + "]") in text or text.endswith("]" + "=" * level):
        level += 1
    # A long string drops a newline right after the opening bracket.
    lead = "\n" if text.startswith("\n") else ""
    return "[" + "=" * level + "[" + lead + text + "]" + "=" * level + "]"


def exec_lua(command):
    return "hl.exec_cmd(%s, %s)" % (lua_string(command), RULES)


def norm_address(value):
    text = str(value or "").strip().lower()
    if text.startswith("address:"):
        text = text[len("address:"):]
    if text.startswith("0x"):
        text = text[2:]
    if not re.fullmatch(r"[0-9a-f]{1,16}", text):
        return None
    return "0x" + text


def focus_window(address):
    return dispatch('hl.dsp.focus({ window = "address:%s" })' % address)


def focus_empty():
    return dispatch('hl.dsp.focus({ workspace = "empty" })')


def set_state(internal):
    """The focused window's fullscreen state: 0 tiled, 1 maximized (the phone's default)."""
    return dispatch("hl.dsp.window.fullscreen_state({ internal = %d, client = 0 })" % internal)


def workspace_selector(workspace):
    wid = workspace.get("id") if isinstance(workspace, dict) else None
    if isinstance(wid, int) and wid > 0:
        return str(wid)
    return str((workspace or {}).get("name") or "")


# ---------------------------------------------------------------- starting things


def spawn(argv):
    """Start argv detached, without Hyprland (the fallback)."""
    try:
        subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError as error:
        warn("could not start %s: %s" % (argv[0], error))
        return False


def ensure_empty_screen():
    """Switch to an empty workspace when the current one holds windows, so a
    window that escapes the launch rule still gets a screen of its own."""
    active = query("activeworkspace")
    if isinstance(active, dict) and int(active.get("windows") or 0) > 0:
        focus_empty()


def shell_command(argv):
    """argv for Hyprland's exec (sh -c), run as if from here: Hyprland's own
    directory and PATH aren't the caller's (a login shell's ~/.local/bin, a
    widget's folder)."""
    parts = []
    try:
        parts.append("cd -- %s 2>/dev/null;" % shlex.quote(os.getcwd()))
    except OSError:
        pass
    parts.append("exec env -- %s %s" % (shlex.quote("PATH=" + os.environ.get("PATH", "/usr/bin:/bin")),
                                         shlex.join(argv)))
    return " ".join(parts)


def launch(argv):
    """argv on a new empty workspace, through Hyprland's exec with the rule."""
    ensure_empty_screen()
    ok, out = hyprctl("eval", exec_lua(shell_command(argv)))
    if ok:
        return True
    warn("Hyprland exec failed (%s); starting %s directly" % (out, argv[0]))
    return spawn(argv)


# ---------------------------------------------------------------- desktop entries


def application_dirs():
    home = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local/share")
    dirs = [home] + [d for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
    return [os.path.join(d, "applications") for d in dirs]


def desktop_id(value):
    """A file name's desktop id (chromium.desktop -> chromium)."""
    text = str(value or "").strip()
    return text[:-8] if text.endswith(".desktop") else text


def app_id_arg(value):
    """The id as given (Quickshell's DesktopEntry.id), which may itself end in
    .desktop (org.telegram.desktop); a file name is taken too."""
    text = str(value or "").strip()
    if text.endswith(".desktop") and not find_desktop_file(text) and find_desktop_file(text[:-8]):
        return text[:-8]
    return text


def find_desktop_file(app_id):
    """The entry's file: <dir>/<id>.desktop, or a subdirectory for an id with
    dashes (the spec's vendor-app.desktop for vendor/app.desktop)."""
    app_id = str(app_id or "").strip()
    if not app_id or "/" in app_id or app_id.startswith("."):
        return None
    names = [app_id + ".desktop"]
    parts = app_id.split("-")
    for i in range(1, len(parts)):
        names.append("-".join(parts[:i]) + "/" + "-".join(parts[i:]) + ".desktop")
    for directory in application_dirs():
        for name in names:
            path = os.path.join(directory, name)
            if os.path.isfile(path):
                return path
    return None


def read_entry(path):
    """The [Desktop Entry] group's unlocalised keys."""
    entry = {}
    group = None
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for raw in handle:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("["):
                    group = line
                    continue
                if group != "[Desktop Entry]" or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                if "[" not in key and key not in entry:
                    entry[key] = value.strip()
    except OSError:
        pass
    return entry


def exec_words(exec_line):
    """Exec's words, field codes dropped."""
    try:
        words = shlex.split(exec_line or "")
    except ValueError:
        words = (exec_line or "").split()
    return [w for w in words if not re.fullmatch(r"%[a-zA-Z%]", w)]


def is_terminal(entry):
    categories = [c for c in (entry.get("Categories") or "").split(";") if c]
    return "TerminalEmulator" in categories or (entry.get("Terminal") or "").lower() == "true"


def matchers(app_id, entry):
    """(window classes, web-app host) that mean this app is already open."""
    classes = set()
    host = None
    if entry.get("StartupWMClass"):
        classes.add(entry["StartupWMClass"])
    classes.add(app_id)
    if "." in app_id:
        last = app_id.rsplit(".", 1)[1]
        if len(last) > 2 and last.lower() not in GENERIC:
            classes.add(last)
    words = exec_words(entry.get("Exec"))
    while words and (words[0] == "env" or re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", words[0])):
        words = words[1:]
    if words:
        program = os.path.basename(words[0])
        if program == "omarchy-launch-webapp" and len(words) > 1:
            match = re.match(r"^[a-z]+://([^/:?#]+)", words[1], re.I)
            host = match.group(1) if match else None
        elif program in ("xdg-terminal-exec", "omarchy-launch-tui", "omarchy-launch-or-focus-tui"):
            for word in words[1:]:
                # TUI.float and TUI.tile are shared by many entries: no match.
                if word.startswith("--app-id=") and not word[9:].startswith("TUI."):
                    classes.add(word[9:])
        elif program == "flatpak" and "run" in words:
            rest = [w for w in words[words.index("run") + 1:] if not w.startswith("-")]
            if rest:
                classes.add(rest[0])
        elif program not in WRAPPERS:
            classes.add(program)
    return {c.lower() for c in classes if c}, (host.lower() if host else None)


def window_matches(client, classes, host):
    cls = str(client.get("class") or "").lower()
    initial = str(client.get("initialClass") or "").lower()
    if not cls and not initial:
        return False
    if cls in SKIP_CLASSES or initial in SKIP_CLASSES:
        return False
    if host:
        # Chromium-family --app windows: <browser>-<host>_<path>-<profile>.
        pattern = "-" + re.escape(host) + "_"
        return bool(re.search(pattern, cls) or re.search(pattern, initial))
    return cls in classes or initial in classes


def find_window(clients, classes, host):
    """The most recently focused open window matching, or None."""
    found = [c for c in (clients or []) if isinstance(c, dict) and c.get("mapped", True)
             and window_matches(c, classes, host)]
    if not found:
        return None
    def recency(client):
        order = client.get("focusHistoryID")
        return order if isinstance(order, int) and order >= 0 else 1 << 30
    return min(found, key=recency)


def window_for_app(app_id, clients=None):
    """(the open window to focus instead of launching, or None, entry)."""
    path = find_desktop_file(app_id)
    entry = read_entry(path) if path else {}
    if is_terminal(entry):
        return None, entry
    classes, host = matchers(app_id, entry)
    if clients is None:
        clients = query("clients")
    return find_window(clients, classes, host), entry


# ---------------------------------------------------------------- commands


def cmd_app(args):
    new = False
    if args and args[0] == "--new":
        new, args = True, args[1:]
    if len(args) != 1 or not app_id_arg(args[0]):
        return usage()
    app_id = app_id_arg(args[0])
    if not new:
        window, _entry = window_for_app(app_id)
        if window and norm_address(window.get("address")):
            if focus_window(norm_address(window["address"])):
                return 0
    # Omarchy's own launch path (AppLibrary.launch): gtk-launch resolves the
    # entry, in a scope under app-graphical.slice. The suffix keeps ids such
    # as org.telegram.desktop resolving.
    return 0 if launch(["uwsm-app", "--", "gtk-launch", app_id + ".desktop"]) else 1


def cmd_cmd(args):
    if args and args[0] == "--":
        args = args[1:]
    if not args:
        return usage()
    return 0 if launch(args) else 1


def default_browser():
    for argv in (["xdg-settings", "get", "default-web-browser"],
                 ["xdg-mime", "query", "default", "x-scheme-handler/https"]):
        try:
            out = subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            out = ""
        if out:
            return desktop_id(out.splitlines()[0])
    return ""


def cmd_url(args):
    if len(args) != 1 or not args[0].strip():
        return usage()
    url = args[0].strip()
    if re.match(r"^https?://", url, re.I):
        # A running browser opens the link in its last-used window: show
        # that window, then hand it the link.
        browser = default_browser()
        if browser:
            window, _entry = window_for_app(browser)
            if window and norm_address(window.get("address")) and focus_window(norm_address(window["address"])):
                return 0 if spawn(["xdg-open", url]) else 1
    return 0 if launch(["xdg-open", url]) else 1


def clients_by_address():
    clients = query("clients") or []
    return {norm_address(c.get("address")): c for c in clients if isinstance(c, dict) and norm_address(c.get("address"))}


def same_workspace(clients, workspace_id, skip=None):
    return [a for a, c in clients.items() if a != skip and (c.get("workspace") or {}).get("id") == workspace_id
            and c.get("mapped", True)]


def cmd_show_with(args):
    if len(args) != 2:
        return usage()
    address, target = norm_address(args[0]), norm_address(args[1])
    if not address or not target:
        warn("not a window address")
        return 2
    clients = clients_by_address()
    if address not in clients or target not in clients:
        warn("no such window")
        return 1
    workspace = clients[target].get("workspace") or {}
    selector = workspace_selector(workspace)
    if not selector:
        return 1
    if (clients[address].get("workspace") or {}).get("id") != workspace.get("id"):
        if not dispatch('hl.dsp.window.move({ window = "address:%s", workspace = %s })' % (address, lua_string(selector))):
            return 1
    # Every window here is maximized (hypr/phone.lua), so one would cover the
    # other: tile them all, as Omarchy does on a computer.
    for other in [target] + same_workspace(clients, workspace.get("id"), skip=target):
        if other != address and focus_window(other):
            set_state(0)
    if focus_window(address):
        set_state(0)
    return 0


def cmd_own_screen(args):
    if len(args) != 1:
        return usage()
    address = norm_address(args[0])
    if not address:
        warn("not a window address")
        return 2
    clients = clients_by_address()
    if address not in clients:
        warn("no such window")
        return 1
    others = same_workspace(clients, (clients[address].get("workspace") or {}).get("id"), skip=address)
    if not others:
        # Already alone on its screen.
        return 0 if focus_window(address) else 1
    # One window left behind fills its screen again; do it before the move,
    # so the screen doesn't switch back and forth.
    if len(others) == 1 and focus_window(others[0]):
        set_state(1)
    if not dispatch('hl.dsp.window.move({ window = "address:%s", workspace = "empty" })' % address):
        return 1
    if focus_window(address):
        set_state(1)
    return 0


def cmd_empty(args):
    if args:
        return usage()
    ensure_empty_screen()
    return 0


def cmd_match(args):
    if len(args) != 1:
        return usage()
    window, _entry = window_for_app(app_id_arg(args[0]))
    if not window:
        return 1
    print("%s %s" % (norm_address(window.get("address")), window.get("class", "")))
    return 0


def usage():
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


COMMANDS = {"app": cmd_app, "cmd": cmd_cmd, "url": cmd_url, "empty": cmd_empty, "show-with": cmd_show_with,
            "own-screen": cmd_own_screen, "match": cmd_match}


def main(argv):
    if len(argv) < 2 or argv[1] not in COMMANDS:
        return usage()
    return COMMANDS[argv[1]](argv[2:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
