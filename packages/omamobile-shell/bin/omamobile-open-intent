"""Swallow Android intent:// links.

Mobile sites (Google Maps among them) hand off to their Android app with
intent:// links, often by themselves on page load. With no handler, Chromium
passed them to the desktop's "Open With" dialog, which found no app and
offered Software. Android's Chrome, with the app missing, loads the link's
fallback in the same tab; a handler outside the browser can only open a new
window, which duplicated the page the user was already on. So do nothing:
the site stays as it is, as on a desktop.
"""
import sys


def main(argv):
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
