#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Omarchy Mobile's fingerprint enrollment helper, for the omamobile.fingerprint
shell plugin. It drives fprintd over D-Bus, as the user, so fprintd stays
the only client of the sensor (omamobile-fp-bridge serves one client at a
time; the lock screen and sudo reach it through fprintd too). fprintd asks
polkit before it lets a user enroll.

    omamobile-fp-enroll list          one "fingers" event, then exit
    omamobile-fp-enroll enroll        enroll the next free finger
    omamobile-fp-enroll delete-all    delete this user's fingerprints

JSON lines:

  stdout  {"event": "fingers", "fingers": [...], "stages": N, "device": name}
          {"event": "claimed"}      (polkit, if it asked, has been answered)
          {"event": "started", "finger": "right-index-finger"}
          {"event": "status", "result": "enroll-stage-passed", "done": false}
          {"event": "done", "ok": true|false, "result": "enroll-completed"}
          {"event": "deleted"}
          {"event": "error", "kind": "busy|denied|no-device|no-space|failed",
           "message": "..."}
  stdin   {"cmd": "cancel"}       (closing stdin cancels too)

The finer detail Android shows (the HAL's acquired hints and the steps left)
is not in fprintd's vocabulary: the plugin reads it from the bridge's state
file, /run/omamobile-fp-ui/state.json.
"""

import json
import os
import signal
import sys

FPRINTD = "net.reactivated.Fprint"
MANAGER_PATH = "/net/reactivated/Fprint/Manager"
MANAGER_IFACE = "net.reactivated.Fprint.Manager"
DEVICE_IFACE = "net.reactivated.Fprint.Device"
PROPS_IFACE = "org.freedesktop.DBus.Properties"

# The order Android-like setups offer fingers in: the ones a phone is held
# with first.
FINGERS = (
    "right-index-finger", "left-index-finger", "right-thumb", "left-thumb",
    "right-middle-finger", "left-middle-finger", "right-ring-finger",
    "left-ring-finger", "right-little-finger", "left-little-finger",
)

# fprintd's EnrollStatus results that end the enrollment.
FINAL = {
    "enroll-completed": True,
    "enroll-failed": False,
    "enroll-data-full": False,
    "enroll-disconnected": False,
    "enroll-unknown-error": False,
    "enroll-duplicate": False,
}


# ---------------------------------------------------------------- pure helpers

def next_finger(enrolled):
    """The first finger in FINGERS that is not enrolled yet, or None."""
    taken = set(enrolled or ())
    for finger in FINGERS:
        if finger not in taken:
            return finger
    return None


def parse_command(line):
    """One stdin line -> a command dict, or None."""
    try:
        value = json.loads(line)
    except (ValueError, TypeError):
        return None
    if not isinstance(value, dict) or not isinstance(value.get("cmd"), str):
        return None
    return value


def error_kind(name):
    """A fprintd D-Bus error name -> the kind the plugin words."""
    name = str(name or "")
    if name.endswith(".AlreadyInUse") or name.endswith(".ClaimDevice"):
        return "busy"
    if name.endswith(".PermissionDenied") or "NotAuthorized" in name:
        return "denied"
    if name.endswith(".NoSuchDevice") or name.endswith(".ServiceUnknown"):
        return "no-device"
    return "failed"


def final_status(result):
    """(done, ok) for an EnrollStatus result."""
    if result in FINAL:
        return True, FINAL[result]
    return False, False


def emit(event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


# ---------------------------------------------------------------- D-Bus side

def main(argv):
    mode = argv[0] if argv else "enroll"
    if mode not in ("list", "enroll", "delete-all"):
        sys.stderr.write(__doc__)
        return 2

    # A parent may start us with SIGTERM blocked or ignored; Cancel and the
    # shell rely on it.
    signal.pthread_sigmask(signal.SIG_UNBLOCK, {signal.SIGTERM, signal.SIGINT})
    signal.signal(signal.SIGTERM, signal.SIG_DFL)

    import dbus
    import dbus.mainloop.glib
    from gi.repository import GLib

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    loop = GLib.MainLoop()
    state = {"claimed": False, "enrolling": False, "finished": False, "code": 0}

    def fail(error, fallback="failed"):
        name = error.get_dbus_name() if isinstance(error, dbus.DBusException) else ""
        kind = error_kind(name) if name else fallback
        emit({"event": "error", "kind": kind, "message": str(error)})
        state["code"] = 1

    try:
        manager = dbus.Interface(bus.get_object(FPRINTD, MANAGER_PATH), MANAGER_IFACE)
        path = manager.GetDefaultDevice()
    except dbus.DBusException as error:
        fail(error, "no-device")
        return 1
    obj = bus.get_object(FPRINTD, path)
    device = dbus.Interface(obj, DEVICE_IFACE)
    props = dbus.Interface(obj, PROPS_IFACE)

    def enrolled():
        try:
            return [str(f) for f in device.ListEnrolledFingers("")]
        except dbus.DBusException as error:
            if error.get_dbus_name().endswith(".NoEnrolledPrints"):
                return []
            raise

    def fingers_event():
        try:
            stages = int(props.Get(DEVICE_IFACE, "num-enroll-stages"))
            name = str(props.Get(DEVICE_IFACE, "name"))
        except dbus.DBusException:
            stages, name = 0, ""
        return {"event": "fingers", "fingers": enrolled(), "stages": stages, "device": name}

    if mode == "list":
        try:
            emit(fingers_event())
        except dbus.DBusException as error:
            fail(error)
        return state["code"]

    def release():
        if state["enrolling"]:
            state["enrolling"] = False
            try:
                device.EnrollStop()
            except dbus.DBusException:
                pass
        if state["claimed"]:
            state["claimed"] = False
            try:
                device.Release()
            except dbus.DBusException:
                pass

    # Claim asks polkit (fprintd's enroll and delete actions) and can wait
    # minutes for the user to answer the prompt, so everything from here runs
    # asynchronously in the main loop: a cancel (stdin, SIGTERM, SIGINT) is
    # heard at any point, also while polkit is still asking.
    def finish(code):
        state["code"] = code
        loop.quit()
        return False

    def cancel():
        if not state["finished"]:
            emit({"event": "done", "ok": False, "result": "canceled"})
        state["finished"] = True
        return finish(1)

    def failed(error):
        if state["finished"]:
            return
        state["finished"] = True
        fail(error)
        finish(1)

    def on_status(result, done):
        result = str(result)
        final, ok = final_status(result)
        emit({"event": "status", "result": result, "done": bool(done)})
        if final or done:
            state["enrolling"] = False
            state["finished"] = True
            emit({"event": "done", "ok": ok, "result": result})
            finish(0 if ok else 1)

    def started(finger):
        state["enrolling"] = True
        emit({"event": "started", "finger": finger})

    def claimed():
        state["claimed"] = True
        if state["finished"]:      # canceled while polkit was asking
            loop.quit()
            return
        emit({"event": "claimed"})
        if mode == "delete-all":
            def deleted():
                state["finished"] = True
                emit({"event": "deleted"})
                finish(0)
            device.DeleteEnrolledFingers2(reply_handler=deleted, error_handler=failed, timeout=60)
            return
        try:
            listing = fingers_event()
        except dbus.DBusException as error:
            failed(error)
            return
        emit(listing)
        finger = next_finger(listing["fingers"])
        if not finger:
            state["finished"] = True
            emit({"event": "error", "kind": "no-space", "message": "Every finger is enrolled"})
            finish(1)
            return
        bus.add_signal_receiver(on_status, signal_name="EnrollStatus",
                                dbus_interface=DEVICE_IFACE, path=path)
        device.EnrollStart(finger, reply_handler=lambda: started(finger),
                           error_handler=failed, timeout=300)

    buffer = [b""]

    def on_stdin(fd, condition):
        data = os.read(fd, 4096) if condition & GLib.IO_IN else b""
        if not data:
            cancel()
            return False
        buffer[0] += data
        while b"\n" in buffer[0]:
            line, buffer[0] = buffer[0].split(b"\n", 1)
            command = parse_command(line.decode("utf-8", "replace"))
            if command and command.get("cmd") == "cancel":
                cancel()
        return True

    GLib.io_add_watch(sys.stdin.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, on_stdin)
    try:
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except ImportError:
        signal_add = GLib.unix_signal_add
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, cancel)
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, cancel)

    device.Claim("", reply_handler=claimed, error_handler=failed, timeout=300)
    try:
        loop.run()
    finally:
        release()
    return state["code"]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
