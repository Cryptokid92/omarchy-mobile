// Our own probe of text functions and interpolation (expected output recorded from the reference runtime).
widget "probe text" {
  meta { owl: 7 }
  source t = cmd("x")
  source j = cmd("x") json
  state name = "it's me"
  Column {
    for e, i in [
      t, "${t}", lines(t), words(t), len(t), trim(t), upper("straße"), lower("ÄÖ"), split("a-b--c", "-"), split("", ","), join(["a", 1, null, true], "+"),
      replace("banana", "an", "_"), replace("", "", "x"), sub("widget", 2), sub("widget", -3, -1), sub("widget", 9), pad("7", 3, "0"), pad(42, -5, "."), pad("toolong", 3),
      contains("hello", ""), contains(["a", 1], "1"), contains({k: 1}, "k"), startsWith(null, ""), endsWith("abc", ""), sh(name), sh(""), sh([1, 2]), sh(j.a),
      "a" + null, null + "b", "${null}", "${[null, "x"]}", "${{a: null}}", "x${1/3}y", "${0.1 + 0.2}", "${100000000}", "${-0}", '${raw}', """
        two
          lines
      """,
      match("abc123def45", "[0-9]+"), match("key=val", "(\\w+)=(\\w+)"), match("none", "z(x)?"), matchAll("a1b2c3", "[a-z][0-9]"), matchAll("", "x*"),
      parseJson("[1, {\"b\": 2, \"a\": 1}]"), parseJson(" 12 "), parseJson("{bad"), str(j.list), str(j), j["10"], j[2], j.list[-1], j.list.length, j.a["b"].c,
      fmtTime(now, "EEEE d MMMM yyyy"), fmtTime(now, "HH:mm:ss"), fmtTime(now, "hh:mm a"), fmtTime(now, "e EEE ee"), fmtTime(now, "D DDD"), fmtTime(now, "xx"), fmtTime(now, "'quoted' ''"), fmtTime(now, "Q yy M MM MMM"), fmtTime(now + 86400 * 100, "EEEEE k K")
    ] {
      Text { text: "${i}: ${e}" }
    }
  }
}
