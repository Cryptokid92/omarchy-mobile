// Our own probe of node properties, components, if/for and Canvas calls.
widget "probe nodes" {
  meta { owl: 7 }
  size: 4x3
  minSize: 2x2
  padding: 8
  source items = cmd("x") json
  state count = 2 persist
  let h = history(count, 3)
  let p = prev(count)
  component Stat(label, value, tint = accent) {
    Column { gap: 0
      Text { text: label; style: label }
      Text { text: value; style: title; color: tint }
    }
  }
  Column {
    gap: 6; align: center; justify: spaceEvenly; fill: true
    Row { wrap: true; gap: 3
      Stat { label: "cpu"; value: "${count}%"; weight: 1 }
      Stat { label: "mem"; value: h; tint: red }
    }
    if count > 1 { Text { text: "big"; maxLines: 2; font: icon; italic: true; bold: count } } else { Spacer { size: 4 } }
    for it, i in items key it.id { Button { text: "${i}:${it.id}"; color: it.tag == "x" ? green : muted; onTap: count = count + it.n } }
    Grid { columns: 3; gap: 2
      for k in range(5) { Box { size: 10; radius: 2; border: 1; borderColor: k % 2 == 0 ? accent : border; background: transparent } }
    }
    Ring { value: 0.25; start: 225; sweep: 270; thickness: 4; size: 40 }
    Sparkline { values: [1, 3, 2, null, 5]; area: true; min: 0; thickness: 1.5 }
    Sparkline { values: h; area: green; height: 20 }
    Slider { value: count; max: 10; step: 1; onChange: count = value }
    Image { src: "~/pics/a.png"; fit: cover; tint: accent; width: 30; height: 30 }
    Shader { fallback: surface; uniforms: { tint: accent, speed: 0.5, at: [1, 2] }; code: "half4 main(float2 p) { return half4(1); }" }
    Text { text: "${p} ${tileWidth} ${cols} ${linux} ${corners} ${screenWidth ?? 0}"; padding: [4, 2]; offset: [1, -1]; opacity: 0.7; rotation: 5; scale: 1.1; visible: true; clip: true }
    Canvas {
      height: 60
      let r = min(width, height) / 2
      rect(0, 0, width, height, radius: 4, fill: surface)
      circle(width / 2, height / 2, r, stroke: border, width: 2)
      arc(width / 2, height / 2, r - 4, 45, 270, fill: alpha(accent, 0.5))
      line(0, 0, width, height, color: red, cap: square)
      path([[0, 0], {x: 5, y: 9}, "bad"], closed: true, fill: linear(0, 0, 10, 0, [red, blue]))
      text("hi ${count}", 4, 8, size: 9, align: start, bold: true, color: muted)
      image("~/x.png", 1, 2, 3, 4)
      translate(3, 4) { scale(2, 2, 0, 0) { rect(0, 0, 1, 1) } }
      clip(0, 0, 10, 10) { layer(0.5) { rotate(30) { circle(1, 1, 1) } } }
      sprite(["ab.", ".bb"], 2, 2, 3, palette: {a: accent, b: "#ff0000"})
      sprite("""
        xx
        x.
      """, 10, 10, 2, fill: green)
      for i in range(3) { if i != 1 { rect(i * 5, 50, 4, 4) } }
    }
  }
  screen {
    title: "details ${count}"
    Column { scroll: true; Text { text: "screen"; style: huge } Input { text: ""; placeholder: "type"; focus: true; clear: true; onSubmit: count = num(value, 0) } }
  }
}
