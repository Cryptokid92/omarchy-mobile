+void IPASoftSimple::updateWindow(const ControlList &controls)
+{
+	auto &window = context_.activeState.window;
+	const Size &area = context_.sensorInfo.activeAreaSize;
+
+	if (const auto metering = controls.get(controls::AfMetering))
+		window.afMetering = *metering;
+	/*
+	 * AfWindows is an array, but take a single rectangle too (cam's
+	 * capture scripts send one so): getting it as an array would assert.
+	 */
+	std::optional<Rectangle> first;
+	if (controls.contains(controls::AfWindows.id())) {
+		const ControlValue &value = controls.get(controls::AfWindows.id());
+		if (value.type() == ControlTypeRectangle) {
+			if (value.isArray()) {
+				const auto windows = value.get<Span<const Rectangle>>();
+				if (!windows.empty())
+					first = windows[0];
+			} else {
+				first = value.get<Rectangle>();
+			}
+		}
+	}
+
+	std::array<float, 4> rect = kDefaultWindow;
+	if (window.afMetering == controls::AfMeteringWindows && !area.isNull()) {
+		/* Keep the last window until the application sends another. */
+		if (!first || first->isNull())
+			return;
+
+		/* One window: the first. */
+		const Rectangle &r = *first;
+		float cx = (r.x + r.width / 2.0f) / area.width;
+		float cy = (r.y + r.height / 2.0f) / area.height;
+		const float w = std::clamp(static_cast<float>(r.width) / area.width,
+					   kMinWindow, 1.0f);
+		const float h = std::clamp(static_cast<float>(r.height) / area.height,
+					   kMinWindow, 1.0f);
+		cx = std::clamp(cx, w / 2, 1.0f - w / 2);
+		cy = std::clamp(cy, h / 2, 1.0f - h / 2);
+		rect = { cx - w / 2, cy - h / 2, w, h };
+	}
+
+	if (rect != window.rect) {
+		window.rect = rect;
+		window.generation++;
+		LOG(IPASoft, Debug)
+			<< "Focus and metering window " << rect[0] << "," << rect[1]
+			<< " " << rect[2] << "x" << rect[3];
+	}
+}
