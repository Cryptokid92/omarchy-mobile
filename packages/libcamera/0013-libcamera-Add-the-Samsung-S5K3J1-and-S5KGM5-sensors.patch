+class CameraSensorHelperS5k3j1 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k3j1()
+	{
+		/* 64 at 10 bits. */
+		blackLevel_ = 4096;
+		/* Code / 32: 0x20 is 1x, 0x200 is 16x. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k3j1", CameraSensorHelperS5k3j1)
+
