--- /dev/null
+++ b/src/ipa/simple/data/s5k3j1.yaml
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: CC0-1.0
+#
+# Samsung S5K3J1 (the Pixel 7 Pro's front camera), not calibrated yet. The
+# black level comes from the sensor's helper. Fixed focus: no Af.
+#
+# The colour matrix is the identity until a calibration, so the saturation
+# default applies.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  - Ccm:
+      ccms:
+        - ct: 5000
+          ccm: [ 1, 0, 0,
+                 0, 1, 0,
+                 0, 0, 1 ]
+  # Defaults for applications that do not set the controls.
+  - Adjust:
+      contrast: 1.2
+      saturation: 1.1
+  - Agc:
+...
diff --git a/src/ipa/simple/data/s5kgm5.yaml b/src/ipa/simple/data/s5kgm5.yaml
new file mode 100644
index 0000000..35ccf44
--- /dev/null
+++ b/src/ipa/simple/data/s5kgm5.yaml
@@ -0,0 +1,33 @@
+# SPDX-License-Identifier: CC0-1.0
+#
+# Samsung S5KGM5 (the Pixel 7 Pro's 5x telephoto), not calibrated yet. The
+# black level comes from the sensor's helper.
+#
+# The colour matrix is the identity until a calibration, so the saturation
+# default applies.
+#
+# Autofocus scans the SEM1215SA lens's range (the module's calibrated span,
+# set by the kernel driver) in 8 coarse steps, then around the sharpest one
+# in steps of 1/32 of the range: a long focal length gives a shallow depth
+# of field.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  - Ccm:
+      ccms:
+        - ct: 5000
+          ccm: [ 1, 0, 0,
+                 0, 1, 0,
+                 0, 0, 1 ]
+  # Defaults for applications that do not set the controls.
+  - Adjust:
+      contrast: 1.2
+      saturation: 1.1
+  - Agc:
+  - Af:
+      coarseSteps: 8
+      fineSteps: 32
+...
