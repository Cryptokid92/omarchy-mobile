+++ b/src/ipa/simple/algorithms/look.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Hue, vibrance and tone curve for the simple software ISP
+ */
+
+#pragma once
+
+#include <array>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Look : public Algorithm
+{
+public:
+	Look() = default;
+	~Look() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	std::array<float, 12> hueShift_ = {};
+	std::array<float, 12> vibrance_ = {};
+	float vibranceLimit_ = 1.0f;
+	float toneLift_ = 0.0f;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
