+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Hue, vibrance and tone curve for the simple software ISP
+ */
+
+#include "look.h"
+
+#include <cmath>
+#include <vector>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/software_isp/debayer_params.h"
+
+#include "simple/ipa_context.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftLook)
+
+namespace ipa::soft::algorithms {
+
+/**
+ * \class Look
+ * \brief The picture's look: hues, vibrance and a shadow lift
+ *
+ * The GPU debayer shifts the hue and raises the chroma of 12 hue sectors in
+ * linear opponent space after the colour matrix, and lifts the shadows after
+ * the highlight shoulder (see bayer_*.frag). The tuning file gives, for the
+ * sectors centred on 0, 30, ..., 330 degrees of atan2(R - Y, B - Y) (blue is
+ * near 0, green near 210, red near 100), the hue shifts in degrees and the
+ * vibrances, the chroma at which vibrance falls to none, and the lift:
+ *
+ *   - Look:
+ *       hueShift: [ 12 degrees ]
+ *       vibrance: [ 12 gains ]
+ *       vibranceLimit: 1.0
+ *       toneLift: 0.45
+ *
+ * The AGC predicts the output through the lift (Agc::encode()).
+ */
+
+int Look::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	const auto shift = tuningData["hueShift"].get<std::vector<float>>();
+	const auto vib = tuningData["vibrance"].get<std::vector<float>>();
+	if ((shift && shift->size() != 12) || (vib && vib->size() != 12)) {
+		LOG(IPASoftLook, Error) << "hueShift and vibrance take 12 values";
+		return -EINVAL;
+	}
+
+	for (unsigned int i = 0; i < 12; i++) {
+		if (shift)
+			hueShift_[i] = (*shift)[i] * static_cast<float>(M_PI) / 180.0f;
+		if (vib)
+			vibrance_[i] = std::max((*vib)[i], 0.0f);
+	}
+	vibranceLimit_ = std::max(tuningData["vibranceLimit"].get<float>().value_or(1.0f), 0.05f);
+	toneLift_ = std::max(tuningData["toneLift"].get<float>().value_or(0.0f), 0.0f);
+
+	return 0;
+}
+
+int Look::configure(IPAContext &context,
+		    [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	context.activeState.knobs.toneLift = toneLift_;
+
+	return 0;
+}
+
+void Look::prepare([[maybe_unused]] IPAContext &context,
+		   [[maybe_unused]] const uint32_t frame,
+		   [[maybe_unused]] IPAFrameContext &frameContext,
+		   DebayerParams *params)
+{
+	params->hueShift = hueShift_;
+	params->vibrance = vibrance_;
+	params->vibranceLimit = vibranceLimit_;
+	params->toneLift = toneLift_;
+}
+
+REGISTER_IPA_ALGORITHM(Look, "Look")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
