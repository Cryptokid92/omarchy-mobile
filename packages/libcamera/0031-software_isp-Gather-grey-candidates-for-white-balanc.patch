From 84afdf93720fd1d86b08114ad18fecdb4829de13 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Wed, 14 Oct 2026 20:53:15 -0400
Subject: [PATCH 31/32] software_isp: Gather grey candidates for white balance

The grey world estimate averages every sample, so a picture filled with
one colour, grass or sky, turns its opposite, and saturated highlights,
clipped in their brightest colour, pull it too.

Also sum the samples that may be grey: green above about 4% and every
colour below about 95% of full scale, and, with the black level taken
off and the white balance gains in use applied, red and blue within a
factor of 5/3 of green. The debayers pass the gains and black level
from their parameters. Iterated over frames, the estimate settles on
the near-grey surfaces.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../internal/software_isp/swisp_stats.h       | 10 +++++
 .../internal/software_isp/swstats_cpu.h       | 25 +++++++++++
 src/libcamera/software_isp/debayer_cpu.cpp    |  1 +
 src/libcamera/software_isp/debayer_egl.cpp    |  1 +
 src/libcamera/software_isp/swstats_cpu.cpp    | 44 ++++++++++++++++++-
 5 files changed, 80 insertions(+), 1 deletion(-)

diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index 23d9fce..70a4b04 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -31,6 +31,16 @@ struct SwIspStats {
 	 * \brief Sums of colour channels of all the sampled pixels
 	 */
 	RGB<uint64_t> sum_;
+	/**
+	 * \brief Sums of colour channels of the sampled pixels that may be
+	 * grey: neither dark nor saturated, and within a band around the
+	 * white point of the current white balance gains
+	 */
+	RGB<uint64_t> greySum_;
+	/**
+	 * \brief Number of samples in \a greySum_
+	 */
+	uint64_t greyCount;
 	/**
 	 * \brief Number of bins in the yHistogram
 	 */
diff --git a/include/libcamera/internal/software_isp/swstats_cpu.h b/include/libcamera/internal/software_isp/swstats_cpu.h
index e95cc3b..476f62c 100644
--- a/include/libcamera/internal/software_isp/swstats_cpu.h
+++ b/include/libcamera/internal/software_isp/swstats_cpu.h
@@ -62,6 +62,7 @@ public:
 	int configure(const StreamConfiguration &inputCfg, unsigned int statsBufferCount = 1);
 	void setWindow(const Rectangle &window);
 	void setFocusWindow(const std::array<float, 4> &window);
+	void setWhitePoint(const RGB<float> &gains, float blackLevel);
 	void startFrame(uint32_t frame);
 	void finishFrame(uint32_t frame, uint32_t bufferId);
 	void processFrame(uint32_t frame, uint32_t bufferId, MappedFrameBuffer &input);
@@ -113,6 +114,25 @@ private:
 
 	void processBayerFrame2(MappedFrameBuffer &in);
 
+	/*
+	 * A grey candidate: green above about 4% and every colour below about
+	 * 95% of full scale (8 bits times div), and red and blue under the
+	 * current gains within a factor of 5/3 of green.
+	 */
+	bool isGrey(int64_t r, int64_t g, int64_t b, int64_t div) const
+	{
+		const int64_t black = greyBlack_ * div;
+		const int64_t sat = 243 * div;
+		if (g - black < 10 * div || r >= sat || g >= sat || b >= sat)
+			return false;
+
+		const int64_t gw = (g - black) * 256;
+		const int64_t rw = (r - black) * greyGainR_;
+		const int64_t bw = (b - black) * greyGainB_;
+		return rw * 5 > gw * 3 && rw * 3 < gw * 5 &&
+		       bw * 5 > gw * 3 && bw * 3 < gw * 5;
+	}
+
 	/* Lines in the focus window, relative to the statistics window. */
 	bool isFocusLine(unsigned int y) const
 	{
@@ -134,6 +154,11 @@ private:
 	unsigned int focusLineEnd_;
 	std::array<float, 4> focusWindow_ = { 0.25f, 0.25f, 0.5f, 0.5f };
 
+	/* Grey candidates: gains x256 relative to green, levels in 8 bits */
+	int64_t greyGainR_ = 256;
+	int64_t greyGainB_ = 256;
+	int64_t greyBlack_ = 0;
+
 	Rectangle window_;
 
 	Size patternSize_;
diff --git a/src/libcamera/software_isp/debayer_cpu.cpp b/src/libcamera/software_isp/debayer_cpu.cpp
index f8f5699..f9ad5b0 100644
