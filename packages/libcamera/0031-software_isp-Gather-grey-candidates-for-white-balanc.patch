--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -780,6 +780,7 @@ void DebayerEGL::process(uint32_t frame, FrameBuffer *input, FrameBuffer *output
 			inMapped.emplace(input, MappedFrameBuffer::MapFlag::Read);
 		}
 		stats_->setFocusWindow(params.focusWindow);
+		stats_->setWhitePoint(params.gains, params.blackLevel[1]);
 		stats_->processFrame(frame, 0, inMapped.value());
 	}
 	inDmaSyncer.reset();
diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index fad9578..1dabcfb 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -198,6 +198,10 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	uint64_t sumB = 0;                \
 	uint64_t sharpness = 0;           \
 	uint64_t focusG = 0;              \
+	uint64_t greyR = 0;               \
+	uint64_t greyG = 0;               \
+	uint64_t greyB = 0;               \
+	uint64_t greyN = 0;               \
 	unsigned int sample = 0;          \
 	pixel_t previousG = 0;            \
 	bool havePreviousG = false;
@@ -212,6 +216,12 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	yVal += b * kBlueYMul;                                                        \
 	yBin = yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div));             \
 	stats.yHistogram[yBin]++;                                                     \
+	if (isGrey(r, g, b, (div))) {                                                 \
+		greyR += r;                                                           \
+		greyG += g;                                                           \
+		greyB += b;                                                           \
+		greyN++;                                                              \
+	}                                                                             \
 	if (focusLine && sample >= focusSampleStart_ &&                               \
 	    sample < focusSampleEnd_) {                                               \
 		stats.windowHistogram[yBin]++;                                        \
@@ -230,7 +240,11 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
 	stats.sum_.g() += sumG;     \
 	stats.sum_.b() += sumB;     \
 	stats.sharpness += sharpness; \
-	stats.focusGreen += focusG;
+	stats.focusGreen += focusG;   \
+	stats.greySum_.r() += greyR;  \
+	stats.greySum_.g() += greyG;  \
+	stats.greySum_.b() += greyB;  \
+	stats.greyCount += greyN;
 
 void SwStatsCpu::statsBGGR8Line0(const uint8_t *src[], SwIspStats &stats, bool focusLine)
 {
@@ -431,6 +445,8 @@ void SwStatsCpu::startFrame(uint32_t frame)
 		s.sum_ = RGB<uint64_t>({ 0, 0, 0 });
 		s.yHistogram.fill(0);
 		s.windowHistogram.fill(0);
+		s.greySum_ = RGB<uint64_t>({ 0, 0, 0 });
+		s.greyCount = 0;
 		s.sharpness = 0;
 		s.focusGreen = 0;
 	}
@@ -451,10 +467,14 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 		sharedStats_->sum_ = RGB<uint64_t>({ 0, 0, 0 });
 		sharedStats_->yHistogram.fill(0);
 		sharedStats_->windowHistogram.fill(0);
+		sharedStats_->greySum_ = RGB<uint64_t>({ 0, 0, 0 });
+		sharedStats_->greyCount = 0;
 		uint64_t sharpness = 0;
 		uint64_t green = 0;
 		for (const auto &s : stats_) {
 			sharedStats_->sum_ += s.sum_;
+			sharedStats_->greySum_ += s.greySum_;
+			sharedStats_->greyCount += s.greyCount;
 			sharpness += s.sharpness;
 			green += s.focusGreen;
 			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++) {
@@ -464,6 +484,7 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 		}
 
 		sharedStats_->sum_ >>= sumShift_;
+		sharedStats_->greySum_ >>= sumShift_;
 		sharedStats_->focusGreen = green;
 		constexpr uint64_t scale = 1000000;
 		sharedStats_->sharpness = green
@@ -628,6 +649,27 @@ void SwStatsCpu::setWindow(const Rectangle &window)
 	setFocusWindow(focusWindow_);
 }
 
+/**
+ * \brief Set the white point that grey candidates are judged against
+ * \param[in] gains The white balance gains in use
+ * \param[in] blackLevel The black level, in fractions of full scale
+ *
+ * A sample counts towards SwIspStats::greySum_ when it is neither dark nor
+ * saturated and, with the black level taken off and these gains applied,
+ * its red and blue are within a factor of 1.67 of its green. Colourful
+ * surfaces, such as grass or sky filling the picture, then don't pull the
+ * grey world estimate towards their own colour.
+ */
+void SwStatsCpu::setWhitePoint(const RGB<float> &gains, float blackLevel)
+{
+	if (gains.g() <= 0.0f)
+		return;
+
+	greyGainR_ = static_cast<int64_t>(gains.r() / gains.g() * 256.0f);
+	greyGainB_ = static_cast<int64_t>(gains.b() / gains.g() * 256.0f);
+	greyBlack_ = static_cast<int64_t>(std::clamp(blackLevel, 0.0f, 0.5f) * 256.0f);
+}
+
 /**
