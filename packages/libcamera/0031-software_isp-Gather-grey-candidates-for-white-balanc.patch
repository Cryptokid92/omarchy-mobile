+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -1090,6 +1090,7 @@ void DebayerCpu::process(uint32_t frame, FrameBuffer *input, FrameBuffer *output
 	}
 
 	stats_->setFocusWindow(params.focusWindow);
+	stats_->setWhitePoint(params.gains, params.blackLevel[1]);
 	stats_->startFrame(frame);
 
 	workPendingMutex_.lock();
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
