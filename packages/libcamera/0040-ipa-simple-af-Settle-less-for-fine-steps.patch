From 73b778951acae4cbfdcf789613959ba4315728fd Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Thu, 15 Oct 2026 15:06:15 -0400
Subject: [PATCH 40/40] ipa: simple: af: Settle less for fine steps

Every lens move waited four frames, six for a jump, for the frames in
flight and the lens's travel. A fine step moves the lens a quarter of
a coarse one, and the jump to the start of a fine scan less than one
coarse step: wait three and four frames for those. On the Google Pixel
7 Pro's main camera that takes a scan at infinity from about 44 frames
to about 38.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ipa/simple/algorithms/af.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
index c71690c7e..365652477 100644
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -48,6 +48,12 @@ static constexpr unsigned int kRescanSamples = 15;
  * travel, longest for the jump to the start of a scan.
  */
 static constexpr unsigned int kLensStepSettleSamples = 4;
+/*
+ * A fine step moves the lens a fraction of a coarse one, and the jump to the
+ * start of a fine scan less than one coarse step: one frame less each.
+ */
+static constexpr unsigned int kLensFineStepSettleSamples = 3;
+static constexpr unsigned int kLensFineJumpSettleSamples = 4;
 
 /*
  * The coarse scan stops once kPeakDropSamples samples past its best have
@@ -291,7 +297,7 @@ void Af::startFineScan(IPAContext &context, int32_t centre, int32_t radius)
 	af.position = af.scanStart;
 	af.bestPosition = af.position;
 	af.bestSharpness = 0;
-	af.settleSamples = kLensJumpSettleSamples;
+	af.settleSamples = kLensFineJumpSettleSamples;
 	fineSamples_.clear();
 }
 
@@ -344,7 +350,8 @@ void Af::processScan(IPAContext &context, uint64_t sharpness)
 	const bool peakPassed = !af.fineScan && dropSamples_ >= kPeakDropSamples;
 	if (!peakPassed && af.position + af.scanStep <= af.scanEnd) {
 		af.position += af.scanStep;
-		af.settleSamples = kLensStepSettleSamples;
+		af.settleSamples = af.fineScan ? kLensFineStepSettleSamples
+					       : kLensStepSettleSamples;
 		return;
 	}
 
