diff --git a/src/libcamera/shaders/postfilter.frag b/src/libcamera/shaders/postfilter.frag
index ed456ae..9d9615c 100644
--- a/src/libcamera/shaders/postfilter.frag
+++ b/src/libcamera/shaders/postfilter.frag
@@ -1,7 +1,7 @@
 /* SPDX-License-Identifier: LGPL-2.1-or-later */
 /*
- * Luma noise reduction and sharpening, a second pass over the debayered
- * picture (gamma-encoded RGB).
+ * Luma noise reduction and sharpening, and chroma noise reduction, a
+ * second pass over the debayered picture (gamma-encoded RGB).
  */
 
 #ifdef GL_ES
@@ -17,6 +17,8 @@ uniform vec2 tex_step;
 uniform float sharpen;
 /* Range sigma of the edge-preserving luma smoothing: 0 leaves it */
 uniform float denoise;
+/* Range sigma of the chroma smoothing: 0 leaves the chroma */
+uniform float chroma_denoise;
 uniform float swap_blue;
 
 float luma(vec3 c)
@@ -63,6 +65,44 @@ void main(void)
 	detail = sign(detail) * max(abs(detail) - 0.5 * denoise, 0.0);
 	y_out = clamp(y_out + sharpen * detail, 0.0, 1.0);
 
-	vec3 rgb = clamp(c + (y_out - y), 0.0, 1.0);
+	vec3 rgb = c + (y_out - y);
+
+	if (chroma_denoise > 0.0) {
+		/*
+		 * Colour noise is blotchy, coarser than the 3x3 above: average
+		 * the chroma over a 9x9 footprint (16 taps at 2 and 4 pixels in
+		 * eight directions), guided by the luma so that colour doesn't
+		 * bleed across edges, and by the chroma itself so that real
+		 * colour detail survives. BT.601 colour differences.
+		 */
+		vec2 cc = vec2(c.b - y, c.r - y);
+		vec2 c_sum = cc;
+		float c_weight = 1.0;
+		float inv_c = 1.0 / chroma_denoise;
+		float inv_y = 1.0 / (0.04 + 2.0 * denoise);
+
+		for (int k = 0; k < 16; k++) {
+			float a = float(k) * 0.7853982;
+			float rad = k < 8 ? 2.0 : 4.0;
+			vec2 offset = vec2(cos(a), sin(a)) * rad * tex_step;
+			vec3 cn = texture2D(tex_rgb, textureOut + offset).rgb;
+			float yn = luma(cn);
+			vec2 ccn = vec2(cn.b - yn, cn.r - yn);
+			float dy = (yn - y) * inv_y;
+			vec2 dc = (ccn - cc) * inv_c;
+			float w = (k < 8 ? 1.0 : 0.6) * exp(-dy * dy - dot(dc, dc));
+
+			c_sum += w * ccn;
+			c_weight += w;
+		}
+		cc = c_sum / c_weight;
+
+		/* Rebuild RGB from the luma and the smoothed colour differences */
+		rgb.b = y_out + cc.x;
+		rgb.r = y_out + cc.y;
+		rgb.g = (y_out - 0.299 * rgb.r - 0.114 * rgb.b) / 0.587;
+	}
+
+	rgb = clamp(rgb, 0.0, 1.0);
 	gl_FragColor = vec4(mix(rgb, rgb.bgr, swap_blue), 1.0);
 }
