 	postUniformSharpen_ = glGetUniformLocation(postProgramId_, "sharpen");
 	postUniformDenoise_ = glGetUniformLocation(postProgramId_, "denoise");
+	postUniformChromaDenoise_ = glGetUniformLocation(postProgramId_, "chroma_denoise");
 	postUniformSwapBlue_ = glGetUniformLocation(postProgramId_, "swap_blue");
 	postUniformProjMatrix_ = glGetUniformLocation(postProgramId_, "proj_matrix");
 	postUniformStrideFactor_ = glGetUniformLocation(postProgramId_, "stride_factor");
@@ -708,6 +709,7 @@ int DebayerEGL::postFilter(eGLImage &eglImageOut, const DebayerParams &params)
 		    1.0f / outputSize_.height);
 	glUniform1f(postUniformSharpen_, params.sharpen);
 	glUniform1f(postUniformDenoise_, params.denoise);
+	glUniform1f(postUniformChromaDenoise_, params.chromaDenoise);
 	glUniform1f(postUniformSwapBlue_, swapBlue_ ? 1.0f : 0.0f);
 	glUniformMatrix4fv(postUniformProjMatrix_, 1, GL_FALSE, identity);
 	glUniform1f(postUniformStrideFactor_, 1.0f);
@@ -733,7 +735,8 @@ int DebayerEGL::debayerGPU(FrameBuffer *input, FrameBuffer *output, const Debaye
 	if (!eglImageOut)
 		return -ENOMEM;
 
-	const bool post = postImage_ && (params.sharpen > 0.0f || params.denoise > 0.0f);
+	const bool post = postImage_ && (params.sharpen > 0.0f || params.denoise > 0.0f ||
+					  params.chromaDenoise > 0.0f);
 
 	egl_.attachTextureToFBO(post ? *postImage_ : *eglImageOut);
 	setShaderVariableValues(*eglImageIn, params);
