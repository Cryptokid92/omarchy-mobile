index c3bd323..7bd693a 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -41,12 +41,13 @@ struct DebayerParams {
 	RGB<float> lscK2 = RGB<float>({ 0.0, 0.0, 0.0 });
 	std::array<float, 2> lscScale = { 1.0f, 1.0f };
 	/*
-	 * Luma sharpening (unsharp mask amount) and noise reduction (range
-	 * sigma, in fractions of full scale), in a second pass of the GPU
-	 * debayer that runs only while either is set.
+	 * Luma sharpening (unsharp mask amount), luma noise reduction and
+	 * chroma noise reduction (range sigmas, in fractions of full scale),
+	 * in a second pass of the GPU debayer that runs only while one is set.
 	 */
 	float sharpen = 0.0f;
 	float denoise = 0.0f;
+	float chromaDenoise = 0.0f;
 	/*
 	 * The look, after the colour matrix: a hue shift (radians) and a
 	 * vibrance (the chroma gain for the dullest colours, falling to none
diff --git a/src/ipa/simple/algorithms/detail.cpp b/src/ipa/simple/algorithms/detail.cpp
index ab5184d..7b3f5a0 100644
--- a/src/ipa/simple/algorithms/detail.cpp
+++ b/src/ipa/simple/algorithms/detail.cpp
@@ -24,14 +24,17 @@ namespace ipa::soft::algorithms {
 
 /**
  * \class Detail
- * \brief Luma noise reduction and sharpening, scaled with the gain
+ * \brief Luma and chroma noise reduction and sharpening, scaled with the gain
  *
  * The GPU debayer's second pass smooths the luma with an edge-preserving
  * (bilateral) 3x3 filter and sharpens it with an unsharp mask, cored by the
- * noise level. Noise grows with the gain, so the smoothing grows with it and
- * the sharpening falls:
+ * noise level. It also averages the chroma over a 9x9 footprint, guided by
+ * the luma and the chroma, for the blotchy colour noise of high gains.
+ * Noise grows with the gain, so the smoothing grows with it and the
+ * sharpening falls:
  *
  *   denoise = denoise_base * sqrt(gain), at most kDenoiseMax
+ *   chroma_denoise = chroma_denoise_base * sqrt(gain), at most kChromaDenoiseMax
  *   sharpen = sharpen_base * Sharpness / (1 + log2(gain) / 3)
  *
  * where gain is the analogue gain times the digital gain. The tuning file
@@ -40,9 +43,11 @@ namespace ipa::soft::algorithms {
  *   - Detail:
  *       sharpen: 0.6
  *       denoise: 0.015
+ *       chromaDenoise: 0.03
  */
 
 static constexpr float kDenoiseMax = 0.15f;
+static constexpr float kChromaDenoiseMax = 0.25f;
 static constexpr float kSharpnessMax = 4.0f;
 
 int Detail::init(IPAContext &context, const ValueNode &tuningData)
@@ -50,6 +55,8 @@ int Detail::init(IPAContext &context, const ValueNode &tuningData)
 	sharpen_ = std::clamp(tuningData["sharpen"].get<float>().value_or(0.6f), 0.0f, 4.0f);
 	denoise_ = std::clamp(tuningData["denoise"].get<float>().value_or(0.015f), 0.0f,
 			      kDenoiseMax);
+	chromaDenoise_ = std::clamp(tuningData["chromaDenoise"].get<float>().value_or(0.03f),
+				    0.0f, kChromaDenoiseMax);
 
 	context.ctrlMap[&controls::Sharpness] = ControlInfo(0.0f, kSharpnessMax, 1.0f);
 
@@ -76,6 +83,8 @@ void Detail::prepare(IPAContext &context,
 
 	params->denoise = std::min(static_cast<float>(denoise_ * std::sqrt(gain)),
 				   kDenoiseMax);
+	params->chromaDenoise = std::min(static_cast<float>(chromaDenoise_ * std::sqrt(gain)),
+					 kChromaDenoiseMax);
 	params->sharpen = static_cast<float>(sharpen_ * sharpness_ /
 					     (1.0 + std::log2(gain) / 3.0));
 }
