new file mode 100644
index 0000000..ed456ae
--- /dev/null
+++ b/src/libcamera/shaders/postfilter.frag
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Luma noise reduction and sharpening, a second pass over the debayered
+ * picture (gamma-encoded RGB).
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+varying vec2 textureOut;
+
+uniform sampler2D tex_rgb;
+/* One pixel, in texture coordinates */
+uniform vec2 tex_step;
+/* Unsharp mask amount on the luma: 0 leaves it */
+uniform float sharpen;
+/* Range sigma of the edge-preserving luma smoothing: 0 leaves it */
+uniform float denoise;
+uniform float swap_blue;
+
+float luma(vec3 c)
+{
+	return dot(c, vec3(0.299, 0.587, 0.114));
+}
+
+void main(void)
+{
+	vec3 c = texture2D(tex_rgb, textureOut).rgb;
+	float y = luma(c);
+
+	/*
+	 * The 3x3 neighbourhood: a binomial blur for the unsharp mask, and
+	 * the same weights scaled down by the difference in luma for the
+	 * bilateral smoothing, so that edges keep their contrast.
+	 */
+	float blur = 4.0 * y;
+	float smooth_sum = 4.0 * y;
+	float smooth_weight = 4.0;
+	float inv_sigma = denoise > 0.0 ? 1.0 / denoise : 0.0;
+
+	for (int j = -1; j <= 1; j++) {
+		for (int i = -1; i <= 1; i++) {
+			if (i == 0 && j == 0)
+				continue;
+			vec2 offset = vec2(float(i), float(j)) * tex_step;
+			float yn = luma(texture2D(tex_rgb, textureOut + offset).rgb);
+			float w = (i == 0 || j == 0) ? 2.0 : 1.0;
+			float d = (yn - y) * inv_sigma;
+			float ws = w * exp(-d * d);
+
+			blur += w * yn;
+			smooth_sum += ws * yn;
+			smooth_weight += ws;
+		}
+	}
+	blur /= 16.0;
+
+	float y_out = denoise > 0.0 ? smooth_sum / smooth_weight : y;
+
+	/* Sharpen detail above the noise only (coring) */
+	float detail = y - blur;
+	detail = sign(detail) * max(abs(detail) - 0.5 * denoise, 0.0);
+	y_out = clamp(y_out + sharpen * detail, 0.0, 1.0);
+
+	vec3 rgb = clamp(c + (y_out - y), 0.0, 1.0);
+	gl_FragColor = vec4(mix(rgb, rgb.bgr, swap_blue), 1.0);
+}
