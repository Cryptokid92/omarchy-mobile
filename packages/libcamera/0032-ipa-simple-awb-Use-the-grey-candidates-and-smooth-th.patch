From 8718ceb6a0d20ac5b99fed0a74e195c488124a89 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Wed, 14 Oct 2026 20:53:15 -0400
Subject: [PATCH 32/32] ipa: simple: awb: Use the grey candidates, and smooth
 the gains

Take the grey world over the statistics' grey candidates when they are
at least 2% of the samples, so a single-coloured scene keeps its
colour; with fewer (a strongly coloured light, or the first frames)
take every sample as before.

Move the gains 30% of the way to each new estimate, geometrically,
rather than jumping, so that a colourful object passing through the
picture doesn't flash its colours; the first estimate after a start
still applies at once.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ipa/simple/algorithms/awb.cpp | 38 +++++++++++++++++++++++++++----
 1 file changed, 33 insertions(+), 5 deletions(-)

diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index df36ada..39a2506 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -25,6 +25,11 @@ LOG_DEFINE_CATEGORY(IPASoftAwb)
 
 namespace ipa::soft::algorithms {
 
+/* The share of grey candidates below which the grey world takes every sample */
+static constexpr double kMinGreyShare = 0.02;
+/* The part of the way to a new estimate the gains move each time */
+static constexpr float kSmoothing = 0.3f;
+
 /* The gains the image processor's lookup takes, as the grey world clamps them. */
 static constexpr float kGainMin = 0.25f;
 static constexpr float kGainMax = 4.0f;
@@ -167,31 +172,54 @@ void Awb::process(IPAContext &context,
 	 */
 	const uint64_t nPixels = std::accumulate(
 		histogram.begin(), histogram.end(), uint64_t(0));
-	const uint64_t offset = blackLevel * nPixels;
+
+	/*
+	 * The grey world over the samples that may be grey (see
+	 * SwStatsCpu::setWhitePoint()): a picture filled with one colour, such
+	 * as grass or sky, otherwise turns its opposite. With too few of them
+	 * (a strongly coloured light, or the first frames) take every sample.
+	 */
+	const bool grey = stats->greyCount >= nPixels * kMinGreyShare;
+	const uint64_t count = grey ? stats->greyCount : nPixels;
+	const RGB<uint64_t> &sums = grey ? stats->greySum_ : stats->sum_;
+	const uint64_t offset = blackLevel * count;
 	const uint64_t minValid = 1;
 	/*
 	 * Make sure the sums are at least minValid, while preventing unsigned
 	 * integer underflow.
 	 */
-	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;
+	const RGB<uint64_t> sum = sums.max(offset + minValid) - offset;
 
 	/*
 	 * Calculate red and blue gains for AWB.
 	 * Clamp max gain at 4.0, this also avoids 0 division.
 	 */
-	auto &gains = context.activeState.awb.gains;
-	gains = { {
+	const RGB<float> target = { {
 		sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
 		1.0,
 		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
 	} };
 
+	/*
+	 * Move part of the way each time, in proportion (a geometric step),
+	 * so that a passing colourful object doesn't flash the colours; jump
+	 * on the first estimate.
+	 */
+	auto &gains = context.activeState.awb.gains;
+	if (gains.r() == 1.0f && gains.b() == 1.0f) {
+		gains = target;
+	} else {
+		gains.r() *= std::pow(target.r() / gains.r(), kSmoothing);
+		gains.b() *= std::pow(target.b() / gains.b(), kSmoothing);
+	}
+
 	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
 	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
 
 	LOG(IPASoftAwb, Debug)
-		<< "gain R/B: " << gains << "; temperature: "
+		<< "gain R/B: " << gains << " (grey samples " << stats->greyCount
+		<< "/" << nPixels << "); temperature: "
 		<< context.activeState.awb.temperatureK;
 }
 
