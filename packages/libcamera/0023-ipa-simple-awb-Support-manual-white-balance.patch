index bf8e0f7..03508bc 100644
--- a/src/ipa/simple/ipa_context.h
+++ b/src/ipa/simple/ipa_context.h
@@ -74,6 +74,8 @@ struct IPAActiveState {
 	struct {
 		RGB<float> gains;
 		unsigned int temperatureK;
+		/* False: the gains stay, or follow ColourGains/ColourTemperature */
+		bool enabled;
 	} awb;
 
 	Matrix<float, 3, 3> combinedMatrix;
