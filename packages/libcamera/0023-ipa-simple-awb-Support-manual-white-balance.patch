@@ -3,8 +3,9 @@
 # Sony IMX386 (the Pixel 7 Pro's ultrawide), not calibrated yet. The black
 # level comes from the sensor's helper.
 #
-# The colour matrices are a stand-in: the IMX519 matrices from libcamera's
-# src/ipa/rpi/vc4/data/imx519.json (rpi.ccm), Copyright 2019-2020
+# The colour matrices and the white balance's colour temperature curve are
+# a stand-in: the IMX519 matrices and curve from libcamera's
+# src/ipa/rpi/vc4/data/imx519.json (rpi.ccm, rpi.awb), Copyright 2019-2020
 # Raspberry Pi Ltd, BSD-2-Clause (see REUSE.toml and
 # LICENSES/BSD-2-Clause.txt). The IMX519 is another Sony mobile-class
 # Bayer sensor with a similar pixel (1.22 um against 1.25 um), and any
@@ -21,6 +22,12 @@ version: 1
 algorithms:
   - BlackLevel:
   - Awb:
+      # (colour temperature, R/G, B/G) for ColourTemperature
+      ctCurve: [ 2890.0, 0.7328, 0.3734,
+                 3550.0, 0.6228, 0.4763,
+                 4500.0, 0.5208, 0.5825,
+                 5700.0, 0.4467, 0.6671,
+                 7900.0, 0.3858, 0.7411 ]
   - Ccm:
       ccms:
         - ct: 2890
