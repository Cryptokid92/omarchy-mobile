+++ b/src/ipa/simple/algorithms/awb.h
@@ -7,6 +7,9 @@
 
 #pragma once
 
+#include <tuple>
+#include <vector>
+
 #include "algorithm.h"
 
 namespace libcamera {
@@ -19,7 +22,12 @@ public:
 	Awb() = default;
 	~Awb() = default;
 
+	int init(IPAContext &context, const ValueNode &tuningData) override;
 	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
 	void prepare(IPAContext &context,
 		     const uint32_t frame,
 		     IPAFrameContext &frameContext,
@@ -29,6 +37,12 @@ public:
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
 		     ControlList &metadata) override;
+
+private:
+	RGB<float> gainsForTemperature(unsigned int temperatureK) const;
+
+	/* (colour temperature, R/G, B/G) of a grey under that light */
+	std::vector<std::tuple<double, double, double>> ctCurve_;
 };
 
 } /* namespace ipa::soft::algorithms */
diff --git a/src/ipa/simple/data/imx386.yaml b/src/ipa/simple/data/imx386.yaml
index 768e63d..7a9d1d9 100644
