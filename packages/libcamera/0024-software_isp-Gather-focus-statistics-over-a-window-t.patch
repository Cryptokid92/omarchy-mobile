@@ -616,13 +625,38 @@ void SwStatsCpu::setWindow(const Rectangle &window)
 	window_.width &= ~(patternSize_.width - 1);
 	window_.height &= ~(patternSize_.height - 1);
 
+	setFocusWindow(focusWindow_);
+}
+
+/**
+ * \brief Set the window for autofocus and spot metering statistics
+ * \param[in] window The x, y, width and height of the window, in fractions
+ * of the statistics window
+ *
+ * The sharpness and the window histogram are gathered over this part of the
+ * statistics window set by setWindow(). The default is its centre half.
+ */
+void SwStatsCpu::setFocusWindow(const std::array<float, 4> &window)
+{
+	focusWindow_ = window;
+
+	const float x = std::clamp(window[0], 0.0f, 1.0f);
+	const float y = std::clamp(window[1], 0.0f, 1.0f);
+	const float w = std::clamp(window[2], 0.0f, 1.0f - x);
+	const float h = std::clamp(window[3], 0.0f, 1.0f - y);
+
 	/*
 	 * Every line function takes one sample per other 2x2 block, so about
-	 * width / 4 samples per line. Autofocus uses the centre half of them.
+	 * width / 4 samples per line.
 	 */
 	const unsigned int samples = window_.width / 4;
-	focusSampleStart_ = samples / 4;
-	focusSampleEnd_ = samples * 3 / 4;
+	focusSampleStart_ = static_cast<unsigned int>(samples * x);
+	focusSampleEnd_ = std::max(focusSampleStart_ + 2,
+				   static_cast<unsigned int>(samples * (x + w)));
+	focusLineStart_ = static_cast<unsigned int>(window_.height * y);
+	/* Lines are sampled in pairs, every other pair. */
+	focusLineEnd_ = std::max(focusLineStart_ + 4,
+				 static_cast<unsigned int>(window_.height * (y + h)));
 }
 
 void SwStatsCpu::processBayerFrame2(MappedFrameBuffer &in)
