 src/libcamera/shaders/bayer_1x_packed.frag    | 67 +++++++++++++++++++
 src/libcamera/shaders/bayer_unpacked.frag     | 67 +++++++++++++++++++
 src/libcamera/software_isp/debayer_egl.cpp    | 12 ++++
 src/libcamera/software_isp/debayer_egl.h      |  6 ++
 5 files changed, 162 insertions(+)

diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index ccffa944b..c3bd32370 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -47,6 +47,16 @@ struct DebayerParams {
 	 */
 	float sharpen = 0.0f;
 	float denoise = 0.0f;
+	/*
+	 * The look, after the colour matrix: a hue shift (radians) and a
+	 * vibrance (the chroma gain for the dullest colours, falling to none
+	 * at chroma vibranceLimit) for each of 12 hue sectors in linear
+	 * opponent space, and the tone curve's shadow lift (0: none).
+	 */
+	std::array<float, 12> hueShift = {};
+	std::array<float, 12> vibrance = {};
+	float vibranceLimit = 1.0f;
+	float toneLift = 0.0f;
 };
 
 } /* namespace libcamera */
diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 550de26ba..9f5a59417 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -101,6 +101,67 @@ float shoulder(float x)
 	       (1.0 - exp(-SHOULDER_SHAPE * t)) / (1.0 - exp(-SHOULDER_SHAPE));
 }
 
+/*
+ * The look: in linear opponent space (chroma (B - Y, R - Y) over the
+ * luminance Y), each of 12 hue sectors 30 degrees wide shifts its hue and
+ * raises its chroma, interpolated between the sectors' centres, the dull
+ * colours most (vibrance) and near-neutral ones not at all.
+ */
+uniform float hue_shift[12];
+uniform float vibrance[12];
+uniform float vibrance_limit;
+uniform float tone_lift;
+
+vec3 apply_look(vec3 rgb)
+{
+	float y = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
+	if (y < 1e-4)
+		return rgb;
+
+	vec2 c = vec2(rgb.b - y, rgb.r - y) / y;
+	float r = length(c);
+	if (r < 1e-4)
+		return rgb;
+	float h = atan(c.y, c.x);
+	if (h < 0.0)
+		h += 6.2831853;
+
+	float dh = 0.0;
+	float v = 0.0;
+	for (int i = 0; i < 12; i++) {
+		float centre = float(i) * 0.5235988;
+		float d = abs(h - centre);
+		d = min(d, 6.2831853 - d);
+		float w = max(0.0, 1.0 - d / 0.5235988);
+		dh += w * hue_shift[i];
+		v += w * vibrance[i];
+	}
+
+	float w = smoothstep(0.05, 0.2, r);
+	h += w * dh;
+	r *= 1.0 + w * v * max(0.0, 1.0 - r / vibrance_limit);
+
+	float red = y * (1.0 + r * sin(h));
+	float blue = y * (1.0 + r * cos(h));
+	float green = (y - 0.2126 * red - 0.0722 * blue) / 0.7152;
+	return vec3(red, green, blue);
+}
+
+/*
+ * The tone curve: a shadow lift on the luminance, x (1 + a) / (x + a),
+ * which keeps full scale and the hue, and raises the dark parts most.
+ */
+vec3 apply_tone(vec3 rgb)
+{
+	if (tone_lift <= 0.0)
+		return rgb;
+	float y = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
+	if (y < 1e-5)
+		return rgb;
+	float yc = min(y, 4.0);
+	return rgb * (yc * (1.0 + tone_lift) / (yc + tone_lift)) / y;
+}
+
 void main(void)
 {
 	vec3 rgb;
@@ -275,6 +336,9 @@ void main(void)
 	/* Colour Correction Matrix */
 	rgb = ccm * rgb;
 
+	/* The look: hues and vibrance */
+	rgb = apply_look(rgb);
+
 	/*
 	 * Shoulder: colours the gains took past full scale roll off instead of
 	 * clipping, scaled together so they keep their hue: an overcast sky
@@ -284,6 +348,9 @@ void main(void)
 	if (peak > SHOULDER_KNEE)
 		rgb *= shoulder(peak) / peak;
 
+	/* The tone curve: lift the shadows */
+	rgb = apply_tone(rgb);
+
 	/*
 	 * Gamut: a colour outside the range moves towards its luminance, not
 	 * channel by channel, so saturated colours don't change hue (neon red
