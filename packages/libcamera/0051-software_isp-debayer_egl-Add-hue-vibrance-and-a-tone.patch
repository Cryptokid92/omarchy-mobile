     vec3 rgb;
 
@@ -179,6 +240,9 @@ void main(void) {
     /* Colour Correction Matrix */
     rgb = ccm * rgb;
 
+    /* The look: hues and vibrance */
+    rgb = apply_look(rgb);
+
     /*
      * Shoulder: colours the gains took past full scale roll off instead of
      * clipping, scaled together so they keep their hue: an overcast sky
@@ -188,6 +252,9 @@ void main(void) {
     if (peak > SHOULDER_KNEE)
     	rgb *= shoulder(peak) / peak;
 
+    /* The tone curve: lift the shadows */
+    rgb = apply_tone(rgb);
+
     /*
      * Gamut: a colour outside the range moves towards its luminance, not
      * channel by channel, so saturated colours don't change hue (neon red
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index 2a765a038..f1b4de0f2 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -122,6 +122,10 @@ int DebayerEGL::getShaderVariableLocations(void)
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
 	swapBlueUniformDataIn_ = glGetUniformLocation(programId_, "swap_blue");
+	hueShiftUniformDataIn_ = glGetUniformLocation(programId_, "hue_shift");
+	vibranceUniformDataIn_ = glGetUniformLocation(programId_, "vibrance");
+	vibranceLimitUniformDataIn_ = glGetUniformLocation(programId_, "vibrance_limit");
+	toneLiftUniformDataIn_ = glGetUniformLocation(programId_, "tone_lift");
 	lscK1UniformDataIn_ = glGetUniformLocation(programId_, "lsc_k1");
 	lscK2UniformDataIn_ = glGetUniformLocation(programId_, "lsc_k2");
 	lscScaleUniformDataIn_ = glGetUniformLocation(programId_, "lsc_scale");
@@ -529,6 +533,14 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	glUniform3f(lscK2UniformDataIn_, params.lscK2[0], params.lscK2[1], params.lscK2[2]);
 	glUniform2f(lscScaleUniformDataIn_, params.lscScale[0], params.lscScale[1]);
 
+	/*
+	 * The look and the tone curve
+	 */
+	glUniform1fv(hueShiftUniformDataIn_, 12, params.hueShift.data());
+	glUniform1fv(vibranceUniformDataIn_, 12, params.vibrance.data());
+	glUniform1f(vibranceLimitUniformDataIn_, std::max(params.vibranceLimit, 0.01f));
+	glUniform1f(toneLiftUniformDataIn_, params.toneLift);
+
 	return;
 }
 
