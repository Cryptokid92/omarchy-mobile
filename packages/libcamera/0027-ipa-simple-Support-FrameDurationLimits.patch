+/*
+ * The frame lengths the application's FrameDurationLimits allow, and the
+ * exposure limits that follow: without limits the sensor keeps its default
+ * frame rate and the AE its exposure, while an application's own exposure
+ * time may lengthen the frame as far as the sensor allows.
+ */
+void IPASoftSimple::updateFrameLimits()
+{
+	auto &frame = context_.configuration.frame;
+	auto &agc = context_.configuration.agc;
+
+	agc.exposureMax = agc.sensorExposureMax;
+	agc.exposureMaxManual = agc.sensorExposureMax;
+	if (!frame.height)
+		return;
+
+	const int32_t linesMin = frame.height + frame.vblankMin;
+	const int32_t linesMax = frame.height + frame.vblankMax;
+	frame.minLines = frame.maxLines = frame.height + frame.vblankDefault;
+
+	const auto &limits = context_.activeState.frameDuration.limits;
+	if (limits && agc.lineDuration.get<std::nano>() > 0) {
+		frame.minLines = std::clamp(static_cast<int32_t>(std::ceil(
+						    limits->first / agc.lineDuration)),
+					    linesMin, linesMax);
+		frame.maxLines = std::clamp(static_cast<int32_t>(
+						    limits->second / agc.lineDuration),
+					    frame.minLines, linesMax);
+	}
+
+	agc.exposureMax = std::max(agc.exposureMin, frame.maxLines - frame.exposureMargin);
+	agc.exposureMaxManual = std::max(agc.exposureMax, linesMax - frame.exposureMargin);
+}
