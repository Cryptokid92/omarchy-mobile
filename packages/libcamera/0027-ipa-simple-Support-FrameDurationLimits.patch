+		const auto min = std::chrono::microseconds((*limits)[0]);
+		const auto max = std::chrono::microseconds(std::max((*limits)[0], (*limits)[1]));
+		auto &current = context_.activeState.frameDuration.limits;
+		if (!current || current->first != utils::Duration(min) ||
+		    current->second != utils::Duration(max)) {
+			current = { utils::Duration(min), utils::Duration(max) };
+			updateFrameLimits();
+			LOG(IPASoft, Debug)
+				<< "Frame lines " << context_.configuration.frame.minLines
+				<< "-" << context_.configuration.frame.maxLines;
+		}
+	}
+
 	for (const auto &algo : algorithms())
 		algo->queueRequest(context_, frame, frameContext, controls);
