From 34df23b5da1dd0297c8fd4952da0ee1ccd124970 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Fri, 16 Oct 2026 11:07:06 -0400
Subject: [PATCH 48/48] software_isp: debayer_egl: Fade sensor-clipped
 highlights gently

The fade to neutral of colours near the sensor's full scale ran from
93% to full scale. A blue sky the sensor clipped in the middle of the
picture, where the lens vignettes least, crossed that band within a
few pixels' radius and ended in a hard, noisy ring between white and
blue.

Fade from 80%, squared so that it starts gently: the white middle now
blends into the blue over a wide band.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/libcamera/shaders/bayer_1x_packed.frag | 7 +++++--
 src/libcamera/shaders/bayer_unpacked.frag  | 7 +++++--
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index be240dbc7..550de26ba 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -264,9 +264,12 @@ void main(void)
 
 	/*
 	 * Highlights the sensor clipped have lost their colour: fade them
-	 * towards neutral (a clipped green made skies cyan).
+	 * towards neutral (a clipped green made skies cyan), over a wide band
+	 * and starting gently: a sky the sensor clipped in its middle, where
+	 * the lens vignettes least, otherwise ends in a hard ring.
 	 */
-	float hl = smoothstep(0.93, 1.0, max(max(sensor.r, sensor.g), sensor.b));
+	float hl = smoothstep(0.80, 1.0, max(max(sensor.r, sensor.g), sensor.b));
+	hl *= hl;
 	rgb = mix(rgb, vec3(max(max(rgb.r, rgb.g), rgb.b)), hl);
 
 	/* Colour Correction Matrix */
diff --git a/src/libcamera/shaders/bayer_unpacked.frag b/src/libcamera/shaders/bayer_unpacked.frag
index d338928f0..53b701e0b 100644
--- a/src/libcamera/shaders/bayer_unpacked.frag
+++ b/src/libcamera/shaders/bayer_unpacked.frag
@@ -168,9 +168,12 @@ void main(void) {
 
     /*
      * Highlights the sensor clipped have lost their colour: fade them
-     * towards neutral (a clipped green made skies cyan).
+     * towards neutral (a clipped green made skies cyan), over a wide band
+     * and starting gently: a sky the sensor clipped in its middle, where
+     * the lens vignettes least, otherwise ends in a hard ring.
      */
-    float hl = smoothstep(0.93, 1.0, max(max(sensor.r, sensor.g), sensor.b));
+    float hl = smoothstep(0.80, 1.0, max(max(sensor.r, sensor.g), sensor.b));
+    hl *= hl;
     rgb = mix(rgb, vec3(max(max(rgb.r, rgb.g), rgb.b)), hl);
 
     /* Colour Correction Matrix */
-- 
