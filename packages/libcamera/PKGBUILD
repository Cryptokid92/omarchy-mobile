# SPDX-License-Identifier: 0BSD
#
# Omandroid build of libcamera for the Pixel 7 Pro (gs201 CSIS receiver).
#
# Derived from Arch Linux's libcamera PKGBUILD, tag 0.7.2-4
# (https://gitlab.archlinux.org/archlinux/packaging/packages/libcamera, 0BSD),
# which Arch Linux ARM builds unchanged for aarch64. Omandroid changes:
#  - 0001-pipeline-simple-Add-the-Google-gs201-CSIS-receiver.patch: one
#    entry in the simple pipeline handler's supportedDevices table, so a
#    media device whose driver is "gs201-csis" is matched, with the software
#    ISP on (device/cheetah/CAMERA-PLAN.md, 5.2). Send upstream together
#    with the kernel driver; drop it once libcamera ships the entry.
#  - aarch64 only. Pipelines simple and uvcvideo (USB cameras through
#    USB-C), IPA simple only: none of the other aarch64 pipelines (rkisp1,
#    rpi/*, imx8-isi, mali-c55) can match on this phone, and a smaller
#    native build.
#  - softisp-gpu forced on, so a missing EGL fails the build instead of
#    silently leaving the GPU debayer out. At runtime the GPU path is
#    tried first and falls back to the CPU; LIBCAMERA_SOFTISP_MODE=cpu
#    forces the CPU path.
#  - No documentation (no libcamera-docs split, no Doxygen, Sphinx or
#    TeX Live in the build) and no test suite (test=false, no check()).
#  - pkgrel 4.1, so it sorts above Arch Linux ARM's 0.7.2-4.
#
# Maintainers of the original: David Runge, Carl Smedstad.

pkgbase=libcamera
pkgname=(
  libcamera
  libcamera-ipa
  libcamera-tools
  gst-plugin-libcamera
  python-libcamera
)
pkgver=0.7.2
pkgrel=4.1
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS (Omandroid: gs201 CSIS)"
arch=(aarch64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
makedepends=(
  cmake
  git
  glib2
  gst-plugins-base
  gtest
  libdrm
  libgcc
  libglvnd
  libjpeg-turbo
  libstdc++
  libtiff
  libyaml
  libyuv
  meson
  pybind11
  python-jinja
  python-ply
  python-pyyaml
  qt6-base
  qt6-tools
  sdl2
  systemd
)
source=(
  "git+$_url#tag=v$pkgver"
  "$pkgbase-fix-python3.14-macro-redefinition.patch"
  0001-pipeline-simple-Add-the-Google-gs201-CSIS-receiver.patch
)
