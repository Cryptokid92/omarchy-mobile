From 090490d69204bffbc2e57e141a6d9a7976e6f120 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Fri, 16 Oct 2026 11:05:58 -0400
Subject: [PATCH 47/48] ipa: simple: agc: Mind what the sensor saturates, and
 the rest

Daylight test 4 on the Google Pixel 7 Pro, with libcamera 4.16:

- A blue sky the sensor saturated came out as a white disc in a blue
  ring, the clip contour drawn by the lens's vignetting: the luminance
  histogram kept it under the top, so the cap never counted it.
- A sunny lawn with a shadowed foreground came out milky, a quarter of
  it at sRGB 240-250, which the shoulder kept just under the clip
  threshold, while AE said converged.
- A room with a ceiling light in frame came out dark: the lamp held the
  exposure at the cap.

Count the samples the sensor saturated, against their own limit (2%,
5% when the rest of the picture is under half the target, 10% under a
quarter), and count as clipped what comes out at sRGB 240 rather than
250. Grade the output limit by the mean of the samples that don't clip
rather than by the share of dark ones: 2%, 10% when the rest is under
half the target, 20% under a quarter, so a lamp in a dim room no longer
darkens it while a sunlit scene keeps the strict limit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ipa/simple/algorithms/agc.cpp | 98 ++++++++++++++++++++-----------
 src/ipa/simple/algorithms/agc.h   |  3 +-
 2 files changed, 66 insertions(+), 35 deletions(-)

diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index 10d669959..92ae73c16 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -81,17 +81,20 @@ static constexpr unsigned int kExpSettleFrames = 1;
 static constexpr unsigned int kExpCarriedSettleFrames = 2;
 
 /*
- * Highlight protection: the share of the picture that may come out clipped,
- * and a more lenient one when at least kBacklitDarkShare of the picture is
- * darker than kDarkShare of the target, a subject against the light. The
- * protection never takes the mean more than kHighlightMaxCut under the
- * target: a picture with a big overcast sky keeps some ground.
+ * Highlight protection: the share of the picture that may come out clipped
+ * (or clip at the sensor), more when the rest of the picture is dark: a
+ * subject against the light, or a lamp in a room, may clip
+ * kHighlightMaxDark, or kHighlightMaxDarker when the rest is darker still.
+ * The protection never takes the mean more than kHighlightMaxCut under the
+ * target: a picture with a big sky keeps some ground.
  */
 static constexpr double kHighlightMax = 0.02;
-static constexpr double kHighlightMaxBacklit = 0.10;
-static constexpr double kDarkShare = 0.25;
-static constexpr double kBacklitDarkShare = 0.6;
+static constexpr double kHighlightMaxDark = 0.10;
+static constexpr double kHighlightMaxDarker = 0.20;
 static constexpr double kHighlightMaxCut = 0.5;
+/* The same for what the sensor saturated, stricter */
+static constexpr double kSaturatedMaxDark = 0.05;
+static constexpr double kSaturatedMaxDarker = 0.10;
 
 /*
  * After a cut, the exposure stays under kClipMargin of the one that clipped,
@@ -101,8 +104,12 @@ static constexpr double kHighlightMaxCut = 0.5;
 static constexpr double kClipMargin = 0.85;
 static constexpr double kClipRelax = 1.02;
 
-/* The output level counted as clipped, before the gamma (sRGB 250) */
-static constexpr double kClippedOutput = 0.98;
+/*
+ * The output level counted as clipped, before the gamma (sRGB 240): the
+ * shoulder brings the brightest parts close to white without clipping
+ * them, and a picture mostly at sRGB 240-250 looks milky.
+ */
+static constexpr double kClippedOutput = 0.94;
 
 /* The GPU debayer's highlight shoulder (bayer_*.frag, SHOULDER_*) */
 static constexpr double kShoulderKnee = 0.6;
@@ -262,7 +269,7 @@ void Agc::queueRequest(typename Module::Context &context,
 
 bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 			 double exposureMSV, double meanLuminance,
-			 double highlights, bool backlit)
+			 double highlights, double saturated, double restLuminance)
 {
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
@@ -316,16 +323,29 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 
 	/*
 	 * Highlight protection: no more than kHighlightMax of the picture
-	 * clipped, or kHighlightMaxBacklit when most of it is dark (a subject
-	 * against a bright sky keeps its exposure, the sky blows). Too many
-	 * clipped samples cut the exposure whatever the mean says; close to
-	 * the limit, the mean may no longer raise it.
+	 * clipped, more when the rest of it is dark (a subject against a
+	 * bright sky keeps its exposure, a lamp in a dim room doesn't darken
+	 * the room). Too many clipped samples cut the exposure whatever the
+	 * mean says; close to the limit, the mean may no longer raise it.
 	 */
-	const double allowed = (backlit ? kHighlightMaxBacklit : kHighlightMax) *
-			       std::exp2(std::max(0.0f, agc.exposureValue));
-	const bool tooBright = highlights > allowed * 1.5 &&
+	const double base = restLuminance < kTargetLuminance / 4 ? kHighlightMaxDarker
+			  : restLuminance < kTargetLuminance / 2 ? kHighlightMaxDark
+								 : kHighlightMax;
+	const double evScale = std::exp2(std::max(0.0f, agc.exposureValue));
+	const double allowed = base * evScale;
+	/*
+	 * What the sensor saturated gets less leniency: a large saturated
+	 * sky comes out as a white disc in a blue ring.
+	 */
+	const double allowedSaturated =
+		(restLuminance < kTargetLuminance / 4 ? kSaturatedMaxDarker
+		 : restLuminance < kTargetLuminance / 2 ? kSaturatedMaxDark
+							: kHighlightMax) *
+		evScale;
+	const double over = std::max(highlights / allowed, saturated / allowedSaturated);
+	const bool tooBright = over > 1.5 &&
 			       meanLuminance > kTargetLuminance * kHighlightMaxCut;
-	const bool atLimit = highlights > allowed * 0.75;
+	const bool atLimit = over > 0.75;
 	if (!tooBright && (std::abs(error) <= kSatisfactoryStops ||
 			   (atLimit && error > 0))) {
 		agc.state = controls::AeStateConverged;
@@ -355,8 +375,7 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 
 	const double current = static_cast<double>(exposure) * again * dgain;
 	if (tooBright && exposureMSV < kExposurePinnedBright) {
-		factor = std::min(factor, std::clamp(std::sqrt(allowed / highlights),
-						     0.5, 0.9));
+		factor = std::min(factor, std::clamp(std::sqrt(1.0 / over), 0.5, 0.9));
 		agc.clipTotal = current;
 	}
 
@@ -398,7 +417,8 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 
 	LOG(IPASoftExposure, Debug)
 		<< "exposureMSV " << exposureMSV << " mean " << meanLuminance
-		<< " highlights " << highlights << (backlit ? " (backlit)" : "")
+		<< " highlights " << highlights << " saturated " << saturated
+		<< " rest " << restLuminance
 		<< " error " << error << " factor " << factor
 		<< " exp " << exposure << " again " << again
 		<< " dgain " << dgain;
@@ -558,14 +578,12 @@ void Agc::process(IPAContext &context,
 			     std::exp2(-context.activeState.agc.exposureValue);
 	/*
 	 * Highlights: the samples that come out clipped (see clipLevel()),
-	 * and the dark ones (under kDarkShare of the target after the digital
-	 * gain), which tell a backlit subject.
+	 * and the mean of the rest, which tells a subject against the light
+	 * or a lamp in a dim room.
 	 */
-	const double dgainNow = context.activeState.agc.digitalGain;
 	const double clip = clipLevel(context) * histogramSize;
-	const double darkLevel = kTargetLuminance * kDarkShare * histogramSize;
-	uint64_t clipped = 0, dark = 0, all = 0;
-	double luminance = 0.0;
+	uint64_t clipped = 0, all = 0;
+	double luminance = 0.0, restSum = 0.0;
 	for (unsigned int i = 0; i < histogramSize; i++) {
 		const unsigned int gained = std::min<unsigned int>(
 			histogramSize - 1, static_cast<unsigned int>(std::lround(i * scale)));
@@ -573,17 +591,28 @@ void Agc::process(IPAContext &context,
 		const uint32_t n = histogram[blackLevelHistIdx + i];
 		exposureBins[idx] += n;
 
-		luminance += n * std::min(1.0, (i + 0.5) * scale / histogramSize);
+		const double value = n * std::min(1.0, (i + 0.5) * scale / histogramSize);
+		luminance += value;
 
 		if (i + 0.5 >= clip)
 			clipped += n;
-		if ((i + 0.5) * dgainNow < darkLevel)
-			dark += n;
+		else
+			restSum += value;
 		all += n;
 	}
-	const double highlights = all ? static_cast<double>(clipped) / all : 0.0;
 	const double meanLuminance = all ? luminance / all : 0.0;
-	const bool backlit = all && static_cast<double>(dark) / all >= kBacklitDarkShare;
+	const double restLuminance = all > clipped ? restSum / (all - clipped) : 0.0;
+
+	/*
+	 * What the sensor saturated counts too: a colour clipped there (a
+	 * blue sky) stays under the luminance histogram's top but comes out
+	 * white, in a ring shaped by the lens's vignetting.
+	 */
+	const uint64_t samples = std::accumulate(histogram.begin(), histogram.end(),
+						 uint64_t(0));
+	const double saturated = samples
+		? static_cast<double>(stats->saturatedCount) / samples : 0.0;
+	const double highlights = all ? static_cast<double>(clipped) / all : 0.0;
 
 	for (unsigned int i = 0; i < kExposureBinsCount; i++) {
 		LOG(IPASoftExposure, Debug) << i << ": " << exposureBins[i];
@@ -593,7 +622,8 @@ void Agc::process(IPAContext &context,
 
 	float exposureMSV = (denom == 0 ? 0 : static_cast<float>(num) / denom);
 	const bool adjusted = updateExposure(context, frameContext, exposureMSV,
-					     meanLuminance, highlights, backlit);
+					     meanLuminance, highlights, saturated,
+					     restLuminance);
 	if (adjusted)
 		context.activeState.agc.stableSamples = 0;
 	else
diff --git a/src/ipa/simple/algorithms/agc.h b/src/ipa/simple/algorithms/agc.h
index cb14766a1..b6c7408ee 100644
--- a/src/ipa/simple/algorithms/agc.h
+++ b/src/ipa/simple/algorithms/agc.h
@@ -34,7 +34,8 @@ private:
 	double clipLevel(const IPAContext &context) const;
 	bool updateExposure(IPAContext &context, IPAFrameContext &frameContext,
 			    double exposureMSV, double meanLuminance,
-			    double highlights, bool backlit);
+			    double highlights, double saturated,
+			    double restLuminance);
 };
 
 } /* namespace ipa::soft::algorithms */
