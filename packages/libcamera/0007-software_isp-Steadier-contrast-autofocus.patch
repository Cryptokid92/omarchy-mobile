+/*
+ * The fine scan samples every fine step, which at close range is coarse
+ * enough to leave a visibly soft result. Fit a parabola through the best
+ * sample and its neighbours and move to its vertex.
+ */
+int32_t Af::peakPosition(const IPAContext &context, int32_t best) const
+{
+	const auto it = std::find_if(fineSamples_.begin(), fineSamples_.end(),
+				     [best](const auto &sample) { return sample.first == best; });
+	if (it == fineSamples_.end() || it == fineSamples_.begin() ||
+	    std::next(it) == fineSamples_.end())
+		return best;
+
+	const double left = static_cast<double>(std::prev(it)->second);
+	const double centre = static_cast<double>(it->second);
+	const double right = static_cast<double>(std::next(it)->second);
+	const double curvature = left - 2.0 * centre + right;
+	if (curvature >= 0.0)
+		return best;
+
+	const int32_t step = context.configuration.focus.fineStep;
+	const double offset = std::clamp(0.5 * (left - right) / curvature, -0.5, 0.5);
+	return std::clamp(best + static_cast<int32_t>(std::lround(offset * step)),
+			  context.configuration.focus.min,
+			  context.configuration.focus.max);
+}
