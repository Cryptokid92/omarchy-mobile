 static constexpr unsigned int kAeStableSamples = 3;
+static constexpr unsigned int kScanDelayMaxSamples = 20;
+/* After a lock, continuous focus lets the lens settle before it watches. */
+static constexpr unsigned int kContinuousMonitorDelaySamples = 15;
+/*
+ * Continuous focus follows the sharpness smoothed over about eight frames, and
+ * scans again only once that has stayed below this share of its value at the
+ * lock for half a second: hand shake blurs a few frames at a time, which on a
+ * long lens used to start a new scan every few seconds.
