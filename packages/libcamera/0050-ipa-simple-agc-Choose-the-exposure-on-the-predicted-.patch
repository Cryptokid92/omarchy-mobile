-				 kShoulderShape;
-		x = kShoulderKnee + t * (kShoulderMax - kShoulderKnee);
+		const double t = std::min((x - kShoulderKnee) / (kShoulderMax - kShoulderKnee), 1.0);
+		x = kShoulderKnee + (1.0 - kShoulderKnee) *
+			(1.0 - std::exp(-kShoulderShape * t)) / (1.0 - std::exp(-kShoulderShape));
 	}
 
-	const auto &gains = context.activeState.awb.gains;
-	const double dgain = std::max(context.activeState.agc.digitalGain, 1.0);
-	if (gains.r() <= 0.0f || gains.g() <= 0.0f || gains.b() <= 0.0f)
-		return std::min(x / dgain, kSensorClip);
+	const double lift = knobs.toneLift;
+	if (lift > 0.0)
