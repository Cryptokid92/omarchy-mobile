+	const double e = std::tan(std::clamp(contrast * M_PI_4, 0.01, M_PI_2 - 0.00001));
+	x = std::clamp(x, 0.0, 1.0);
+	x = x < 0.5 ? 0.5 * std::pow(x / 0.5, e) : 1.0 - 0.5 * std::pow((1.0 - x) / 0.5, e);
