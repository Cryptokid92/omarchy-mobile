+/*
+ * The factor on the total exposure that the picture asks for (see
+ * kTargetOutput), with what the picture shows now.
+ */
+double Agc::exposureFactor(const IPAContext &context, const Metering &m,
+			   double &meanOut, double &clipped, double &saturated,
+			   double &factorMean, double &factorHighlights) const
+{
+	const auto &agc = context.activeState.agc;
+	const double ev = std::exp2(-agc.exposureValue);
+
+	const auto mean = [&](double f) {
+		double sum = 0.0;
+		for (const auto &[v, n] : m.luminance)
+			sum += n * encode(context, v * f);
+		return m.samples ? sum / m.samples : 0.0;
+	};
+
+	/* The linear level that comes out at sRGB 240. */
+	double lo = 0.0, hi = 4.0;
+	for (unsigned int i = 0; i < 30; i++) {
+		const double mid = (lo + hi) / 2;
+		(encode(context, mid) < kClippedOutput ? lo : hi) = mid;
+	}
+	const double clipLevel = hi;
+
+	const auto clippedAt = [&](double f) {
+		uint64_t n = 0;
+		for (const auto &[v, c] : m.luminance)
+			if (v * f >= clipLevel)
+				n += c;
+		return m.samples ? static_cast<double>(n) / m.samples : 0.0;
+	};
+	const auto saturatedAt = [&](double f) {
+		uint64_t n = 0;
+		for (const auto &[v, c] : m.peaks)
+			if (v * f >= kSensorClip)
+				n += c;
+		return m.peakSamples ? static_cast<double>(n) / m.peakSamples : 0.0;
+	};
+
+	meanOut = mean(1.0);
+	clipped = clippedAt(1.0);
+	saturated = saturatedAt(1.0);
+
+	/* Bisect in stops: the mean grows, and the shares never fall, with f. */
+	const auto bisect = [](auto &&below, double from, double to) {
+		for (unsigned int i = 0; i < 24; i++) {
+			const double mid = (from + to) / 2;
+			(below(std::exp2(mid)) ? from : to) = mid;
+		}
+		return std::exp2(from);
+	};
+	factorMean = bisect([&](double f) { return mean(f * ev) < kTargetOutput; },
+			    -8.0, 8.0);
+
+	/*
+	 * What still clips at the lowest exposure the protection may take is
+	 * a light source (a lamp, the sun) that no exposure saves: allow it on
+	 * top of the limits, rather than darken the room around it.
+	 */
+	const double lowest = factorMean * std::exp2(-kHighlightMaxCut);
+	const double evScale = std::exp2(std::max(0.0f, agc.exposureValue));
+	const double allowed = kHighlightMax * evScale + clippedAt(lowest);
+	const double allowedSaturated = kHighlightMax * evScale + saturatedAt(lowest);
+	factorHighlights = bisect([&](double f) {
+		return clippedAt(f) <= allowed && saturatedAt(f) <= allowedSaturated;
+	}, -8.0, 8.0);
+
+	return std::min(factorMean, std::max(factorHighlights, lowest));
 }
 
