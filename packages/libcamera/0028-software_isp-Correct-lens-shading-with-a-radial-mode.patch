diff --git a/src/ipa/simple/algorithms/lsc.cpp b/src/ipa/simple/algorithms/lsc.cpp
new file mode 100644
index 0000000..80ef5f8
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.cpp
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Radial lens shading correction for the simple software ISP
+ */
+
+#include "lsc.h"
+
+#include <vector>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/software_isp/debayer_params.h"
+
+#include "simple/ipa_context.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+namespace ipa::soft::algorithms {
+
+/**
+ * \class LensShading
+ * \brief A radial model of the lens's vignetting and colour shading
+ *
+ * Each colour is multiplied by 1 + k1 r^2 + k2 r^4, where r is the distance
+ * from the centre of the sensor's active area over half its diagonal, so the
+ * same coefficients serve every mode, binned or cropped. The tuning file
+ * gives the coefficients for red, green and blue:
+ *
+ *   - LensShading:
+ *       k1: [ r, g, b ]
+ *       k2: [ r, g, b ]
+ */
+
+int LensShading::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const auto k1 = tuningData["k1"].get<std::vector<float>>();
+	const auto k2 = tuningData["k2"].get<std::vector<float>>();
+	if (!k1 || k1->size() != 3 || (k2 && k2->size() != 3)) {
+		LOG(IPASoftLsc, Error) << "LensShading needs k1 (and k2) as [ r, g, b ]";
+		return -EINVAL;
+	}
+
+	k1_ = RGB<float>({ (*k1)[0], (*k1)[1], (*k1)[2] });
+	if (k2)
+		k2_ = RGB<float>({ (*k2)[0], (*k2)[1], (*k2)[2] });
+
+	context.ctrlMap[&controls::LensShadingCorrectionEnable] =
+		ControlInfo(false, true, true);
+
+	return 0;
+}
+
+void LensShading::queueRequest([[maybe_unused]] typename Module::Context &context,
+			       [[maybe_unused]] const uint32_t frame,
+			       [[maybe_unused]] typename Module::FrameContext &frameContext,
+			       const ControlList &controls)
+{
+	if (const auto enable = controls.get(controls::LensShadingCorrectionEnable))
+		enabled_ = *enable;
+}
+
+void LensShading::prepare(IPAContext &context,
+			  [[maybe_unused]] const uint32_t frame,
+			  [[maybe_unused]] IPAFrameContext &frameContext,
+			  DebayerParams *params)
+{
+	if (!enabled_) {
+		params->lscK1 = RGB<float>({ 0.0f, 0.0f, 0.0f });
+		params->lscK2 = RGB<float>({ 0.0f, 0.0f, 0.0f });
+		return;
+	}
+
+	/*
+	 * The input covers the mode's analogue crop of the active area:
+	 * scale a position in fractions of the input to one in half
+	 * diagonals of the active area.
+	 */
+	const IPACameraSensorInfo &info = context.sensorInfo;
+	const double aw = info.activeAreaSize.width;
+	const double ah = info.activeAreaSize.height;
+	double cw = info.analogCrop.width;
+	double ch = info.analogCrop.height;
+	if (!cw || !ch) {
+		cw = aw;
+		ch = ah;
+	}
+	const double diagonal2 = (aw * aw + ah * ah) / 4.0;
+	if (diagonal2 > 0.0)
+		params->lscScale = { static_cast<float>(cw * cw / diagonal2),
+				     static_cast<float>(ch * ch / diagonal2) };
+
+	params->lscK1 = k1_;
+	params->lscK2 = k2_;
+}
+
+void LensShading::process([[maybe_unused]] IPAContext &context,
+			  [[maybe_unused]] const uint32_t frame,
+			  [[maybe_unused]] IPAFrameContext &frameContext,
+			  [[maybe_unused]] const SwIspStats *stats,
+			  ControlList &metadata)
+{
+	metadata.set(controls::LensShadingCorrectionEnable, enabled_);
+}
+
+REGISTER_IPA_ALGORITHM(LensShading, "LensShading")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/lsc.h b/src/ipa/simple/algorithms/lsc.h
new file mode 100644
index 0000000..2676bbb
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Radial lens shading correction for the simple software ISP
+ */
+
+#pragma once
+
+#include "libcamera/internal/vector.h"
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class LensShading : public Algorithm
+{
+public:
+	LensShading() = default;
+	~LensShading() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	RGB<float> k1_ = RGB<float>({ 0.0f, 0.0f, 0.0f });
+	RGB<float> k2_ = RGB<float>({ 0.0f, 0.0f, 0.0f });
+	bool enabled_ = true;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
