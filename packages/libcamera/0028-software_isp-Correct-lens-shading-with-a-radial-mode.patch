@@ -29,6 +29,11 @@ uniform mat3            ccm;
 uniform vec3            blacklevel;
 uniform float           gamma;
 uniform float           contrastExp;
+uniform vec2            tex_size;
+uniform vec2            tex_bayer_first_red;
+uniform vec3            lsc_k1;
+uniform vec3            lsc_k2;
+uniform vec2            lsc_scale;
 
 float apply_contrast(float value)
 {
@@ -135,6 +140,11 @@ void main(void) {
      */
     rgb = (rgb - blacklevel) / (1.0 - blacklevel);
 
+    /* Lens shading: a radial gain from the centre of the sensor */
+    vec2 lsc_p = (center.zw - tex_bayer_first_red + 0.5) / tex_size - 0.5;
+    float lsc_r2 = dot(lsc_p * lsc_p, lsc_scale);
+    rgb *= 1.0 + lsc_r2 * (lsc_k1 + lsc_r2 * lsc_k2);
+
     /* Apply AWB gains, and saturate each channel at sensor range */
     rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
 
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index fe3fe28..ce8e961 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -121,6 +121,9 @@ int DebayerEGL::getShaderVariableLocations(void)
 	blackLevelUniformDataIn_ = glGetUniformLocation(programId_, "blacklevel");
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
+	lscK1UniformDataIn_ = glGetUniformLocation(programId_, "lsc_k1");
+	lscK2UniformDataIn_ = glGetUniformLocation(programId_, "lsc_k2");
+	lscScaleUniformDataIn_ = glGetUniformLocation(programId_, "lsc_scale");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -515,6 +518,13 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	glUniform1f(contrastExpUniformDataIn_, params.contrastExp);
 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
+	/*
+	 * Lens shading
+	 */
+	glUniform3f(lscK1UniformDataIn_, params.lscK1[0], params.lscK1[1], params.lscK1[2]);
+	glUniform3f(lscK2UniformDataIn_, params.lscK2[0], params.lscK2[1], params.lscK2[2]);
+	glUniform2f(lscScaleUniformDataIn_, params.lscScale[0], params.lscScale[1]);
+
 	return;
 }
 
