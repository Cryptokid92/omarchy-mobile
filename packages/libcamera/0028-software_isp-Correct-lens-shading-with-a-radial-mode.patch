--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -70,6 +70,9 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+uniform vec3 lsc_k1;
+uniform vec3 lsc_k2;
+uniform vec2 lsc_scale;
 
 float apply_contrast(float value)
 {
@@ -232,6 +235,11 @@ void main(void)
 	 */
 	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
 
+	/* Lens shading: a radial gain from the centre of the sensor */
+	vec2 lsc_p = (center_pixel + 0.5) / tex_size - 0.5;
+	float lsc_r2 = dot(lsc_p * lsc_p, lsc_scale);
+	rgb *= 1.0 + lsc_r2 * (lsc_k1 + lsc_r2 * lsc_k2);
+
 	/* Apply AWB gains, and saturate each channel at sensor range */
 	rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
 
