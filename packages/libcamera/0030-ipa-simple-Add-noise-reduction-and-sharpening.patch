+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Noise reduction and sharpening for the simple software ISP
+ */
+
+#include "detail.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/software_isp/debayer_params.h"
+
+#include "simple/ipa_context.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftDetail)
+
+namespace ipa::soft::algorithms {
+
+/**
+ * \class Detail
+ * \brief Luma noise reduction and sharpening, scaled with the gain
+ *
+ * The GPU debayer's second pass smooths the luma with an edge-preserving
+ * (bilateral) 3x3 filter and sharpens it with an unsharp mask, cored by the
+ * noise level. Noise grows with the gain, so the smoothing grows with it and
+ * the sharpening falls:
+ *
+ *   denoise = denoise_base * sqrt(gain), at most kDenoiseMax
+ *   sharpen = sharpen_base * Sharpness / (1 + log2(gain) / 3)
+ *
+ * where gain is the analogue gain times the digital gain. The tuning file
+ * gives the bases, and its absence leaves the picture untouched:
+ *
+ *   - Detail:
+ *       sharpen: 0.6
+ *       denoise: 0.015
+ */
+
+static constexpr float kDenoiseMax = 0.15f;
+static constexpr float kSharpnessMax = 4.0f;
+
+int Detail::init(IPAContext &context, const ValueNode &tuningData)
+{
+	sharpen_ = std::clamp(tuningData["sharpen"].get<float>().value_or(0.6f), 0.0f, 4.0f);
+	denoise_ = std::clamp(tuningData["denoise"].get<float>().value_or(0.015f), 0.0f,
+			      kDenoiseMax);
+
+	context.ctrlMap[&controls::Sharpness] = ControlInfo(0.0f, kSharpnessMax, 1.0f);
+
+	return 0;
+}
+
+void Detail::queueRequest([[maybe_unused]] typename Module::Context &context,
+			  [[maybe_unused]] const uint32_t frame,
+			  [[maybe_unused]] typename Module::FrameContext &frameContext,
+			  const ControlList &controls)
+{
+	if (const auto sharpness = controls.get(controls::Sharpness))
+		sharpness_ = std::clamp(*sharpness, 0.0f, kSharpnessMax);
+}
+
+void Detail::prepare(IPAContext &context,
+		     [[maybe_unused]] const uint32_t frame,
+		     [[maybe_unused]] IPAFrameContext &frameContext,
+		     DebayerParams *params)
+{
+	const auto &agc = context.activeState.agc;
+	const double gain = std::max(1.0, (agc.again > 0.0 ? agc.again : 1.0) *
+						  std::max(agc.digitalGain, 1.0));
+
+	params->denoise = std::min(static_cast<float>(denoise_ * std::sqrt(gain)),
+				   kDenoiseMax);
+	params->sharpen = static_cast<float>(sharpen_ * sharpness_ /
+					     (1.0 + std::log2(gain) / 3.0));
+}
+
+void Detail::process([[maybe_unused]] IPAContext &context,
+		     [[maybe_unused]] const uint32_t frame,
+		     [[maybe_unused]] IPAFrameContext &frameContext,
+		     [[maybe_unused]] const SwIspStats *stats,
+		     ControlList &metadata)
+{
+	metadata.set(controls::Sharpness, sharpness_);
+}
+
+REGISTER_IPA_ALGORITHM(Detail, "Detail")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
