From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Tue, 13 Oct 2026 12:03:27 -0400
Subject: [PATCH 04/12] libcamera: Add the Samsung S5KGN1 sensor

The S5KGN1 is the main camera of the Google Pixel 7 Pro, captured
through the gs201 CSIS receiver and the simple pipeline handler with the
software ISP.

Add a camera sensor helper with a black level of 64 at 10 bits and the
sensor's linear analogue gain, code / 32 (0x20 is 1x, 0x200 is 16x).
Add the sensor properties: the 1.2 um unit cell from Samsung's public
specification and two-frame control delays. The test pattern numbering
is not known, so no test pattern modes are listed. Add an uncalibrated
tuning file for the simple IPA under the sensor's name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ipa/libipa/camera_sensor_helper.cpp           | 13 +++++++++++++
 src/ipa/simple/data/meson.build                   |  1 +
 src/ipa/simple/data/s5kgn1.yaml                   | 13 +++++++++++++
 src/libcamera/sensor/camera_sensor_properties.cpp | 10 ++++++++++
 4 files changed, 37 insertions(+)
 create mode 100644 src/ipa/simple/data/s5kgn1.yaml

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index ac1acdc..734be09 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -844,6 +844,19 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13858", CameraSensorHelperOv13858)
 
+class CameraSensorHelperS5kgn1 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5kgn1()
+	{
+		/* 64 at 10 bits. */
+		blackLevel_ = 4096;
+		/* Code / 32: 0x20 is 1x, 0x200 is 16x. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5kgn1", CameraSensorHelperS5kgn1)
+
 class CameraSensorHelperVd55g1 : public CameraSensorHelper
 {
 public:
