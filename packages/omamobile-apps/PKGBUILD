# The apps a phone needs that a desktop Omarchy doesn't ship. An app joins
# `depends` once the hardware behind it works on Omarchy Mobile; until then it
# waits in `optdepends` with the reason, so the default install never shows
# an app that can't work yet.
pkgname=omamobile-apps
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile's default mobile apps (maps and location, NFC tags)"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(
  gnome-maps   # location through GeoClue (omamobile-gnss feeds it the GPS)
  geoclue
  neard        # NFC tags; omamobile-shell's omamobile-nfc-open opens their web links
)
optdepends=(
  'snapshot: camera (waits for the camera capture path, CAMERA-PLAN CAM4, and libcamera)'
  'gnome-calls: phone calls (waits for the modem, MODEM-PLAN M4, and a client for its RIL)'
  'chatty: SMS (waits for the modem, as gnome-calls)'
)
