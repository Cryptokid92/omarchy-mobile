#!/bin/bash
# SPDX-License-Identifier: MIT
# Omarchy Mobile (on PATH only during omamobile-update). From the update sheet
# nobody can answer a password prompt: sudo answers from the timestamp
# omamobile-update set when the update started (and keeps fresh), or fails at
# once instead of waiting on a prompt nobody sees.
if [[ ${OMAMOBILE_UPDATE_NONINTERACTIVE:-} == 1 ]]; then
  exec "${OMAMOBILE_SUDO:-/usr/bin/sudo}" -n "$@"
fi
exec "${OMAMOBILE_SUDO:-/usr/bin/sudo}" "$@"
