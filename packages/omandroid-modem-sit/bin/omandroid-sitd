#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# omandroid-sitd: the SIT modem client daemon (lib/sitd.py). Runs from the
# package tree and from a staged tree too: a copy next to bin/ wins over the
# installed one.
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for d in (os.path.join(here, "..", "lib"), os.path.join(here, "..", "lib", "omandroid-sit"),
          "/usr/lib/omandroid-sit"):
    if os.path.exists(os.path.join(d, "sitd.py")):
        sys.path.insert(0, d)
        break
import sitd  # noqa: E402

sitd.main()
