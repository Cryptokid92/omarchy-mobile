#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""omandroid-sit: talk to omandroid-sitd over its control socket.

  omandroid-sit status [--json]      the modem's state (no identifiers)
  omandroid-sit watch                state as JSON lines, one per change
  omandroid-sit data on|off          the mobile data switch
  omandroid-sit radio on|off
  omandroid-sit sms send NUMBER TEXT send one SMS (only ever on this request)
  omandroid-sit sms list | sms delete ID
  omandroid-sit pin                  read a SIM PIN from the terminal (needs
                                     omandroid-sitd --allow-pin; refused with
                                     one try left)
"""
import getpass
import json
import os
import socket
import sys

RUN = os.environ.get("OMANDROID_SIT_RUN", "/run/omandroid-sit")


def connect():
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(os.path.join(RUN, "control"))
    except OSError:
        return None
    return s


def call(req, timeout=60):
    s = connect()
    if s is None:
        return {"ok": False, "error": "omandroid-sitd is not running"}
    s.settimeout(timeout)
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    return json.loads(buf) if buf else {"ok": False, "error": "no reply"}


def summary(st):
    if not st:
        return "No modem"
    data, reg = st.get("data", {}), st.get("data_reg", {})
    op = st.get("operator", {})
    lines = [
        "daemon: %s, CP: %s, radio: %s" % (st.get("daemon"), st.get("cp"), st.get("radio")),
        "SIM: %s%s" % (st["sim"].get("state"), " (PIN1 tries left: %s)" % st["sim"]["pin1_retries"]
                       if "pin1_retries" in st["sim"] else ""),
        "voice: %s %s; data: %s %s" % (st["voice"].get("reg"), st["voice"].get("rat"),
                                         reg.get("reg"), reg.get("rat")),
        "operator: %s" % ((op.get("long") or op.get("short") or "-") + (" (%s)" % op["plmn"] if op.get("plmn") else "")),
        "mobile data: %s, %s%s" % ("on" if data.get("enabled") else "off", data.get("state"),
                                   " on %s" % data["iface"] if data.get("iface") else "")
        + (" (%s)" % data["error"] if data.get("error") else ""),
        "SMS received: %s" % st.get("sms", {}).get("received", 0),
    ]
    return "\n".join(lines)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "status":
        r = call({"cmd": "status"}, timeout=5)
        st = r.get("state") if r.get("ok") else None
        if st is None:
            # the daemon is down: fall back to the last published state
            try:
                with open(os.path.join(RUN, "state.json")) as f:
                    st = json.load(f)
                if st.get("daemon") != "stopped":
                    st["daemon"] = "not responding"
            except (OSError, ValueError):
                st = None
        if "--json" in rest:
            print(json.dumps(st or {"daemon": "absent"}))
        else:
            print(summary(st))
        return 0 if st else 1
    if cmd == "watch":
        s = connect()
        if s is None:
            print("omandroid-sitd is not running", file=sys.stderr)
            return 1
        s.sendall(b'{"cmd": "watch"}\n')
        f = s.makefile("r")
        for line in f:
            print(line, end="", flush=True)
        return 0
    if cmd in ("data", "radio") and rest and rest[0] in ("on", "off"):
        on = rest[0] == "on"
        r = call({"cmd": "data", "enable": on} if cmd == "data" else {"cmd": "radio", "on": on})
    elif cmd == "sms" and rest[:1] == ["send"] and len(rest) == 3:
        r = call({"cmd": "sms-send", "to": rest[1], "text": rest[2]})
    elif cmd == "sms" and rest[:1] == ["list"]:
        r = call({"cmd": "sms-list"})
        if r.get("ok"):
            for m in r["messages"]:
                print("%s  %s  %s\n  %s" % (m["id"], m.get("sent") or m.get("received"), m["from"], m["text"]))
            return 0
    elif cmd == "sms" and rest[:1] == ["delete"] and len(rest) == 2:
        r = call({"cmd": "sms-delete", "id": rest[1]})
    elif cmd == "pin":
        r = call({"cmd": "pin", "pin": getpass.getpass("SIM PIN: ")})
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if not r.get("ok"):
        print("omandroid-sit: %s" % r.get("error"), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
