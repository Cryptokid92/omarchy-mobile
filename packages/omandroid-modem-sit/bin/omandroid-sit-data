#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# omandroid-sit-data: the cellular fallback route on rmnet0 (lib/data_network.py).
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for d in (os.path.join(here, "..", "lib"), os.path.join(here, "..", "lib", "omandroid-sit"),
          "/usr/lib/omandroid-sit"):
    if os.path.exists(os.path.join(d, "data_network.py")):
        sys.path.insert(0, d)
        break
import data_network  # noqa: E402

data_network.main()
