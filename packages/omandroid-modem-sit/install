#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omandroid-modem-sit into DESTDIR. Enables nothing.
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 bin/omandroid-sitd "$d/usr/bin/omandroid-sitd"
install -Dm755 bin/omandroid-sit "$d/usr/bin/omandroid-sit"
for f in lib/*.py; do install -Dm644 "$f" "$d/usr/lib/omandroid-sit/${f#lib/}"; done
install -Dm644 systemd/omandroid-sitd.service "$d/usr/lib/systemd/system/omandroid-sitd.service"
install -Dm644 etc/omandroid/modem-sit.conf "$d/etc/omandroid/modem-sit.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omandroid-modem-sit/LICENSE"
install -Dm644 version "$d/usr/share/omandroid/modem-sit/version"
