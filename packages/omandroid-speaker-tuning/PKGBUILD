pkgname=omandroid-speaker-tuning
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omandroid speaker tuning for the Pixel 7 Pro: Waves on the AoC, configured from the user's own vendor files"
arch=(aarch64)
url="https://github.com/derekross/omandroid"
license=(MIT)
depends=(bash python python-gobject coreutils util-linux alsa-utils systemd omandroid-audio)
backup=(etc/omandroid/speaker-tuning.conf)

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
