# Stock's speaker tuning (Waves MaxxAudio on the AoC), sent by
# omandroid-speaker-tuning (device/cheetah/AOC-TUNING-RESEARCH.md). Bound to
# the speaker protection watchdog: it runs only while the watchdog runs and
# stops with it. With OMANDROID_SPK_TUNING=off (the default) it exits at
# once. Not enabled by the package; once T4 has passed:
#   systemctl enable omandroid-speaker-tuning
[Unit]
Description=Speaker tuning (Waves on the AoC)
BindsTo=omandroid-speaker-watch.service
After=omandroid-speaker-watch.service omandroid-aoc.service
ConditionPathExists=/sys/bus/platform/devices/181d0000.aoc

[Service]
Type=simple
EnvironmentFile=-/etc/omandroid/speaker.conf
EnvironmentFile=-/etc/omandroid/speaker-tuning.conf
ExecStart=/usr/bin/omandroid-speaker-tuning run
Restart=on-failure
RestartSec=10
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=omandroid-speaker-watch.service
