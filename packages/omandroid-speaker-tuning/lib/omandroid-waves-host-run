#!/bin/bash
# SPDX-License-Identifier: MIT
# omandroid-waves-host-run: start omandroid-waves-host in the "waves" vendor
# chroot, with stdin and stdout passed through (omandroid-speaker-tuning
# talks to it over them).
#
#   omandroid-waves-host-run check        preconditions only
#   omandroid-waves-host-run [ARGS...]    run the helper (ARGS go to it)
#
# The chroot is read-only and as small as the helper needs: the image from
# tools/extract-vendor-chroot -p waves (Waves' two libraries, their preset
# and config files, bionic and liblog), the helper itself, /proc, a private
# /tmp, and a /dev with null, zero and urandom only. No AoC devices, no
# block devices, no binder, no properties, and no network (a new, empty
# network namespace). The helper runs as nobody with no_new_privs, as PID 1
# of its own PID namespace: when it exits, everything in the chroot ends.
#
# Environment (tests): OMANDROID_WAVES_IMAGE, OMANDROID_WAVES_HOST,
# OMANDROID_WAVES_USER (uid:gid, default 65534:65534; empty: stay as the
# caller, for an unprivileged test in a user namespace), OMANDROID_WAVES_RUN.
set -euo pipefail

IMAGE=${OMANDROID_WAVES_IMAGE:-/usr/lib/omandroid-vendor/waves/root}
HOST=${OMANDROID_WAVES_HOST:-/usr/lib/omandroid-speaker-tuning/omandroid-waves-host}
USERSPEC=${OMANDROID_WAVES_USER-65534:65534}
RUN=${OMANDROID_WAVES_RUN:-/run/omandroid-waves}

say() { printf 'omandroid-waves-host-run: %s\n' "$*" >&2; }
die() { say "error: $*"; exit 1; }

# Host tools by absolute path: the helper's environment is Android's.
CHROOT_BIN=$(PATH=/usr/bin:/bin:/usr/sbin:/sbin command -v chroot || true)
SETPRIV_BIN=$(PATH=/usr/bin:/bin:/usr/sbin:/sbin command -v setpriv || true)

check() {
  local ok=1 f
  [[ -x $CHROOT_BIN ]] || { say "no chroot(1) (coreutils)"; ok=0; }
  [[ -x $SETPRIV_BIN ]] || { say "no setpriv(1) (util-linux)"; ok=0; }
  [[ -x $HOST ]] || { say "no helper at $HOST (make -C packages/omandroid-speaker-tuning/bionic)"; ok=0; }
  for f in apex/com.android.runtime/bin/linker64 vendor/lib64/libmahalcontroller.so \
           vendor/lib64/libAlgFx_HiFi3z.so vendor/etc/waves_preset.mps vendor/etc/waves_config.ini; do
    [[ -e $IMAGE/$f ]] || { say "no $f in $IMAGE (tools/extract-vendor-chroot -p waves)"; ok=0; }
  done
  ((ok)) || return 1
  say "preconditions met"
}

bind() { # $1 source, $2 target (created to match), read-only
  if [[ -d $1 ]]; then mkdir -p "$2"; else mkdir -p "$(dirname "$2")"; : > "$2"; fi
  mount --bind "$1" "$2"
  mount -o remount,bind,ro "$2"
}

if [[ ${1:-} == check ]]; then
  check
  exit
fi

if [[ -z ${OMANDROID_WAVES_IN_NS:-} ]]; then
  check 2>/dev/null || { check || true; die "preconditions not met"; }
  mkdir -p "$RUN"
  exec unshare --mount --propagation private --pid --fork --kill-child \
    --net --ipc --uts env OMANDROID_WAVES_IN_NS=1 "$0" "$@"
fi

# In the new namespaces: build the chroot on a private tmpfs.
ROOT=$RUN/root
mkdir -p "$ROOT"
mount -t tmpfs -o mode=0755,nosuid,nodev omandroid-waves "$ROOT"
for d in system vendor apex; do bind "$IMAGE/$d" "$ROOT/$d"; done
bind "$HOST" "$ROOT/omandroid/bin/omandroid-waves-host"
mkdir -p "$ROOT/proc" "$ROOT/dev" "$ROOT/tmp" "$ROOT/data" "$ROOT/linkerconfig"
mount -t proc -o nosuid,nodev,noexec proc "$ROOT/proc"
mount -t tmpfs -o mode=1777,nosuid,nodev,noexec tmp "$ROOT/tmp"
mount -t tmpfs -o mode=0755,nosuid,noexec dev "$ROOT/dev"
for n in null zero urandom; do
  : > "$ROOT/dev/$n"
  mount --bind "/dev/$n" "$ROOT/dev/$n"
done
mount -o remount,ro,bind "$ROOT/dev"
ln -s /system/bin "$ROOT/bin"
ln -s /system/etc "$ROOT/etc" 2>/dev/null || true
mount -o remount,ro,bind "$ROOT"

USER_ARGS=()
[[ -n $USERSPEC ]] && USER_ARGS=(--userspec="$USERSPEC" --groups=65534)
exec env -i PATH=/system/bin \
  LD_LIBRARY_PATH=/vendor/lib64:/system/lib64 \
  ANDROID_ROOT=/system ANDROID_DATA=/data \
  OMANDROID_WAVES_LOGLEVEL="${OMANDROID_WAVES_LOGLEVEL:-5}" \
  "$SETPRIV_BIN" --no-new-privs \
  "$CHROOT_BIN" "${USER_ARGS[@]}" "$ROOT" \
  /omandroid/bin/omandroid-waves-host "$@"
