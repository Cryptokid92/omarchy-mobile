#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omandroid-speaker-tuning: the AoC protocol and its allowlist
# against a fake AoC (socket pairs that check the framing and refuse other
# blocks), the helper protocol against test/fake-waves-host (including a
# helper that breaks it), the daemon's triggers, and the staged layout.
# Nothing here needs the phone, Google's files or a bionic toolchain.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
export PYTHONDONTWRITEBYTECODE=1

bash -n install || fail "install parses"
bash -n lib/omandroid-waves-host-run || fail "the chroot runner parses"
for f in bin/omandroid-speaker-tuning lib/*.py test/*.py test/fake-waves-host; do
  python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$f" || fail "$f parses"
done
pass "scripts parse"

out=$(python3 -W ignore::ResourceWarning -m unittest -q test/test_tuning.py 2>&1) || {
  printf '%s\n' "$out" >&2; fail "unit tests"; }
pass "protocol, allowlist, fake AoC, helper protocol, tuner, triggers"

# The helper source: no Google or Waves headers, nothing linked but bionic.
grep -E '^#include' bionic/omandroid-waves-host.c | grep -vE '<(dlfcn|errno|limits|pthread|stdarg|stdbool|stdint|stdio|stdlib|string|time|unistd)\.h>' &&
  fail "the helper includes something beyond libc"
grep -q -- '-ldl$' bionic/Makefile || fail "the helper links only libc and libdl"
pass "helper source"

# Staged layout, with a stand-in for the helper binary if it isn't built.
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
cp -a . "$tmp/src"
if [[ ! -f $tmp/src/bionic/prebuilt/omandroid-waves-host ]]; then
  mkdir -p "$tmp/src/bionic/prebuilt"; : > "$tmp/src/bionic/prebuilt/omandroid-waves-host"
fi
"$tmp/src/install" "$tmp/stage"
for f in usr/bin/omandroid-speaker-tuning usr/lib/omandroid-speaker-tuning/speaker_tuning.py \
         usr/lib/omandroid-speaker-tuning/aoc_tuning.py usr/lib/omandroid-speaker-tuning/waves_host.py \
         usr/lib/omandroid-speaker-tuning/omandroid-waves-host-run \
         usr/lib/omandroid-speaker-tuning/omandroid-waves-host \
         usr/lib/systemd/system/omandroid-speaker-tuning.service etc/omandroid/speaker-tuning.conf \
         usr/share/licenses/omandroid-speaker-tuning/LICENSE; do
  [[ -e $tmp/stage/$f ]] || fail "staged $f"
done
python3 "$tmp/stage/usr/bin/omandroid-speaker-tuning" --help >/dev/null || fail "the staged daemon imports its library"
[[ -z $(find "$tmp/stage" -name '*.so' -o -name '*.mps' -o -name '*.ini') ]] || fail "nothing of Google's or Waves' is staged"
grep -q '^#OMANDROID_SPK_TUNING=off' etc/omandroid/speaker-tuning.conf || fail "tuning is off by default"
if command -v systemd-analyze >/dev/null; then
  systemd-analyze verify --man=no "$tmp/stage/usr/lib/systemd/system/omandroid-speaker-tuning.service" 2>&1 |
    grep -v -e 'not executable' -e 'No such file' -e 'omandroid-speaker-watch' -e 'omandroid-aoc' -e '^$' && fail "unit verify" || true
fi
pass "staged layout, config and unit"

# Mode off: the daemon exits at once without starting the helper.
OMANDROID_SPK_TUNING=off OMANDROID_RUN=$tmp/run OMANDROID_SPK_TUNING_HELPER=/nonexistent \
  python3 bin/omandroid-speaker-tuning run 2>/dev/null || fail "mode off exits cleanly"
[[ $(cat "$tmp/run/speaker-tuning") == off ]] || fail "mode off writes its state"
pass "mode off"
