#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""omandroid-speaker-tuning: stock's Waves speaker tuning, sent to the AoC.

  omandroid-speaker-tuning run [--dry-run [--dry-reply RC]] [--once] [--angle DEG]
                               [--mode off|throttle|music] [--record DIR]
  omandroid-speaker-tuning status

run       the daemon (omandroid-speaker-tuning.service). --dry-run starts the
          helper and the controller but opens no AoC device: it logs what it
          would send and answers the controller with RC (default -110, a
          timeout). --once sends the configured state once, now, and exits
          (no stream detection; a live --once still needs the speaker
          watchdog active and the AoC DSP in playback, as every send does). --record keeps every exchange under DIR (root only;
          for the determinism check, AOC-TUNING-RESEARCH.md T5; never commit).
status    the daemon's state (/run/omandroid/speaker-tuning) and the setup.

The mode comes from OMANDROID_SPK_TUNING (off, throttle, music; default
off) in /etc/omandroid/speaker.conf or speaker-tuning.conf; --mode overrides
it. device/cheetah/AOC-TUNING-RESEARCH.md.
"""
import argparse
import os
import signal
import subprocess
import sys

_here = os.path.dirname(os.path.abspath(__file__))
for d in (os.path.join(_here, '..', 'lib'),                             # the source tree
          os.path.join(_here, '..', 'lib', 'omandroid-speaker-tuning'),  # installed (staged)
          '/usr/lib/omandroid-speaker-tuning'):
    if os.path.isfile(os.path.join(d, 'speaker_tuning.py')):
        sys.path.insert(0, d)
        break

import speaker_tuning as st  # noqa: E402
from aoc_tuning import AocTuningPort  # noqa: E402
from waves_host import WavesHost  # noqa: E402


def gate_for(cfg):
    playback = st.Playback(cfg.asound)

    def gate():
        if not st.watch_active():
            return f'{st.WATCH_UNIT} is not active'
        # as stock: tuning goes to the AoC only while its DSP plays
        dsp = playback.dsp_state()
        if dsp != 'Playback':
            return f'the AoC DSP is {dsp or "in an unknown state"}, not in playback (stock sends only then)'
        if cfg.mode == 'music' and not os.path.isfile(cfg.stamp):
            return f'music needs the protection verification stamp ({cfg.stamp}, AOC-PLAN.md C9a)'
        return None
    return gate


def cmd_run(args):
    env = dict(os.environ)
    if args.mode:
        env['OMANDROID_SPK_TUNING'] = args.mode
    cfg = st.Config(env)
    if args.angle is not None and args.angle not in (0, 90, 180, 270):
        sys.exit('--angle: 0, 90, 180 or 270')
    if args.record:
        args.record = os.path.abspath(args.record)

    def host_factory():
        h = WavesHost([cfg.helper], log=st.log)
        h.start()
        return h

    port = None if args.dry_run else AocTuningPort(log=st.log)
    tuner = st.Tuner(cfg, host_factory, port, gate_for(cfg), dry_run=args.dry_run,
                     dry_rc=args.dry_reply, record=args.record)
    if args.dry_run:
        st.log('dry run: no AoC device is opened')
    if args.once:
        if cfg.mode == 'off':
            st.log('mode off: nothing to send (use --mode throttle or music)')
            return 1
        try:
            ok = tuner.send(args.angle or 0)
        finally:
            tuner.stop()
        st.log(f'{tuner.exchanges} exchange(s), {tuner.errors} not accepted; state: {tuner.state}')
        return 0 if ok else 1

    daemon = st.Daemon(cfg, tuner, st.Playback(cfg.asound), st.AocRestarts(cfg.aoc_dev, cfg.aoc_marker))

    def stop(*_):
        daemon.stopping = True
        os.write(daemon.wake_w, b'.')
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    return daemon.run()


def cmd_status(_args):
    cfg = st.Config()
    try:
        with open(cfg.state_file) as f:
            state = f.read().strip()
    except OSError:
        state = 'not running'
    print(f'state: {state}')
    print(f'mode: {cfg.mode} ({st.PRESETS.get(cfg.mode, "nothing sent")})')
    print(f'watchdog ({st.WATCH_UNIT}): {"active" if st.watch_active() else "not active"}')
    print(f'verification stamp: {"present" if os.path.isfile(cfg.stamp) else "absent"}')
    r = subprocess.run([cfg.helper, 'check'], capture_output=True, text=True)
    print(f'helper: {(r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else r.returncode}')
    return 0


def main():
    ap = argparse.ArgumentParser(prog='omandroid-speaker-tuning', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)
    r = sub.add_parser('run')
    r.add_argument('--dry-run', action='store_true')
    r.add_argument('--dry-reply', type=int, default=st.ETIMEDOUT)
    r.add_argument('--once', action='store_true')
    r.add_argument('--angle', type=int)
    r.add_argument('--mode', choices=st.MODES)
    r.add_argument('--record')
    sub.add_parser('status')
    args = ap.parse_args()
    if args.cmd == 'run':
        if args.dry_reply > 0 or args.dry_reply < -4095:
            ap.error('--dry-reply: 0 or a negative errno')
        try:
            return cmd_run(args)
        except ValueError as e:
            st.log(f'configuration: {e}')
            return 2
    return cmd_status(args)


if __name__ == '__main__':
    sys.exit(main())
