#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omandroid-speaker-tuning into DESTDIR. Enables nothing, and ships
# nothing of Google's or Waves': the "waves" vendor-chroot tree is built by
# the user from their own factory image (tools/extract-vendor-chroot -p
# waves) and installed by hand under /usr/lib/omandroid-vendor/waves.
# The bionic helper is built on the computer first:
#   make -C bionic NDK=...
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
host=bionic/prebuilt/omandroid-waves-host
[[ -f $host ]] || { echo "no $host: make -C bionic NDK=... first" >&2; exit 1; }
install -Dm755 bin/omandroid-speaker-tuning "$d/usr/bin/omandroid-speaker-tuning"
for f in lib/*.py; do install -Dm644 "$f" "$d/usr/lib/omandroid-speaker-tuning/${f#lib/}"; done
install -Dm755 lib/omandroid-waves-host-run "$d/usr/lib/omandroid-speaker-tuning/omandroid-waves-host-run"
install -Dm755 "$host" "$d/usr/lib/omandroid-speaker-tuning/omandroid-waves-host"
install -Dm644 systemd/omandroid-speaker-tuning.service "$d/usr/lib/systemd/system/omandroid-speaker-tuning.service"
install -Dm644 etc/omandroid/speaker-tuning.conf "$d/etc/omandroid/speaker-tuning.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omandroid-speaker-tuning/LICENSE"
install -Dm644 version "$d/usr/share/omandroid/speaker-tuning/version"
