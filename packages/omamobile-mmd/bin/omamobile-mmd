#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# omamobile-mmd: the ModemManager-compatible bridge (lib/main.py). Runs from
# the package tree and from a staged tree: a copy next to bin/ wins over the
# installed one.
import os
import sys
import warnings

here = os.path.dirname(os.path.realpath(__file__))
for d in (os.path.join(here, "..", "lib"), os.path.join(here, "..", "lib", "omamobile-mmd"),
          "/usr/lib/omamobile-mmd"):
    if os.path.exists(os.path.join(d, "bridge.py")):
        sys.path.insert(0, d)
        break
# PyGObject's deprecation notices for GLib names it renamed are not ours.
warnings.filterwarnings("ignore", category=DeprecationWarning)
import gi  # noqa: E402

gi.require_version("Gio", "2.0")
import main  # noqa: E402

sys.exit(main.main())
