#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omandroid-sensors into DESTDIR. Enables nothing.
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for f in lib/*.py; do install -Dm644 "$f" "$d/usr/lib/omandroid-sensors/${f##*/}"; done
for f in bin/*; do install -Dm755 "$f" "$d/usr/bin/${f##*/}"; done
install -Dm644 systemd/omandroid-sensor-proxy.service "$d/usr/lib/systemd/system/omandroid-sensor-proxy.service"
install -Dm644 systemd/omandroid-autorotate.service "$d/usr/lib/systemd/user/omandroid-autorotate.service"
install -Dm644 dbus/net.hadess.SensorProxy.conf "$d/usr/share/dbus-1/system.d/net.hadess.SensorProxy.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omandroid-sensors/LICENSE"
