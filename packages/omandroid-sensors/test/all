#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omandroid-sensors, from a copy of this directory alone.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

for f in lib/*.py; do python3 -m py_compile "$f" || fail "$f compiles"; done
pass "python compiles"

python3 -I lib/usf.py --self-test >/dev/null || fail "usf.py self-test"
pass "USF protocol self-test"

# orientation from gravity, iio-sensor-proxy's frame
PYTHONPATH=lib python3 - <<'PY' || fail "orientation thresholds"
import sys
sys.argv = ['x']
import importlib.util
spec = importlib.util.spec_from_file_location('sp', 'lib/sensor_proxy.py')
sp = importlib.util.module_from_spec(spec); spec.loader.exec_module(sp)
# Android accel (reaction to gravity) upright: (0, 9.8, 0) -> gravity (0, -9.8, 0)
assert sp.orientation('undefined', 0, -9.8, 0) == 'normal'
assert sp.orientation('undefined', 9.8, 0, 0) == 'left-up'
assert sp.orientation('undefined', -9.8, 0, 0) == 'right-up'
assert sp.orientation('undefined', 0, 9.8, 0) == 'bottom-up'
assert sp.tilt(0, 0, -9.8) == 'face-up'
PY
pass "orientation and tilt"

# D-Bus round trip on a private session bus: test backend -> autorotate (dry run)
if command -v dbus-run-session >/dev/null; then
  GIO_USE_VFS=local dbus-run-session -- bash -c '
    PYTHONPATH=lib python3 lib/sensor_proxy.py --backend test --session & p=$!
    sleep 1
    timeout 8 python3 lib/autorotate.py --session --dry-run 2> '"$tmp"'/rot.log || true
    kill $p' || true
  grep -q "transform 0" "$tmp/rot.log" || grep -q "transform = 0" "$tmp/rot.log" || fail "autorotate applies normal"
  grep -q "transform = 1" "$tmp/rot.log" || fail "autorotate applies left-up"
  pass "proxy and autorotate over D-Bus"
fi

./install "$tmp/root"
for f in usr/bin/omandroid-sensor-proxy usr/bin/omandroid-autorotate usr/bin/omandroid-usf \
         usr/lib/omandroid-sensors/usf.py usr/lib/omandroid-sensors/usf_backend.py \
         usr/lib/omandroid-sensors/sensor_proxy.py usr/lib/omandroid-sensors/autorotate.py \
         usr/lib/systemd/system/omandroid-sensor-proxy.service usr/lib/systemd/user/omandroid-autorotate.service \
         usr/share/dbus-1/system.d/net.hadess.SensorProxy.conf; do
  [[ -e $tmp/root/$f ]] || fail "install stages $f"
done
[[ -z $(find "$tmp/root" -path '*wants*') ]] || fail "nothing is enabled"
pass "install stages the package, enables nothing"
