# SPDX-License-Identifier: MIT
post_install() {
  echo "omamobile-waydroid: Waydroid is off. Needs a kernel with WAYDROID-PLAN.md W1's options."
  echo "  omamobile-waydroid check, then: sudo omamobile-waydroid init (downloads about 1 GB),"
  echo "  sudo omamobile-waydroid firewall on, sudo systemctl start waydroid-container"
}
post_upgrade() {
  systemctl daemon-reload 2>/dev/null || true
}
pre_remove() {
  systemctl disable --now waydroid-container.service 2>/dev/null || true
}
