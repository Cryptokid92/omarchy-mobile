#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omandroid-fingerprint into DESTDIR. Enables nothing. Google's Android
# files are not part of the package: tools/extract-fingerprint-vendor makes
# them from the user's own factory image (/usr/lib/omandroid-fp/root,
# MANIFEST, SOURCE). The bionic programs are built on the computer first:
#   make -C fingerprint CLANG=... BIONIC=... CHROOT=out/fingerprint-vendor/root \
#     OUT=$PWD/packages/omandroid-fingerprint/prebuilt
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
l=$d/usr/lib/omandroid-fp
install -Dm755 lib/omandroid-fp-chroot "$l/omandroid-fp-chroot"
install -Dm755 lib/omandroid-tipc-probe "$l/omandroid-tipc-probe"
install -Dm755 lib/omandroid-fp-ctl "$l/omandroid-fp-ctl"
install -Dm644 lib/props.conf "$l/props.conf"
install -Dm644 prebuilt/omandroid-fp-shim.so "$l/omandroid-fp-shim.so"
install -Dm755 prebuilt/omandroid-fp-bridge "$l/omandroid-fp-bridge"
install -Dm644 vendor/systemd/system/omandroid-fp.service "$d/usr/lib/systemd/system/omandroid-fp.service"
install -Dm644 vendor/systemd/system/fprintd.service.d/omandroid-udfps.conf \
  "$d/usr/lib/systemd/system/fprintd.service.d/omandroid-udfps.conf"
install -Dm644 vendor/modprobe.d/omandroid-fingerprint-lhbm.conf "$d/usr/lib/modprobe.d/omandroid-fingerprint-lhbm.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omandroid-fingerprint/LICENSE"
install -Dm644 version "$d/usr/share/omandroid/fingerprint/version"
