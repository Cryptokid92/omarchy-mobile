# SPDX-License-Identifier: MIT
# Google's fingerprint HAL, Trusty's storage proxy, KeyMint and Gatekeeper in
# a minimal chroot, plus omandroid-fp-bridge, which fprintd's omandroid_udfps
# driver talks to (device/cheetah/FINGERPRINT-PLAN.md). Not enabled by the
# package: the first run writes Trusty's secure storage (the RPMB), which
# the plan gates on the user's say-so (F4).
[Unit]
Description=Omandroid fingerprint (vendor HAL and bridge)
Documentation=file:///usr/share/doc/omandroid/FINGERPRINT-PLAN.md
# Trusty comes up with the AoC (omandroid-aoc-start loads trusty_*)
After=omandroid-aoc.service systemd-modules-load.service
ConditionPathExists=/usr/lib/omandroid-fp/root
ConditionPathExists=/dev/trusty-ipc-dev0
# a HAL that keeps dying must not loop forever against the TA
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# The sensor's rail is on pmic-2 (S2MPG13, bound through sec_acpm) and its
# driver is goodix_fp; both are blacklisted from autoload, so load them
# here. Loading before the regulator core's cleanup of unused rails (about
# 30 s after boot) is harmless: the sensor rail stays off until the driver
# switches it on (FINGERPRINT-PLAN F6).
ExecStartPre=/usr/bin/modprobe sec_acpm
ExecStartPre=/usr/bin/modprobe goodix_fp
ExecStart=/usr/lib/omandroid-fp/omandroid-fp-chroot start bridge
KillMode=control-group
Restart=on-failure
RestartSec=10
# The desktop's fingerprint target follows this file; a stack killed
# outright cannot remove it itself.
ExecStopPost=-/usr/bin/rm -f /run/omandroid-fp-ui/state.json

[Install]
WantedBy=multi-user.target
