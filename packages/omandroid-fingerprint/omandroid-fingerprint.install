# SPDX-License-Identifier: MIT
post_install() {
  echo "omandroid-fingerprint: nothing enabled. Needs the vendor files in /usr/lib/omandroid-fp/root"
  echo "  (tools/extract-fingerprint-vendor on your computer), the fingerprint DT overlays,"
  echo "  and the staged bring-up in device/cheetah/FINGERPRINT-PLAN.md before"
  echo "  systemctl enable --now omandroid-fp (its first run writes Trusty's secure storage)."
}
post_upgrade() {
  systemctl daemon-reload 2>/dev/null || true
}
pre_remove() {
  systemctl disable --now omandroid-fp.service 2>/dev/null || true
}
