pkgname=omandroid-keyring
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="The key that signs Omandroid's packages, for pacman"
arch=(any)
url="https://github.com/derekross/omandroid"
license=(MIT)
install=omandroid-keyring.install

package() {
  install -Dm644 "$startdir/omandroid.gpg" "$pkgdir/usr/share/pacman/keyrings/omandroid.gpg"
  install -Dm644 "$startdir/omandroid-trusted" "$pkgdir/usr/share/pacman/keyrings/omandroid-trusted"
  install -Dm644 "$startdir/omandroid-revoked" "$pkgdir/usr/share/pacman/keyrings/omandroid-revoked"
  install -Dm644 "$startdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
