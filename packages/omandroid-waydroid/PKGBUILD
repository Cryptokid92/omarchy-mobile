pkgname=omandroid-waydroid
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omandroid Waydroid integration: kernel checks, container hardening, Mali-G710 Mesa overlay, ufw rules"
arch=(any)
url="https://github.com/derekross/omandroid"
license=(MIT)
depends=(bash python waydroid lxc nftables dnsmasq e2fsprogs systemd)
optdepends=('ufw: omandroid-waydroid firewall on')
backup=(etc/omandroid/waydroid.conf)
install=omandroid-waydroid.install

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
