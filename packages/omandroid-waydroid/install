#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omandroid-waydroid into DESTDIR. Activates nothing: the container
# service stays disabled and no Android image is downloaded until
# "omandroid-waydroid init".
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
l=$d/usr/lib/omandroid-waydroid
install -Dm755 bin/omandroid-waydroid "$d/usr/bin/omandroid-waydroid"
for f in omandroid-waydroid-check omandroid-waydroid-harden omandroid-waydroid-mesa; do
  install -Dm755 "lib/$f" "$l/$f"
done
install -Dm644 lib/lxc-omandroid.conf "$d/usr/share/omandroid-waydroid/lxc-omandroid.conf"
install -Dm644 systemd/waydroid-container-omandroid.conf \
  "$d/usr/lib/systemd/system/waydroid-container.service.d/omandroid.conf"
install -Dm644 libalpm/90-omandroid-waydroid.hook "$d/usr/share/libalpm/hooks/90-omandroid-waydroid.hook"
install -Dm644 etc/omandroid/waydroid.conf "$d/etc/omandroid/waydroid.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omandroid-waydroid/LICENSE"
install -Dm644 version "$d/usr/share/omandroid/waydroid/version"
