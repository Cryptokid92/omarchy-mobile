#!/bin/bash
# SPDX-License-Identifier: MIT
# The simplefb trigger in initramfs/init writes only when the image's
# COMPATIBLE is the board's first compatible string. A cheetah image on a
# Fold must not write.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
init=initramfs/init
[[ -f $init ]] || fail "no $init"
grep -q -- '-fno-stack-protector' bin/omamobile || fail "freestanding devmem is linked with -fno-stack-protector"
grep -q 'tools/reboot-to.c' bin/omamobile || fail "reboot-to is built from tools/reboot-to.c"
grep -q 'command -v reboot-to' bin/omamobile || fail "push checks for reboot-to before writing"
pass "packer guards the trigger and builds reboot-to for every device"

t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
sed -n '/^simplefb_trigger() {$/,/^}$/p' "$init" > "$t/fn.sh"
[[ -s $t/fn.sh ]] || fail "simplefb_trigger found in $init"
sed -e "s|/etc/omamobile-|$t/etc/omamobile-|g" \
    -e "s|/proc/device-tree/compatible|$t/compatible|" \
    "$t/fn.sh" > "$t/fn-test.sh"
mkdir -p "$t/etc" "$t/bin"
printf '#!/bin/sh\necho "$*" >> "%s/devmem.log"\n' "$t" > "$t/bin/devmem"
chmod +x "$t/bin/devmem"
# NUL-separated, as the kernel exposes it.
printf 'google,gs201-felix\0google,gs201\0' > "$t/compatible"

run() {
  rm -f "$t/devmem.log" "$t/said"
  PATH="$t/bin:$PATH" sh -c ". '$t/fn-test.sh'; say() { echo \"\$*\" >> '$t/said'; }; simplefb_trigger"
}

printf '0x1c241030 0x3061\n' > "$t/etc/omamobile-simplefb-trig"
printf 'google,gs201-felix\n' > "$t/etc/omamobile-compatible"
run
[[ "$(cat "$t/devmem.log")" == "0x1c241030 0x3061" ]] || fail "a matching board writes its own pair"
pass "matching board writes its own trigger"

printf 'google,gs201-cheetah\n' > "$t/etc/omamobile-compatible"
run
[[ ! -e $t/devmem.log ]] || fail "a cheetah image on felix wrote a register"
grep -q 'board is google,gs201-felix, image is google,gs201-cheetah' "$t/said" || fail "mismatch is reported"
pass "another board's image writes nothing"

rm -f "$t/etc/omamobile-compatible"
run
[[ ! -e $t/devmem.log ]] || fail "a trigger without COMPATIBLE wrote a register"
pass "a trigger file without COMPATIBLE writes nothing"

rm -f "$t/etc/omamobile-simplefb-trig"
printf 'google,gs201-felix\n' > "$t/etc/omamobile-compatible"
run
[[ ! -e $t/devmem.log ]] || fail "no trigger file still wrote a register"
pass "no trigger file writes nothing"
