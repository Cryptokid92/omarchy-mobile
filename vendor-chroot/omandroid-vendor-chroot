#!/bin/bash
# SPDX-License-Identifier: MIT
# omandroid-vendor-chroot: run stock Android vendor daemons for the Pixel 7
# Pro in a minimal chroot, one profile at a time.
#
#   omandroid-vendor-chroot PROFILE check         preconditions only
#   omandroid-vendor-chroot PROFILE start         set up and supervise the
#                                                 profile's daemons in the
#                                                 foreground (systemd runs it)
#   omandroid-vendor-chroot PROFILE ns CMD...     a host command in the running
#                                                 profile's namespaces
#   omandroid-vendor-chroot PROFILE run CMD...    an Android binary in its chroot
#
# Grown from fingerprint/omandroid-fp-chroot (the fingerprint profile still
# runs there): the same chroot, property store, preload shim and supervision,
# with what differs between daemons moved into profiles
# (/usr/lib/omandroid-vendor/profiles/PROFILE.conf, a bash fragment):
#
#   IMAGE       the profile's read-only Android tree (tools/extract-vendor-chroot)
#   STATE       the only persistent, writable directory (bound as /data)
#   BINDER      yes: a private binderfs and servicemanager in the chroot
#   NO_SERVICES extra service-name prefixes the shim reports as absent
#   profile_check, profile_setup, profile_start   bash functions, see gnss.conf
#
# The chroot is a private mount and PID namespace on a tmpfs. The image is
# bound read-only; real block devices never enter it; Android processes die
# with the namespace. Profiles share the host's network namespace only when
# they need it (gnss downloads assistance data).
set -euo pipefail

LIB=${OMANDROID_VENDOR_LIB:-/usr/lib/omandroid-vendor}
SHIM=${OMANDROID_VENDOR_SHIM:-$LIB/omandroid-fp-shim.so}
STUBS=${OMANDROID_VENDOR_STUBS:-$LIB/stubs}

say() { printf 'omandroid-vendor[%s]: %s\n' "${PROFILE:-?}" "$*" >&2; }
die() { say "error: $*"; exit 1; }

# Host tools, resolved now: the Android processes get an Android PATH, and
# env(1) would look chroot up in that.
CHROOT_BIN=$(PATH=/usr/bin:/bin:/usr/sbin:/sbin command -v chroot || true)

# Stop everything once: ignore further TERM/INT first, so the group-wide
# kill below cannot re-enter this handler, then signal the process group
# and exit. As the namespace's PID 1, exiting also ends every process left.
STOPPING=
stop() {
  local code=${1:-0}
  [[ -n $STOPPING ]] && exit "$code"
  STOPPING=1
  trap '' TERM INT
  say "stopping"
  kill -TERM 0 2>/dev/null || true
  exit "$code"
}

PROFILE=${1:-}
[[ $PROFILE =~ ^[a-z0-9-]+$ ]] || {
  echo "usage: omandroid-vendor-chroot PROFILE check | start | ns CMD... | run CMD..." >&2
  exit 2
}
shift
PROFILE_CONF=${OMANDROID_VENDOR_PROFILES:-$LIB/profiles}/$PROFILE.conf
[[ -f $PROFILE_CONF ]] || die "no profile $PROFILE_CONF"

# Defaults a profile may override.
IMAGE=$LIB/$PROFILE/root
STATE=/var/lib/omandroid-vendor/$PROFILE
PROPS_EXTRA=$LIB/$PROFILE/props.conf
BINDER=no
NO_SERVICES=""
BINS=()		# the Android binaries the profile runs (paths in the chroot)
RUN=/run/omandroid-vendor/$PROFILE
profile_check() { :; }
profile_setup() { :; }
profile_start() { :; }
# shellcheck source=/dev/null
source "$PROFILE_CONF"
ROOT=$RUN/root
NSPID=$RUN/ns.pid

LIBS_VENDOR=/vendor/lib64:/vendor/lib64/hw:/system/lib64:/omandroid/lib64
LIBS_SYSTEM=/system/lib64:/vendor/lib64:/omandroid/lib64

# Resolve a chroot path inside $IMAGE, following symlinks as the chroot would.
in_image() {
  local p=$IMAGE$1 t n=0
  while [[ -L $p ]] && ((n++ < 16)); do
    t=$(readlink "$p")
    [[ $t == /* ]] && p=$IMAGE$t || p=$(dirname "$p")/$t
  done
  [[ -e $p ]] && printf '%s\n' "$p"
}

# The ELF interpreter a binary names (PT_INTERP): Android's are
# /system/bin/linker64 or /system/bin/bootstrap/linker64, near the start.
elf_interp() {
  head -c 4096 "$1" | tr -c '[:print:]' '\n' |
    grep -m1 -E '^/system/bin/(bootstrap/)?linker(64)?$' || true
}

check_bins() {
  local b f i ok=0
  for b in "$@"; do
    f=$(in_image "$b")
    if [[ -z $f ]]; then say "missing $b in $IMAGE"; ok=1; continue; fi
    i=$(elf_interp "$f")
    if [[ -z $i ]]; then say "$b: no Android interpreter found"; ok=1; continue; fi
    [[ -n $(in_image "$i") ]] || { say "$b needs $i, missing from $IMAGE (re-run tools/extract-vendor-chroot)"; ok=1; }
  done
  return $ok
}

check() {
  local ok=1
  [[ $EUID -eq 0 ]] || die "run as root"
  [[ -x $CHROOT_BIN ]] || { say "no chroot(1) on the host (coreutils)"; ok=0; }
  [[ -d $IMAGE/vendor && -d $IMAGE/apex/com.android.runtime ]] ||
    { say "no image in $IMAGE (tools/extract-vendor-chroot -p $PROFILE)"; ok=0; }
  [[ -f $SHIM ]] || { say "no shim at $SHIM (vendor-chroot/Makefile)"; ok=0; }
  if [[ $BINDER == yes ]]; then
    grep -qw binder /proc/filesystems || { say "kernel has no binderfs"; ok=0; }
  fi
  if [[ -f $IMAGE/../STUBS ]]; then
    local s
    while read -r s; do
      [[ -z $s || -f $STUBS/$s ]] || { say "no stub $STUBS/$s (vendor-chroot/Makefile)"; ok=0; }
    done < "$IMAGE/../STUBS"
  fi
  local bins=("${BINS[@]}")
  [[ $BINDER == yes ]] && bins+=(/system/bin/servicemanager)
  ((${#bins[@]})) && { check_bins "${bins[@]}" || ok=0; }
  profile_check || ok=0
  ((ok)) || exit 1
  say "preconditions met"
}

# Bind $1 onto $2 (created as a file or directory to match), optionally ro.
bind() {
  local src=$1 dst=$2 mode=${3:-rw}
  if [[ -d $src ]]; then mkdir -p "$dst"; else mkdir -p "$(dirname "$dst")"; : > "$dst"; fi
  mount --bind "$src" "$dst"
  [[ $mode == ro ]] && mount -o remount,bind,ro "$dst"
  return 0
}

# Property store: one file per property (see the shim).
write_props() {
  local dir=$1 f line k v
  mkdir -p "$dir"
  for f in "$ROOT/system/build.prop" "$ROOT/vendor/build.prop" "$PROPS_EXTRA" "$STATE/props.conf"; do
    [[ -f $f ]] || continue
    while IFS= read -r line; do
      [[ $line =~ ^[[:space:]]*# || $line != *=* ]] && continue
      k=${line%%=*} v=${line#*=}
      [[ $k =~ ^[A-Za-z0-9_.:@-]+$ ]] || continue
      printf '%s' "$v" > "$dir/$k"
    done < "$f"
  done
}

setup_dev() {
  local dev=$ROOT/dev n
  mount -t tmpfs -o mode=0755,nosuid dev "$dev"
  for n in null zero full random urandom; do bind "/dev/$n" "$dev/$n"; done
  mkdir -p "$dev/socket"
  if [[ $BINDER == yes ]]; then
    mkdir -p "$dev/binderfs"
    mount -t binder binder "$dev/binderfs"
    for n in binder hwbinder vndbinder; do
      [[ -e $dev/binderfs/$n ]] || die "binderfs has no $n (CONFIG_ANDROID_BINDER_DEVICES)"
      ln -s "binderfs/$n" "$dev/$n"
    done
  fi
  # the target lives in the tmpfs just mounted on dev: create it first
  mkdir -p "$dev/__omandroid_props__"
  mount -t tmpfs -o mode=0755,nosuid,nodev,noexec props "$dev/__omandroid_props__"
  write_props "$dev/__omandroid_props__"
}

# Build the chroot in the current (private) mount namespace.
setup() {
  local s
  mkdir -p "$ROOT"
  mount -t tmpfs -o mode=0755,nosuid "omandroid-$PROFILE" "$ROOT"
  for d in system vendor apex; do bind "$IMAGE/$d" "$ROOT/$d" ro; done
  mkdir -p "$ROOT/proc" "$ROOT/sys" "$ROOT/dev" "$ROOT/data" "$ROOT/tmp" \
    "$ROOT/linkerconfig" "$ROOT/omandroid/lib64"
  ln -s /system/bin "$ROOT/bin"
  ln -s /system/etc "$ROOT/etc"
  mount -t tmpfs -o mode=1777,nosuid,nodev tmp "$ROOT/tmp"
  mount -t proc -o nosuid,nodev,noexec proc "$ROOT/proc"
  mount -t tmpfs -o mode=0755,nosuid,nodev,noexec sysfs-skel "$ROOT/sys"
  bind "$SHIM" "$ROOT/omandroid/omandroid-fp-shim.so" ro
  if [[ -f $IMAGE/../STUBS ]]; then
    while read -r s; do
      [[ -n $s ]] && bind "$STUBS/$s" "$ROOT/omandroid/lib64/$s" ro
    done < "$IMAGE/../STUBS"
  fi
  mkdir -p "$STATE/data"
  chmod 0700 "$STATE"
  bind "$STATE/data" "$ROOT/data"
  setup_dev
  profile_setup
  mount -o remount,ro "$ROOT/sys"
}

# Environment for every Android process in the chroot.
android_env() { # $1 vendor|system
  local libs=$LIBS_VENDOR
  [[ $1 == system ]] && libs=$LIBS_SYSTEM
  ENV=(env -i PATH=/system/bin:/vendor/bin
    LD_LIBRARY_PATH="$libs" LD_PRELOAD=/omandroid/omandroid-fp-shim.so
    OMANDROID_FP_PROPS=/dev/__omandroid_props__
    OMANDROID_FP_LOGLEVEL="${OMANDROID_VENDOR_LOGLEVEL:-3}"
    OMANDROID_FP_NO_SERVICES="$NO_SERVICES"
    ANDROID_ROOT=/system ANDROID_DATA=/data ANDROID_DNS_MODE=local)
}

declare -A PIDS=()

# Run an Android binary in the chroot as a supervised child.
# $1 name, $2 vendor|system (library search order), $3... command
spawn() {
  local name=$1 kind=$2; shift 2
  android_env "$kind"
  say "starting $name"
  "${ENV[@]}" "$CHROOT_BIN" "$ROOT" "$@" 2>&1 | sed -u "s/^/[$name] /" &
  PIDS[$name]=$!
}

start() {
  check
  mkdir -p "$RUN"
  if [[ -z ${OMANDROID_VENDOR_IN_NS:-} ]]; then
    rm -f "$NSPID"
    exec unshare --mount --propagation private --pid --fork --kill-child \
      env OMANDROID_VENDOR_IN_NS=1 "$0" "$PROFILE" start
  fi
  awk '/^NSpid:/ {print $2}' /proc/self/status > "$NSPID"
  trap 'stop 0' TERM INT
  setup
  if [[ $BINDER == yes ]]; then
    spawn servicemanager system /system/bin/servicemanager
    sleep 1
  fi
  profile_start
  say "running"
  # Supervise: any child exiting stops the whole profile (systemd decides
  # whether to restart it).
  wait -n || true
  # wait also returns when TERM/INT arrives; then the trap is already stopping
  [[ -n $STOPPING ]] || say "a service exited"
  stop 1
}

ns_pid() {
  [[ -f $NSPID ]] || die "not running"
  cat "$NSPID"
}

ns() {
  (($#)) || die "usage: omandroid-vendor-chroot $PROFILE ns CMD..."
  exec nsenter --target "$(ns_pid)" --mount --pid "$@"
}

run() {
  (($#)) || die "usage: omandroid-vendor-chroot $PROFILE run /vendor/bin/... ARGS"
  android_env vendor
  exec nsenter --target "$(ns_pid)" --mount --pid "${ENV[@]}" "$CHROOT_BIN" "$ROOT" "$@"
}

case ${1:-} in
  check) check ;;
  start) start ;;
  ns) shift; ns "$@" ;;
  run) shift; run "$@" ;;
  *) echo "usage: omandroid-vendor-chroot PROFILE check | start | ns CMD... | run CMD..." >&2
     exit 2 ;;
esac
