# SPDX-License-Identifier: MIT
# Serves the GNSS engine's NMEA to GeoClue (Unix socket) and gpsd (pty).
[Unit]
Description=Omandroid GNSS NMEA bridge
PartOf=omandroid-gnss.service
After=omandroid-gnss.service

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 1 100); do [ -p /var/lib/omandroid-vendor/gnss/data/vendor/gps/nmea_out ] && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/lib/omandroid-vendor/omandroid-gnss-nmea
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ReadWritePaths=-/var/lib/omandroid-vendor/gnss/data/vendor/gps
RuntimeDirectory=omandroid-gnss
